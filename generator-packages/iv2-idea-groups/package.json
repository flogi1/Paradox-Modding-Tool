{
  "id": "iv2-idea-groups",
  "name": { "de": "IV2 Ideengruppen", "en": "IV2 Idea Groups", "fr": "Groupes d'idées IV2", "es": "Grupos de ideas IV2", "ru": "Группы идей IV2", "pl": "Grupy idei IV2", "pt-br": "Grupos de ideias IV2", "zh-hans": "IV2 理念组" },
  "gameId": "eu5",
  "keyFields": [ "category", "group" ],
  "head": [
    { "id": "category", "label": { "de": "Kategorie", "en": "Category" }, "type": "choice", "choices": [ "adm", "dip", "army", "navy" ], "required": true },
    { "id": "group", "label": { "de": "Nummer", "en": "Number" }, "type": "number", "required": true, "pattern": "^[1-9][0-9]*$" },
    { "id": "title", "label": { "de": "Titel", "en": "Title" }, "type": "text", "required": true, "multilingual": true },
    { "id": "allow", "label": { "de": "Bedingungen (allow)", "en": "Conditions (allow)" }, "type": "multilineText" },
    { "id": "column", "label": { "de": "Spalte im Auswahlfenster", "en": "Column in the selection window" }, "type": "choice", "choices": [ "Left", "Middle", "Right" ], "default": "Right" },
    { "id": "aiList", "label": { "de": "In den allgemeinen KI-Listen", "en": "In the general AI lists" }, "type": "bool", "default": "yes" },
    { "id": "groupType", "label": { "de": "Gruppenart (Variable beim Wählen)", "en": "Group type (variable when picked)" }, "type": "choice", "choices": [ "none", "reli", "gov", "rank" ], "default": "none" },
    { "id": "religions", "label": { "de": "Bedingungswerte (je Zeile eine Bedingung)", "en": "Condition values (one condition per line)" }, "type": "multilineText" },
    { "id": "religionList", "label": { "de": "Nummer der KI-Liste", "en": "AI list number" }, "type": "number" },
    { "id": "exclusive", "label": { "de": "Schließt aus (Gruppennummern derselben Kategorie)", "en": "Excludes (group numbers of the same category)" }, "type": "text" },
    { "id": "exclusiveTitle", "label": { "de": "Exklusiv-Titel", "en": "Exclusive title" }, "type": "text", "multilingual": true },
    { "id": "exclusiveDesc", "label": { "de": "Exklusiv-Beschreibung", "en": "Exclusive description" }, "type": "multilineText", "multilingual": true }
  ],
  "root": {
    "id": "ideas", "label": { "de": "Ideen", "en": "Ideas" }, "min": 7, "max": 7, "initial": 7,
    "fields": [
      { "id": "name", "label": { "de": "Name", "en": "Name" }, "type": "text", "required": true, "multilingual": true },
      { "id": "desc", "label": { "de": "Beschreibung", "en": "Description" }, "type": "multilineText", "multilingual": true },
      { "id": "modifiers", "label": { "de": "Modifikatoren", "en": "Modifiers" }, "type": "modifiers" },
      { "id": "recalc", "label": { "de": "Neuberechnung auslösen (IV2_calc.2)", "en": "Trigger recalculation (IV2_calc.2)" }, "type": "bool", "default": "no" }
    ]
  },
  "languages": { "copyEnglish": true },
  "targets": [ "mod", "output" ],
  "outputs": [
    { "id": "ga", "kind": "syncMatching", "path": "in_game/common/generic_actions/iv2_ga_idea_groups_{{ category }}.txt", "template": "ga.sbn", "match": "{{ hm }}" },
    { "id": "ai_ideas", "kind": "syncMatching", "path": "in_game/common/generic_action_ai_lists/iv2_generic_action_list_{{ category }}_ideas.txt", "block": "iv2_ga_list_ig_{{ category }}.actions", "template": "ai_ideas.sbn", "match": "iv2_ga_ideagroup_{{ gm }}" },
    { "id": "ai_pick", "kind": "syncMatching", "path": "in_game/common/generic_action_ai_lists/iv2_generic_action_list_pick_ig.txt", "block": "iv2_ga_list_pick_{{ category }}.actions", "template": "ai_pick.sbn", "match": "iv2_ga_select_ideagroup_{{ gm }}" },
    { "id": "ai_no_ai", "kind": "syncMatching", "path": "in_game/common/generic_action_ai_lists/iv2_generic_action_list_no_ai.txt", "block": "iv2_ga_list_no_ai.actions", "template": "ai_no_ai.sbn", "match": "iv2_ga_deselect_ideagroup_{{ gm }}" },
    { "id": "stat_add", "kind": "syncMatching", "path": "in_game/common/scripted_effects/01_iv2_scripted_effect_idea_statistics.txt", "block": "iv2_add_statistics_list_{{ category }}_effect", "template": "stat_add.sbn", "match": "{{ gm }}" },
    { "id": "stat_remove", "kind": "syncMatching", "path": "in_game/common/scripted_effects/01_iv2_scripted_effect_idea_statistics.txt", "block": "iv2_remove_statistics_list_{{ category }}_effect", "template": "stat_remove.sbn", "match": "{{ gm }}" },
    { "id": "purger_var", "kind": "syncMatching", "path": "in_game/common/scripted_effects/01_iv2_scripted_effect_log_purger.txt", "block": "iv2_log_purger", "template": "purger_var.sbn", "match": "v = iv2_var_{{ gm }}" },
    { "id": "purger_stat", "kind": "syncMatching", "path": "in_game/common/scripted_effects/01_iv2_scripted_effect_log_purger.txt", "block": "iv2_log_purger", "template": "purger_stat.sbn", "match": "v = iv2_var_stat_{{ gm }}" },
    { "id": "revolt_select", "kind": "syncMatching", "path": "in_game/common/scripted_effects/02_iv2_scripted_effect_ig_country_formation_revolt.txt", "block": "iv2_scripted_effect_ig_revolt_country", "template": "revolt_select.sbn", "match": "root = \\{ has_variable = iv2_ideagroup_select_{{ g }}_1 \\}" },
    { "id": "revolt_special", "kind": "syncMatching", "path": "in_game/common/scripted_effects/02_iv2_scripted_effect_ig_country_formation_revolt.txt", "block": "iv2_scripted_effect_ig_revolt_country", "template": "revolt_special.sbn", "match": "iv2_scripted_trigger_has_\\w+_ig_selected = yes \\}[\\s\\S]*type = iv2_ga_select_ideagroup_{{ gm }}" },
    { "id": "revolt_ideas", "kind": "syncMatching", "path": "in_game/common/scripted_effects/02_iv2_scripted_effect_ig_country_formation_revolt.txt", "block": "iv2_scripted_effect_ig_revolt_country", "template": "revolt_ideas.sbn", "match": "root = \\{ has_country_modifier = ideagroup_modifier_{{ gm }}" },
    { "id": "revolt_reli_cases", "kind": "syncMatching", "forEach": "ideas", "path": "in_game/common/scripted_effects/02_iv2_scripted_effect_ig_country_formation_revolt.txt",
      "block": "iv2_scripted_effect_ig_revolt_country.{{ item.index == 7 ? \"else\" : \"if[var:iv2_reli_ideagroup = \" + item.index + \"]\" }}.switch[trigger = religion][!religion.group]",
      "template": "reli_cases.sbn", "match": "\\Areligion:[\\s\\S]*modifier = ideagroup_modifier_{{ g }}_1 years" },
    { "id": "revolt_group_cases", "kind": "syncMatching", "forEach": "ideas", "path": "in_game/common/scripted_effects/02_iv2_scripted_effect_ig_country_formation_revolt.txt",
      "block": "iv2_scripted_effect_ig_revolt_country.if[var:iv2_reli_ideagroup = {{ item.index }}].switch[trigger = religion.group]",
      "template": "group_cases.sbn", "match": "\\Areligion_group:[\\s\\S]*modifier = ideagroup_modifier_{{ g }}_1 years" },
    { "id": "reli_ai_list", "kind": "syncMatching", "path": "in_game/common/generic_action_ai_lists/iv2_generic_action_list_religion.txt", "template": "reli_ai_list.sbn", "match": "\\Aiv2_ga_list_reli_[0-9]+[\\s\\S]*iv2_ga_select_ideagroup_{{ gm }}" },
    { "id": "reli_trigger", "kind": "syncMatching", "path": "in_game/common/scripted_triggers/iv2_scripted_triggers_religion_change.txt", "block": "iv2_scripted_trigger_has_religion_ig_selected.OR", "template": "reli_trigger.sbn", "match": "iv2_ideagroup_select_{{ g }}_1(?![0-9])" },
    { "id": "reli_remove", "kind": "syncMatching", "path": "in_game/common/scripted_effects/02_iv2_scripted_effect_ig_religion_change.txt", "block": "iv2_scripted_effect_remove_reli_idea_groups_all.switch", "template": "reli_remove.sbn", "match": "\\Aiv2_ideagroup_select_{{ g }}_1(?![0-9])" },
    { "id": "reli_add", "kind": "syncMatching", "path": "in_game/common/scripted_effects/02_iv2_scripted_effect_ig_religion_change.txt", "block": "iv2_scripted_effect_add_reli_idea_groups_all", "template": "reli_add.sbn", "match": "type = iv2_ga_select_ideagroup_{{ gm }}" },
    { "id": "change_reli_cases", "kind": "syncMatching", "forEach": "ideas", "path": "in_game/common/scripted_effects/02_iv2_scripted_effect_ig_religion_change.txt",
      "block": "iv2_scripted_effect_ig_change.{{ item.index == 7 ? \"else\" : \"if[var:iv2_reli_ideagroup = \" + item.index + \"]\" }}.switch[trigger = religion][!religion.group]",
      "template": "reli_cases.sbn", "match": "\\Areligion:[\\s\\S]*modifier = ideagroup_modifier_{{ g }}_1 years" },
    { "id": "change_group_cases", "kind": "syncMatching", "forEach": "ideas", "path": "in_game/common/scripted_effects/02_iv2_scripted_effect_ig_religion_change.txt",
      "block": "iv2_scripted_effect_ig_change.if[var:iv2_reli_ideagroup = {{ item.index }}].switch[trigger = religion.group]",
      "template": "group_cases.sbn", "match": "\\Areligion_group:[\\s\\S]*modifier = ideagroup_modifier_{{ g }}_1 years" },
    { "id": "govrank_ai_list", "kind": "syncMatching", "path": "in_game/common/generic_action_ai_lists/iv2_generic_action_list_{{ govrank_list_file }}.txt", "template": "govrank_ai_list.sbn", "match": "\\A{{ govrank_list_prefix }}[0-9]+[\\s\\S]*iv2_ga_select_ideagroup_{{ gm }}" },
    { "id": "govrank_trigger", "kind": "syncMatching", "path": "in_game/common/scripted_triggers/iv2_scripted_triggers_{{ govrank_file_word }}_change.txt", "block": "iv2_scripted_trigger_has_{{ govrank_file_word }}_ig_selected.OR", "template": "govrank_trigger.sbn", "match": "iv2_ideagroup_select_{{ g }}_1(?![0-9])" },
    { "id": "govrank_remove", "kind": "syncMatching", "path": "in_game/common/scripted_effects/02_iv2_scripted_effect_ig_{{ govrank_file_word }}_change.txt", "block": "iv2_scripted_effect_remove_{{ govrank_effect_word }}_idea_groups_all.switch", "template": "govrank_remove.sbn", "match": "\\Aiv2_ideagroup_select_{{ g }}_1(?![0-9])" },
    { "id": "govrank_add", "kind": "syncMatching", "path": "in_game/common/scripted_effects/02_iv2_scripted_effect_ig_{{ govrank_file_word }}_change.txt", "block": "iv2_scripted_effect_add_{{ govrank_effect_word }}_idea_groups_all", "template": "govrank_add.sbn", "match": "type = iv2_ga_select_ideagroup_{{ gm }}" },
    { "id": "change_govrank_cases", "kind": "syncMatching", "forEach": "ideas", "path": "in_game/common/scripted_effects/02_iv2_scripted_effect_ig_{{ govrank_file_word }}_change.txt",
      "block": "iv2_scripted_effect_ig_change_{{ govrank_file_word }}.if[var:{{ govrank_variable }} = {{ item.index }}].switch",
      "template": "govrank_cases.sbn", "match": "\\A{{ govrank_trigger_key }}:[\\s\\S]*modifier = ideagroup_modifier_{{ g }}_1 years" },
    { "id": "revolt_govrank_cases", "kind": "syncMatching", "forEach": "ideas", "path": "in_game/common/scripted_effects/02_iv2_scripted_effect_ig_country_formation_revolt.txt",
      "block": "iv2_scripted_effect_ig_revolt_country.if[var:{{ govrank_variable }} = {{ item.index }}].switch",
      "template": "govrank_cases.sbn", "match": "\\A{{ govrank_trigger_key }}:[\\s\\S]*modifier = ideagroup_modifier_{{ g }}_1 years" },
    { "id": "revoke", "kind": "syncMatching", "path": "in_game/common/scripted_effects/02_iv2_scripted_effect_ig_revoke_{{ category }}.txt", "template": "revoke.sbn", "match": "{{ hm }}" },
    { "id": "sgui_groups", "kind": "syncMatching", "path": "in_game/common/scripted_guis/IV2_scripted_gui_idea_groups_{{ category }}.txt", "template": "sgui_groups.sbn", "match": "{{ hm }}" },
    { "id": "sgui_stats", "kind": "syncMatching", "path": "in_game/common/scripted_guis/IV2_scripted_gui_idea_statistics_{{ category }}.txt", "template": "sgui_stats.sbn", "match": "{{ hm }}" },
    { "id": "sgui_cv", "kind": "syncMatching", "path": "in_game/common/scripted_guis/IV2_sgui_country_view_ig.txt", "template": "sgui_cv.sbn", "match": "iv2_sgui_cv_ig_{{ gm }}" },
    { "id": "gui_cv", "kind": "syncMatching", "path": "in_game/gui/IV2 Country View/IV2_cv_ideagroups_{{ category }}.gui", "block": "types iv2_cv_ig_{{ category }}", "template": "gui_cv.sbn", "match": "{{ hm }}" },
    { "id": "gui_cv_shell", "kind": "syncMatching", "path": "in_game/gui/IV2 Country View/IV2_cv_shells.gui", "block": "types iv2_cv_shells.type iv2_cv_ideagroup_shell_{{ category }}", "template": "gui_cv_shell.sbn", "match": "iv2_cv_ig_{{ gm }}" },
    { "id": "gui_group_tt", "kind": "syncMatching", "path": "in_game/gui/IV2_idea_group_tooltip_templates_{{ category }}.gui", "template": "gui_group_tt.sbn", "match": "{{ hm }}" },
    { "id": "gui_remove_tt", "kind": "syncMatching", "path": "in_game/gui/IV2_remove_idea_group_tooltip_templates_{{ category }}.gui", "template": "gui_remove_tt.sbn", "match": "{{ hm }}" },
    { "id": "gui_select_groups", "kind": "syncMatching", "path": "in_game/gui/IV2_select_idea_groups_templates_{{ category }}.gui", "template": "gui_select_groups.sbn", "match": "{{ hm }}" },
    { "id": "gui_select_ideas", "kind": "syncMatching", "path": "in_game/gui/IV2_select_idea_templates_{{ category }}.gui", "template": "gui_select_ideas.sbn", "match": "{{ hm }}" },
    { "id": "gui_single_tt", "kind": "syncMatching", "path": "in_game/gui/IV2_single_idea_tooltip_templates_{{ category }}.gui", "template": "gui_single_tt.sbn", "match": "{{ hm }}" },
    { "id": "gui_whole_tt", "kind": "syncMatching", "path": "in_game/gui/IV2_whole_idea_group_tooltip_templates_{{ category }}.gui", "template": "gui_whole_tt.sbn", "match": "{{ hm }}" },
    { "id": "gui_ig_shell", "kind": "syncMatching", "path": "in_game/gui/Idea Variation 2 Idea Group Types/IV2_IG_shells.gui", "block": "types iv2_shells_all.type iv2_ideagroup_shell_{{ category }}", "template": "gui_ig_shell.sbn", "match": "iv2_ig_{{ gm }}" },
    { "id": "gui_ig_type", "kind": "syncMatching", "path": "in_game/gui/Idea Variation 2 Idea Group Types/IV2_IG_types_{{ category }}.gui", "block": "types iv2_ideagroups_{{ category }}_all", "template": "gui_ig_type.sbn", "match": "{{ hm }}" },
    { "id": "gui_stats_type", "kind": "syncMatching", "path": "in_game/gui/Idea Variation 2 Idea Statistics types/IV2_idea_statistics_{{ category }}.gui", "block": "types iv2_idea_stats_{{ category }}_all", "template": "gui_stats_type.sbn", "match": "{{ hm }}" },
    { "id": "gui_stats_setup", "kind": "syncMatching", "path": "in_game/gui/Idea Variation 2 Idea Statistics types/IV2_national_statistics_setup.gui", "block": "types iv2_statistics_setup.type iv2_statistics_{{ category }}", "template": "gui_stats_setup.sbn", "match": "iv2_ig_stats_{{ gm }}" },
    { "id": "gui_selection", "kind": "syncMatching", "path": "in_game/gui/Idea_Variation_ideas_selection_window_{{ category }}.gui", "block": "window.widget#{{ column_index }}.scrollbox.blockoverride scrollbox_content.vbox", "template": "gui_selection.sbn", "match": "{{ gm }}" },
    { "id": "gui_exclusive_tt", "kind": "syncMatching", "path": "in_game/gui/IV2_mutually_exclusive_ideagroup_tooltips.gui", "template": "gui_exclusive_tt.sbn", "match": "{{ hm }}" },
    { "id": "exclusive_partner", "kind": "check", "path": "in_game/common/scripted_guis/IV2_scripted_gui_idea_groups_{{ category }}.txt", "template": "check_exclusive.sbn",
      "message": {
        "de": "{{ arg }} schließt {{ g }} nicht aus. {{ arg }} einlesen, bei „Schließt aus“ {{ group }} ergänzen und neu erzeugen.",
        "en": "{{ arg }} does not exclude {{ g }}. Read {{ arg }}, add {{ group }} to “Excludes” and generate it again."
      } },
    { "id": "ai_chooser", "kind": "check", "path": "in_game/common/generic_actions/iv2_ga_ai_chooser.txt", "template": "check_ai_chooser.sbn",
      "message": {
        "de": "{{ arg }} fehlt im KI-Auswähler. Nach dem Erzeugen python \"Idea Variation 2 Skripte/KI-Auswaehler/iv2_build_ai_chooser.py\" ausführen (vorher im Tag-Editor taggen).",
        "en": "{{ arg }} is missing in the AI chooser. After generating, run python \"Idea Variation 2 Skripte/KI-Auswaehler/iv2_build_ai_chooser.py\" (tag it in the tag editor first)."
      } },
    { "id": "static_modifiers", "kind": "syncMatching", "path": "main_menu/common/static_modifiers/01_IV2_ideagroup_modifiers_{{ category }}.txt", "template": "static_modifiers.sbn", "match": "{{ hm }}" },
    { "id": "messagetypes_select", "kind": "syncMatching", "path": "main_menu/gui/messagetypes.txt", "template": "messagetypes_select.sbn", "match": "WE_PERFORM_iv2_ga_select_ideagroup_{{ gm }}_ACTION" },
    { "id": "messagetypes_deselect", "kind": "syncMatching", "path": "main_menu/gui/messagetypes.txt", "template": "messagetypes_deselect.sbn", "match": "WE_PERFORM_iv2_ga_deselect_ideagroup_{{ gm }}_ACTION" },
    { "id": "messagetypes_ideas", "kind": "syncMatching", "path": "main_menu/gui/messagetypes.txt", "template": "messagetypes_ideas.sbn", "match": "WE_PERFORM_iv2_ga_ideagroup_{{ gm }}_[0-9]+_ACTION" },
    { "id": "loc_ideas", "kind": "localization", "path": "main_menu/localization/{{ lang }}/02_IV2_{{ category }}_ideas_l_{{ lang }}.yml", "template": "loc_ideas.sbn", "keys": "_{{ g }}(_|$)" },
    { "id": "loc_exclusive", "kind": "localization", "path": "main_menu/localization/{{ lang }}/01_IV2_setup_l_{{ lang }}.yml", "template": "loc_exclusive.sbn", "keys": "^iv2_ideagroup_(title|desc)_text_mut_{{ g }}_1$" },
    { "id": "loc_msg_select", "kind": "localization", "path": "main_menu/localization/{{ lang }}/03_IV2_messages_l_{{ lang }}.yml", "template": "loc_msg_select.sbn", "keys": "^WE_PERFORM_iv2_ga_select_ideagroup_{{ g }}_ACTION_" },
    { "id": "loc_msg_deselect", "kind": "localization", "path": "main_menu/localization/{{ lang }}/03_IV2_messages_l_{{ lang }}.yml", "template": "loc_msg_deselect.sbn", "keys": "^WE_PERFORM_iv2_ga_deselect_ideagroup_{{ g }}_ACTION_" },
    { "id": "loc_msg_ideas", "kind": "localization", "path": "main_menu/localization/{{ lang }}/03_IV2_messages_l_{{ lang }}.yml", "template": "loc_msg_ideas.sbn", "keys": "^WE_PERFORM_iv2_ga_ideagroup_{{ g }}_[0-9]+_ACTION_" }
  ],
  "read": {
    "keys": {
      "file": "^main_menu/common/static_modifiers/01_IV2_ideagroup_modifiers_(adm|dip|army|navy)\\.txt$",
      "block": "ideagroup_modifier_(?<category>adm|dip|army|navy)_(?<group>\\d+)_1"
    },
    "elements": {
      "file": "main_menu/common/static_modifiers/01_IV2_ideagroup_modifiers_{{ category }}.txt",
      "block": "ideagroup_modifier_{{ category }}_{{ group }}_(?<number>\\d+)",
      "level": "ideas",
      "fields": { "modifiers": { "body": true, "except": [ "game_data" ] } }
    },
    "localizationOutput": "loc_ideas",
    "localization": [
      { "key": "iv2_ideagroup_title_{{ category }}_{{ group }}", "field": "title" },
      { "key": "iv2_ga_ideagroup_{{ category }}_{{ group }}_(?<number>\\d+)", "field": "ideas.name" },
      { "key": "iv2_ga_ideagroup_{{ category }}_{{ group }}_(?<number>\\d+)_desc", "field": "ideas.desc" },
      { "key": "iv2_ideagroup_title_text_mut_{{ category }}_{{ group }}_1", "field": "exclusiveTitle", "output": "loc_exclusive" },
      { "key": "iv2_ideagroup_desc_text_mut_{{ category }}_{{ group }}_1", "field": "exclusiveDesc", "output": "loc_exclusive" }
    ],
    "flags": [
      { "file": "in_game/common/generic_actions/iv2_ga_idea_groups_{{ category }}.txt", "block": "iv2_ga_ideagroup_{{ category }}_{{ group }}_(?<number>\\d+)", "contains": "IV2_calc.2", "field": "ideas.recalc" },
      { "file": "in_game/common/generic_action_ai_lists/iv2_generic_action_list_pick_ig.txt", "block": "iv2_ga_list_pick_{{ category }}", "pattern": "iv2_ga_select_ideagroup_{{ category }}_{{ group }}(?![0-9])", "field": "aiList" }
    ],
    "values": [
      { "file": "in_game/common/generic_actions/iv2_ga_idea_groups_{{ category }}.txt", "block": "iv2_ga_select_ideagroup_{{ category }}_{{ group }}", "body": "allow", "field": "allow" },
      { "file": "in_game/common/generic_actions/iv2_ga_idea_groups_{{ category }}.txt", "block": "iv2_ga_ideagroup_{{ category }}_{{ group }}_1", "pattern": "name = iv2_(?<value>reli|gov|rank)_ideagroup", "field": "groupType" },
      { "file": "in_game/gui/Idea_Variation_ideas_selection_window_{{ category }}.gui", "block": "window",
        "pattern": "Area (?<value>Left|Middle|Right) Start(?:(?!Area (?:Left|Middle|Right) Start)[\\s\\S])*?iv2_ideagroup_select_{{ category }}_{{ group }}_1(?![0-9])", "field": "column" },
      { "file": "in_game/common/generic_action_ai_lists/iv2_generic_action_list_religion.txt", "block": "iv2_ga_list_reli_\\d+",
        "pattern": "(?<value>religion(?:\\.group)? = religion(?:_group)?:\\w+)(?=[\\s\\S]*iv2_ga_select_ideagroup_{{ category }}_{{ group }}(?![0-9]))", "field": "religions" },
      { "file": "in_game/common/generic_action_ai_lists/iv2_generic_action_list_religion.txt", "block": "iv2_ga_list_reli_\\d+",
        "pattern": "^iv2_ga_list_reli_(?<value>\\d+)(?=[\\s\\S]*iv2_ga_select_ideagroup_{{ category }}_{{ group }}(?![0-9]))", "field": "religionList" },
      { "file": "in_game/common/scripted_guis/IV2_scripted_gui_idea_groups_{{ category }}.txt", "block": "iv2_ideagroup_select_{{ category }}_{{ group }}_1",
        "pattern": "has_variable = iv2_ideagroup_select_{{ category }}_(?!{{ group }}_1)(?<value>\\d+)_1", "field": "exclusive", "join": ", " },
      { "file": "in_game/common/generic_action_ai_lists/iv2_generic_action_list_gov_type.txt", "block": "iv2_ga_list_govtype_\\d+",
