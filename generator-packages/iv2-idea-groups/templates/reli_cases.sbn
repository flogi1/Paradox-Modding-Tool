{{~ # Ein switch-Fall je Religion (prefix "religion =") bzw. Religionsgruppe (prefix "religion.group ="), mit den Modifikatoren 1..n der Stufe ~}}
{{~ if groupType == "reli" ~}}
{{~ case_prefix = "religion =" ~}}
{{~ cases = [] ~}}
{{~ for c in condition_lines ~}}
{{~ if c | string.starts_with case_prefix ~}}
{{~ cases = cases | array.add c ~}}
{{~ end ~}}
{{~ end ~}}
{{~ for c in cases ~}}
			{{ case_key c }} = {
{{~ for n in 1..item.index ~}}
				add_country_modifier = { modifier = ideagroup_modifier_{{ g }}_{{ n }} years = -1 }
{{~ end ~}}
			}
{{~ if !for.last ~}}

{{~ end ~}}
{{~ end ~}}
{{~ end ~}}
