template iv_2_tooltip_template_idea_{{ g }} {
	
	
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icon_idea_{{ category }}.dds"

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.3
				}
			}
		}
		
		blockoverride "title_text" {
			text = "iv2_ideagroup_title_{{ g }}"
		}
		
		blockoverride "concept_link" {
			text = "[iv2_gc_idea_groups_{{ category }}|e]"
		}
	}
}
