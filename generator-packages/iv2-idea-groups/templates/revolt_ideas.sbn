{{~ if groupType == "none" || groupType == "gov" ~}}
	if = {
			limit = {
				root = { has_country_modifier = ideagroup_modifier_{{ g }}_1 }
			}
			add_country_modifier = { 
					modifier = ideagroup_modifier_{{ g }}_1
					years = -1 
			}
	}	
		
