 iv2_ideagroup_title_{{ g }}: "{{ title }}"
{{~ for i in ideas ~}}
 iv2_ga_ideagroup_{{ g }}_{{ i.index }}: "{{ i.name }}"
 iv2_ga_ideagroup_{{ g }}_{{ i.index }}_desc: "{{ i.desc }}"
{{~ end ~}}
 
 STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_1:0 "$iv2_ga_ideagroup_{{ g }}_1$"
 STATIC_MODIFIER_DESC_ideagroup_modifier_{{ g }}_1:0 "$iv2_ga_ideagroup_{{ g }}_1_desc$"
 STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_2:0 "$iv2_ga_ideagroup_{{ g }}_2$"
 STATIC_MODIFIER_DESC_ideagroup_modifier_{{ g }}_2:0 "$iv2_ga_ideagroup_{{ g }}_2_desc$"
 STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_3:0 "$iv2_ga_ideagroup_{{ g }}_3$"
 STATIC_MODIFIER_DESC_ideagroup_modifier_{{ g }}_3:0 "$iv2_ga_ideagroup_{{ g }}_3_desc$"
 STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_4:0 "$iv2_ga_ideagroup_{{ g }}_4$"
 STATIC_MODIFIER_DESC_ideagroup_modifier_{{ g }}_4:0 "$iv2_ga_ideagroup_{{ g }}_4_desc$"
 STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_5:0 "$iv2_ga_ideagroup_{{ g }}_5$"
 STATIC_MODIFIER_DESC_ideagroup_modifier_{{ g }}_5:0 "$iv2_ga_ideagroup_{{ g }}_5_desc$"
 STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_6:0 "$iv2_ga_ideagroup_{{ g }}_6$"
 STATIC_MODIFIER_DESC_ideagroup_modifier_{{ g }}_6:0 "$iv2_ga_ideagroup_{{ g }}_6_desc$"
 STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_7:0 "$iv2_ga_ideagroup_{{ g }}_7$"
 STATIC_MODIFIER_DESC_ideagroup_modifier_{{ g }}_7:0 "$iv2_ga_ideagroup_{{ g }}_7_desc$"
 
 iv2_ga_select_ideagroup_{{ g }}: "$iv2_select$ $iv2_ideagroup_title_{{ g }}$"
 iv2_ga_select_ideagroup_{{ g }}_desc: "$iv2_selects$ $iv2_ideagroup_title_{{ g }}$."
 iv2_idea_tt_{{ g }}_1: "$STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_1$ \n\n[GetModifier('ideagroup_modifier_{{ g }}_1').GetDesc]"
 iv2_idea_tt_{{ g }}_2: "$STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_2$ \n\n[GetModifier('ideagroup_modifier_{{ g }}_2').GetDesc]"
 iv2_idea_tt_{{ g }}_3: "$STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_3$ \n\n[GetModifier('ideagroup_modifier_{{ g }}_3').GetDesc]"
 iv2_idea_tt_{{ g }}_4: "$STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_4$ \n\n[GetModifier('ideagroup_modifier_{{ g }}_4').GetDesc]"
 iv2_idea_tt_{{ g }}_5: "$STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_5$ \n\n[GetModifier('ideagroup_modifier_{{ g }}_5').GetDesc]"
 iv2_idea_tt_{{ g }}_6: "$STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_6$ \n\n[GetModifier('ideagroup_modifier_{{ g }}_6').GetDesc]"
 iv2_idea_tt_{{ g }}_7: "$STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_7$ \n\n[GetModifier('ideagroup_modifier_{{ g }}_7').GetDesc]"
 
 iv2_ga_deselect_ideagroup_{{ g }}: "$iv2_remove$ $iv2_ideagroup_title_{{ g }}$."
 iv2_ga_deselect_ideagroup_{{ g }}_desc: "$iv2_removes$ $iv2_ideagroup_title_{{ g }}$."
 iv2_ideagroup_title_text_{{ g }}_1: "$iv2_ga_ideagroup_{{ g }}_1$"
 iv2_ideagroup_title_text_{{ g }}_2: "$iv2_ga_ideagroup_{{ g }}_2$"
 iv2_ideagroup_title_text_{{ g }}_3: "$iv2_ga_ideagroup_{{ g }}_3$"
 iv2_ideagroup_title_text_{{ g }}_4: "$iv2_ga_ideagroup_{{ g }}_4$"
 iv2_ideagroup_title_text_{{ g }}_5: "$iv2_ga_ideagroup_{{ g }}_5$"
 iv2_ideagroup_title_text_{{ g }}_6: "$iv2_ga_ideagroup_{{ g }}_6$"
 iv2_ideagroup_title_text_{{ g }}_7: "$iv2_ga_ideagroup_{{ g }}_7$"
 iv2_ideagroup_idea_content_{{ g }}: "$STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_1$ \n\n[GetModifier('ideagroup_modifier_{{ g }}_1').GetDesc] \n\n $STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_2$ \n\n[GetModifier('ideagroup_modifier_{{ g }}_2').GetDesc] \n\n $STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_3$ \n\n[GetModifier('ideagroup_modifier_{{ g }}_3').GetDesc] \n\n $STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_4$ \n\n[GetModifier('ideagroup_modifier_{{ g }}_4').GetDesc] \n\n $STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_5$ \n\n[GetModifier('ideagroup_modifier_{{ g }}_5').GetDesc] \n\n $STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_6$ \n\n[GetModifier('ideagroup_modifier_{{ g }}_6').GetDesc] \n\n $STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_7$ \n\n[GetModifier('ideagroup_modifier_{{ g }}_7').GetDesc]"
 
 iv2_ideagroup_concept_link_{{ g }}: "$iv2_ideagroup_title_{{ g }}$ [iv2_gc_idea_groups_{{ category }}|e]"
