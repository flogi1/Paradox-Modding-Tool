template iv2_ideagroup_tt_{{ g }} {
	SimpleContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/ideagroups/ig_icon_{{ g }}.dds"

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.3
				}
			}
		}

		blockoverride "title_text" {
			text = "iv2_ideagroup_title_{{ g }}"
		}

		blockoverride "tooltip_content" {
			
			
			TooltipFlavorTextBlock = {
				blockoverride "text" {
					text = "iv2_ideagroup_idea_content_{{ g }}"
				}
			}
		}
	}
}
