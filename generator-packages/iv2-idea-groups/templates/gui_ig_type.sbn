	type iv2_ig_{{ g }} = container { 	
		visible = "[EqualTo_string(Scope.GetFlagName, 'iv2_{{ g }}')]"

		# Background Template
		icon = {
			size = { 390 120 }
			position = { 10 0 }
			parentanchor = center
			texture = "gfx/interface/iv2_idea_group_template_with_scrollbar.dds"
		}
						
		# Idea Group Name		
		text_single = {
			text = "iv2_ideagroup_title_{{ g }}"
			position = { 170 14 }
			minimumsize = { 115 20 }
			maximumsize = { 150 20 }
			default_format = "#overview_text"
			align = left|nobaseline
			
			tooltipwidget = {
						using = iv2_ideagroup_tt_{{ g }}
			}
			
		}		
				
		# Idea Group Icon		
		icon = {
			size = { 52 52 }
			position = { -135 -5 }
			parentanchor = center
			texture = "gfx/interface/icons/ideagroups/ig_icon_{{ g }}.dds"

			tooltipwidget = {
				using = iv2_ideagroup_tt_{{ g }}
			}
		}	

		icon = {
			name = "frame"
			datacontext = "[GetScriptedGui('iv2_gui_ideagroup_{{ g }}_no_scrollbar')]"
			visible = "[GetScriptedGui('iv2_gui_ideagroup_{{ g }}_no_scrollbar').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					
			size = { 282 16 }	
			texture = "gfx/interface/progressbar_frame_iv2_3.dds"
			spriteType = Corneredstretched
			parentanchor = center
			position = { 44 30 }
			
			using = button_panel_tab_icon_effect
			
			tooltipwidget = {
				using = iv_scrollbar_{{ category }}_ideagroup_tooltip_template
			}
					 
		 }
							
		progressbar = {
			datacontext = "[GetScriptedGui('iv2_gui_ideagroup_{{ g }}_no_scrollbar')]"
			visible = "[GetScriptedGui('iv2_gui_ideagroup_{{ g }}_no_scrollbar').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			
			size = { 275 10 }
			position = { 105 86 }
			using = progress_bar_blue_grey_alt
			min = 0
			max = "[FixedPointToFloat(Country.MakeScope.Var('iv2_var_idea_cost_{{ category }}').GetValue)]"
			value = "[FixedPointToFloat(Country.MakeScope.Var('iv2_var_innovation_points_{{ category }}').GetValue)]"
			noprogresstexture = "gfx/interface/progressbars/progress_gray_bg.dds"
			block "progress_setup" {}
			
			tooltipwidget = {
				using = iv_scrollbar_{{ category }}_ideagroup_tooltip_template
				}							
		}
									
		# Remove Idea Group Icon
		card_header_button_04 = {
			size = { 25 25 }
			position = { 372 5 }
			
			scripted_action_tooltip = {
				click_type = left
				click_mode = confirm
				action_name = "iv2_ga_deselect_ideagroup_{{ g }}"
				actor = "[Player]"
				parameter = {
					parameter_name = "target"
					parameter_value = "[Country.MakeScope]"
				}
			}
			enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
			
			tooltipwidget = {
					using = iv_2_tooltip_template_idea_remove_{{ g }}
			}
			
			icon = {
				size = { 25 25 }
				parentanchor = center
				texture = "gfx/interface/buttons/flats/close_button.dds"
				texture_density = 2

				using = button_panel_tab_icon_effect
				
				modify_texture = {
					using = color_new_gold_texture
					blend_mode = add
				}

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.8
				}
			
			}
		}				
		
		card_header_button_04 = {
			size = { 36 41 }
			position = { 105 37 }
			datacontext = "[GetScriptedGui('iv2_gui_ideagroup_{{ g }}_1')]"
			enabled = "[GetScriptedGui('iv2_gui_ideagroup_{{ g }}_1').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			

			scripted_action_tooltip = {
				click_type = left
				click_mode = confirm
				action_name = "iv2_ga_ideagroup_{{ g }}_1"
				actor = "[Player]"
				parameter = {
					parameter_name = "target"
					parameter_value = "[Country.MakeScope]"
				}
			}
			#onclick = "[GetVariableSystem.Set( 'iv2_var_ideagroup_{{ g }}_1' )]"
			
			tooltipwidget = {
				using = iv_2_tooltip_template_idea_{{ g }}_1
				blockoverride "tooltip_content" {
					using = iv2_idea_tt_template_{{ g }}_1	
				}
			}
			
			icon = {
				size = { 30 30 }
				parentanchor = center
				texture = "[GetModifier('ideagroup_modifier_{{ g }}_1').GetIcon]"
				texture_density = 2

				using = button_panel_tab_icon_effect
			}
		}
			
		card_header_button_04 = {
			size = { 36 41 }
			position = { 145 37 }
			datacontext = "[GetScriptedGui('iv2_gui_ideagroup_{{ g }}_2')]"
