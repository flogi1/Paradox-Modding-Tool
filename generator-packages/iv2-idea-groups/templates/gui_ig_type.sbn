				}
			}
			
			icon = {
				size = { 28 28 }
				parentanchor = center
				texture = "[GetModifier('ideagroup_modifier_{{ g }}_2').GetIcon]"
				texture_density = 2

				using = button_panel_tab_icon_effect
			
			}
		}
			
