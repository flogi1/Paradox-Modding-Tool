		container = {
				datacontext = "[GetScriptedGui('iv2_ideagroup_select_{{ g }}_1')]"
				visible = "[ScriptedGui.IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"	
				

				card_header_button_04 = {
				size = { 324 70 }
						position = { 0 0 }
						scripted_action_tooltip = {
							click_type = left
							click_mode = confirm
							action_name = "iv2_ga_select_ideagroup_{{ g }}"
							actor = "[Player]"
							parameter = {
								parameter_name = "target"
								parameter_value = "[Country.MakeScope]"
							}
						}
						enabled = "[PdxGuiWidget.IsUberButtonEnabled]"
						
						tooltipwidget = {
								using = iv_2_tooltip_template_idea_{{ g }}
						}
						
						#onclick = "[ExecuteConsoleCommand('GUI.ClearWidgets ideas_selection_window_{{ category }}')]"
							
				icon = {
							size = { 332 86 }
							position = { 0 6 }
							parentanchor = center
							texture = "gfx/interface/iv2_idea_group_template.dds"
						}		
				}		
						
				text_single = {
					text = "iv2_ideagroup_title_{{ g }}"
					position = { 110 5 }
					minimumsize = { 115 20 }
					maximumsize = { 150 20 }
                    default_format = "#overview_text"
                    align = left|nobaseline
					
					tooltipwidget = {
								using = iv2_ideagroup_tt_{{ g }}
							}
				}
