{{~ if groupType == "reli" && condition_lines.size > 0 ~}}
{{~ for condition in condition_lines ~}}
		if = {
			limit = {
				root = { iv2_scripted_trigger_has_religion_ig_selected = yes }
				{{ condition }}
			}
			fire_generic_action = {
				type = iv2_ga_select_ideagroup_{{ g }}
				actor = scope:target
				recipient = scope:target
			}
		}
{{~ if !for.last ~}}

{{~ end ~}}
{{~ end ~}}
{{~ else if groupType != "none" ~}}
		if = {
			limit = {
				root = { iv2_scripted_trigger_has_{{ type_word }}_ig_selected = yes }
{{~ for line in extras ~}}
				{{ line }}
{{~ end ~}}
			}
			fire_generic_action = {
				type = iv2_ga_select_ideagroup_{{ g }}
				actor = scope:target
				recipient = scope:target
			}
		}
{{~ end ~}}
