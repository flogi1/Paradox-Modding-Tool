###################################################
###### {{ g }} Idea Start
###################################################

template iv2_individual_idea_{{ g }}_1 {
	SimpleContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetModifier('ideagroup_modifier_{{ g }}_1').GetIcon]"

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.3
				}
			}
		}

		blockoverride "title_text" {
			text = "STATIC_MODIFIER_NAME_ideagroup_modifier_{{ g }}_1"
		}

		blockoverride "tooltip_content" {
			
			
			TooltipFlavorTextBlock = {
				visible = "[Not(StringIsEmpty(GetModifier('ideagroup_modifier_{{ g }}_1').GetDesc))]"
				blockoverride "text" {
					text = "[GetModifier('ideagroup_modifier_{{ g }}_1').GetDesc]"
				}
			}
		}
	}
}

