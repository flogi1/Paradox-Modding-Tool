###############################################################
#### Idea Group {{ g }} 
###############################################################

iv2_scripted_effect_ig_revoke_{{ g }} = {
	if = {
		limit = { 
			has_country_modifier = ideagroup_modifier_{{ g }}_1
		}
		
		remove_country_modifier = ideagroup_modifier_{{ g }}_1
		change_variable = {
			name = iv2_var_innovation_points_{{ category }}
			add = iv2_idea_cost_refund_{{ category }}
		}
	}
	if = {
		limit = { 
			has_country_modifier = ideagroup_modifier_{{ g }}_2
		}
		
		remove_country_modifier = ideagroup_modifier_{{ g }}_2
		change_variable = {
			name = iv2_var_innovation_points_{{ category }}
			add = iv2_idea_cost_refund_{{ category }}
		}
	}
