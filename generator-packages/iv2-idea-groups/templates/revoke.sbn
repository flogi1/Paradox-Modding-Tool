		remove_country_modifier = ideagroup_modifier_{{ g }}_6
		change_variable = {
			name = iv2_var_innovation_points_{{ category }}
			add = iv2_idea_cost_refund_{{ category }}
		}
	}
	if = {
		limit = { 
			has_country_modifier = ideagroup_modifier_{{ g }}_7
		}
		
		remove_country_modifier = ideagroup_modifier_{{ g }}_7
		change_variable = {
			name = iv2_var_innovation_points_{{ category }}
