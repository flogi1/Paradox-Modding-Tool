template iv_2_tooltip_template_nat_idea_{{ id }} {

	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/national_ideas/icon_national_ideas_{{ category }}.dds"

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.3
				}
			}
		}

		blockoverride "title_text" {
			text = "STATIC_MODIFIER_NAME_national_idea_modifier_{{ id }}"
		}

		blockoverride "concept_link" {
			text = "[iv2_gc_national_idea_{{ category }}|e]"
		}

		blockoverride "tooltip_content" {

			TooltipTextBlock = {
			name = "DescriptionTest"
				visible = "[Not(StringIsEmpty(GetModifier('national_idea_modifier_{{ id }}').GetDesc))]"
				blockoverride "text" {
					text = "iv2_ga_select_national_idea_{{ id }}_desc"
				}
			}

			TooltipFlavorTextBlock = {
				visible = "[Not(StringIsEmpty(GetModifier('national_idea_modifier_{{ id }}').GetDesc))]"
				blockoverride "text" {
					text = "[GetModifier('national_idea_modifier_{{ id }}').GetDesc]"
				}
			}

		}
	}
}
