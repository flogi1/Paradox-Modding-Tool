###################################################
###### Idea Variation 2 GA Idea Groups Admin
###################################################

{{~ for c in categories ~}}
{{~ for i in c.ideas ~}}
{{~ exp0 = i.levels[0].expensive ? "_expensive" : "" ~}}
{{~ sct = c.key == "adm" ? "iv2_sct_nat_idea_" + tag + "_1" : "iv2_sct_dnat_idea_" + c.key + "_1" ~}}
###############################################################
#### Select National Idea {{ tag }}_{{ i.number }}
###############################################################

iv2_ga_select_historic_{{ tag }}_{{ i.number }} = {
	type = owncountry

	ai_tick = never
	#ai_tick_frequency = 36

	automation_tick = monthly
	automation_tick_frequency = 1
	player_automated_category = governmentreforms

	allow = {
		scope:actor = {
			hidden_trigger = {
{{~ for l in i.levels ~}}
				NOT = { has_country_modifier = national_idea_modifier_{{ tag }}_{{ i.number }}{{ l.suffix }} }
{{~ end ~}}
			}
			custom_tooltip = {
				text = iv2_tt_no_points_for_nat_idea{{ exp0 }}_{{ c.key }}
				var:iv2_var_progress_points_{{ c.key }} >= var:iv2_var_national_idea_cost{{ exp0 }}_{{ c.key }}
			}
			custom_tooltip = {
				text = iv2_tt_not_reached_national_idea_limit
				var:iv2_var_current_national_idea_limit > var:iv2_var_national_idea_current
			}
			{{ sct }} = yes
		}
	}

	ai_will_do = {
		add = {
			value = 1000
		}
	}

	effect = {
		scope:actor = {
			hidden_effect = {
				add_country_modifier = {
					modifier = national_idea_modifier_{{ tag }}_{{ i.number }}
					years = -1
				}
				set_variable = {
					name = iv2_var_nat_{{ c.key }}_1
					value = flag:iv2_picked_historic_idea_{{ tag }}_{{ i.number }}
				}
				add_to_variable_list = {
					name = iv2_picked_national_ideas_list
					target = flag:iv2_picked_historic_idea_{{ tag }}_{{ i.number }}
				}
				change_variable = {
					name = iv2_var_national_idea_current
					add = 1
				}
			}
			custom_tooltip = {
				text = iv2_tt_sub_points{{ exp0 }}_{{ c.key }}
				change_variable = {
					name = iv2_var_progress_points_{{ c.key }}
					subtract = var:iv2_var_national_idea_cost{{ exp0 }}_{{ c.key }}
				}
			}
			custom_tooltip = {
				text = iv2_tt_increase_points_{{ c.key }}
				change_variable = {
					name = iv2_var_national_idea_cost_{{ c.key }}
					add = iv2_progress_cost_increase
				}
				change_variable = {
					name = iv2_var_national_idea_cost_expensive_{{ c.key }}
					add = iv2_progress_cost_increase
				}
			}
		}
	}
}

{{~ for l in i.levels ~}}
{{~ if !l.first ~}}
{{~ expl = l.expensive ? "_expensive" : "" ~}}
{{~ prev = level_suffix(l.index0 - 1) ~}}
###############################################################
#### National Idea Level {{ l.index }} {{ c.key }}_1{{ l.suffix }}
###############################################################

iv2_ga_select_historic_{{ tag }}_{{ i.number }}{{ l.suffix }} = {
	type = owncountry

	ai_tick = monthly
	ai_tick_frequency = 36

	automation_tick = monthly
	automation_tick_frequency = 1
	player_automated_category = governmentreforms

	allow = {
		scope:actor = {
			custom_tooltip = {
				text = iv2_tt_no_innovation_points_for_nat_idea{{ expl }}_{{ c.key }}
				has_country_modifier = national_idea_modifier_{{ tag }}_{{ i.number }}{{ prev }}
				var:iv2_var_innovation_points_{{ c.key }} >= var:iv2_var_national_idea_innovation_cost{{ expl }}_{{ c.key }}
			}
			{{ sct }}{{ l.suffix }} = yes
		}
	}

	ai_will_do = {
		add = {
			value = 1000
		}
	}

	effect = {
		scope:actor = {
			hidden_effect = {
				add_country_modifier = {
					modifier = national_idea_modifier_{{ tag }}_{{ i.number }}{{ l.suffix }}
					years = -1
				}
				remove_country_modifier = national_idea_modifier_{{ tag }}_{{ i.number }}{{ prev }}
			}
			custom_tooltip = {
				text = {{ l.expensive ? "iv2_tt_sub_points_innovation_expensive_" : "iv2_tt_sub_points_innovation_" }}{{ c.key }}
				change_variable = {
					name = iv2_var_innovation_points_{{ c.key }}
					subtract = var:iv2_var_national_idea_innovation_cost{{ expl }}_{{ c.key }}
				}
			}
			custom_tooltip = {
				text = iv2_tt_increase_innovation_points_{{ c.key }}
				change_variable = {
					name = iv2_var_national_idea_innovation_cost_{{ c.key }}
					add = iv2_innovation_cost_increase
				}
				change_variable = {
					name = iv2_var_national_idea_innovation_cost_expensive_{{ c.key }}
					add = iv2_innovation_cost_increase
				}
			}
		}
	}
}

{{~ end ~}}
{{~ end ~}}
###############################################################
#### Deselect National Idea {{ c.key }}_1
###############################################################

iv2_ga_deselect_historic_{{ tag }}_{{ i.number }} = {
	type = owncountry

	ai_tick = never

	allow = {
		scope:actor = {
			OR = {
{{~ for l in i.levels ~}}
				has_country_modifier = national_idea_modifier_{{ tag }}_{{ i.number }}{{ l.suffix }}
{{~ end ~}}
			}
		}
	}

	effect = {
		scope:actor = {
			custom_tooltip = {
				text = iv2_tt_give_up_nat_idea_{{ c.key }}

{{~ for l in i.levels ~}}
				if = {
					limit = {
						has_country_modifier = national_idea_modifier_{{ tag }}_{{ i.number }}{{ l.suffix }}
					}
					remove_country_modifier = national_idea_modifier_{{ tag }}_{{ i.number }}{{ l.suffix }}
					change_variable = {
						name = iv2_var_national_idea_cost_{{ c.key }}
						subtract = iv2_progress_cost_increase
					}
{{~ if !l.first ~}}
					change_variable = {
						name = iv2_var_national_idea_innovation_cost_{{ c.key }}
						subtract = {{ innovation_decrease(l.index0) }}
					}
{{~ end ~}}
				}
{{~ end ~}}
			}
			hidden_effect = {
				remove_list_variable = {
					name = iv2_picked_national_ideas_list
					target = flag:iv2_picked_historic_idea_{{ tag }}_{{ i.number }}
				}
				change_variable = {
					name = iv2_var_national_idea_current
					subtract = 1
				}
			}
		}
	}
}

{{~ end ~}}
{{~ end ~}}
