# GENERATED by PMT package iv2 - historic AI chooser
# The AI picks the historic national ideas of {{ tag }} here: weighted random_list, earlier ideas of a category more likely.
# Trigger and effect of each entry are those of iv2_ga_select_historic_{{ tag }}_<n> (generic_actions.sbn); keep both in sync
# (except the alert recalc at the end of the player action, which the AI does not need).
{{~
filled = 0
total = 0
for c in categories
  if c.ideas.size > 0
    filled = filled + 1
    total = total + c.ideas.size
  end
end
mean = filled > 0 ? total / filled : 0
~}}

iv2_ga_ai_choose_historic_{{ tag }} = {
	type = owncountry

	ai_tick = monthly
	ai_tick_frequency = 6

	automation_tick = never

	potential = {
		scope:actor = { is_ai = yes has_or_had_tag = {{ tag }} }
	}

	allow = {
		scope:actor = {
			iv2_scripted_trigger_use_historic_ideas = yes
			var:iv2_var_current_national_idea_limit > var:iv2_var_national_idea_current
			# at least one entry must be valid: a random_list without a valid option is an engine error
			OR = {
{{~ for c in categories ~}}
{{~ for i in c.ideas ~}}
{{~ exp0 = i.levels[0].expensive ? "_expensive" : "" ~}}
{{~ sct = "iv2_sct_nat_idea_" + tag + "_" + i.number ~}}
				AND = {
					scope:actor = {
						hidden_trigger = {
{{~ for l in i.levels ~}}
							NOT = { has_country_modifier = national_idea_modifier_{{ tag }}_{{ i.number }}{{ l.suffix }} }
{{~ end ~}}
						}
						custom_tooltip = {
							text = iv2_tt_no_points_for_nat_idea{{ exp0 }}_{{ c.key }}
							var:iv2_var_progress_points_{{ c.key }} >= var:iv2_var_national_idea_cost{{ exp0 }}_{{ c.key }}
						}
						custom_tooltip = {
							text = iv2_tt_not_reached_national_idea_limit
							var:iv2_var_current_national_idea_limit > var:iv2_var_national_idea_current
						}
						{{ sct }} = yes
					}
				}
{{~ end ~}}
{{~ end ~}}
			}
		}
	}

	ai_will_do = {
		add = {
			value = 1000
		}
	}

	effect = {
		scope:actor = {
			random_list = {
{{~ for c in categories ~}}
{{~ for i in c.ideas ~}}
{{~ exp0 = i.levels[0].expensive ? "_expensive" : "" ~}}
{{~ sct = "iv2_sct_nat_idea_" + tag + "_" + i.number ~}}
				{{ historic_weight for.index c.ideas.size mean }} = {  # {{ tag }}_{{ i.number }}
					trigger = {
						scope:actor = {
							hidden_trigger = {
{{~ for l in i.levels ~}}
								NOT = { has_country_modifier = national_idea_modifier_{{ tag }}_{{ i.number }}{{ l.suffix }} }
{{~ end ~}}
							}
							custom_tooltip = {
								text = iv2_tt_no_points_for_nat_idea{{ exp0 }}_{{ c.key }}
								var:iv2_var_progress_points_{{ c.key }} >= var:iv2_var_national_idea_cost{{ exp0 }}_{{ c.key }}
							}
							custom_tooltip = {
								text = iv2_tt_not_reached_national_idea_limit
								var:iv2_var_current_national_idea_limit > var:iv2_var_national_idea_current
							}
							{{ sct }} = yes
						}
					}
					scope:actor = {
						hidden_effect = {
							add_country_modifier = {
								modifier = national_idea_modifier_{{ tag }}_{{ i.number }}
								years = -1
							}
							set_variable = {
								name = iv2_var_nat_{{ c.key }}_1
								value = flag:iv2_picked_historic_idea_{{ tag }}_{{ i.number }}
							}
							add_to_variable_list = {
								name = iv2_picked_national_ideas_list
								target = flag:iv2_picked_historic_idea_{{ tag }}_{{ i.number }}
							}
							change_variable = {
								name = iv2_var_national_idea_current
								add = 1
							}
						}
						custom_tooltip = {
							text = iv2_tt_sub_points{{ exp0 }}_{{ c.key }}
							change_variable = {
								name = iv2_var_progress_points_{{ c.key }}
								subtract = var:iv2_var_national_idea_cost{{ exp0 }}_{{ c.key }}
							}
						}
						custom_tooltip = {
							text = iv2_tt_increase_points_{{ c.key }}
							change_variable = {
								name = iv2_var_national_idea_cost_{{ c.key }}
								add = iv2_progress_cost_increase
							}
							change_variable = {
								name = iv2_var_national_idea_cost_expensive_{{ c.key }}
								add = iv2_progress_cost_increase
							}
						}
					}
				}
{{~ end ~}}
{{~ end ~}}
			}
		}
	}
}
