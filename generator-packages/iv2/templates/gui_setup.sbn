##########################################################################################################################
####### {{ tag }} National Ideas Setup
##########################################################################################################################

template iv2_{{ tag }}_flag_tt {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				size = { 48 48 }
				texture = "gfx/interface/coa/{{ tag }}.dds"
				texture_density = 2
			}
		}

		blockoverride "title_text" {
			text = "iv2_hist_idea_flag_tt_title_{{ tag }}"
		}

		blockoverride "concept_link" {
			text = "[iv2_gc_national_ideas|e]"
		}

		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				name = "DescriptionTest"
				blockoverride "text" {
					text = "iv2_hist_idea_flag_tt_desc_{{ tag }}"
				}
			}
		}
	}
}
