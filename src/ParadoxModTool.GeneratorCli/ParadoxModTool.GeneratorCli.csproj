<Project Sdk="Microsoft.NET.Sdk">

  <!-- pmt-generator.exe: Prüfbefehle für Generator-Pakete ohne Oberfläche (für KIs mit Dateizugriff). Liegt im Programmordner neben ParadoxModTool.exe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ParadoxModTool.GeneratorCli</RootNamespace>
    <AssemblyName>pmt-generator</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ParadoxModTool.Generators\ParadoxModTool.Generators.csproj" />
    <ProjectReference Include="..\ParadoxModTool.Localization\ParadoxModTool.Localization.csproj" />
  </ItemGroup>

</Project>
