<Window x:Class="ParadoxModTool.App.ScopePathWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:ParadoxModTool.Settings;assembly=ParadoxModTool.Settings"
        Title="{x:Static settings:ScopeFinderTexts.Title}"
        Height="720" Width="780" MinHeight="560" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <!--
        Scope Finder: oben der Start (Von) und die Iterator-Form, unten Vorschau und Knöpfe, alles gültig für beide Tabs. Tab "Kette" baut die Kette
        Glied für Glied (Bedingung if, limit bei Iteratoren, Wert am Ende). Tab "Weg suchen" sucht Wege vom Start zu einem Ziel-Scope, kürzeste zuerst;
        die Auswahl eines Weges übernimmt ihn in die Kette, ohne den Tab zu wechseln. Das Einfügen selbst übernimmt das Hauptfenster.
    -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static settings:ScopeFinderTexts.From}" VerticalAlignment="Center" Margin="0,0,8,6" FontWeight="SemiBold" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static settings:ScopeFinderTexts.Search}" VerticalAlignment="Center" Margin="0,0,6,6"
                       Foreground="{DynamicResource Theme.TextMuted}" />
            <TextBox x:Name="StartSearchBox" Grid.Row="0" Grid.Column="2" Margin="0,0,8,6" TextChanged="StartSearch_TextChanged" PreviewKeyDown="ListSearch_PreviewKeyDown"
                     ToolTip="{x:Static settings:ScopeFinderTexts.SearchFromTip}" />
            <ComboBox x:Name="StartBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,6" DisplayMemberPath="Label"
                      SelectionChanged="StartOrGoal_Changed" ToolTip="{x:Static settings:ScopeFinderTexts.FromTip}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static settings:ScopeFinderTexts.Iterator}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="FormBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Width="150" HorizontalAlignment="Left"
                      SelectionChanged="Form_Changed" ToolTip="{x:Static settings:ScopeFinderTexts.IteratorTip}">
                <ComboBoxItem Content="{x:Static settings:ScopeFinderTexts.FormAny}" Tag="any" />
                <ComboBoxItem Content="{x:Static settings:ScopeFinderTexts.FormEvery}" Tag="every" />
                <ComboBoxItem Content="{x:Static settings:ScopeFinderTexts.FormRandom}" Tag="random" />
                <ComboBoxItem Content="{x:Static settings:ScopeFinderTexts.FormOrdered}" Tag="ordered" />
            </ComboBox>
        </Grid>

        <TabControl x:Name="Tabs" Grid.Row="1">
            <TabItem x:Name="ChainTab" Header="{x:Static settings:ScopeFinderTexts.Chain}" ToolTip="{x:Static settings:ScopeFinderTexts.TabChainTip}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="{x:Static settings:ScopeFinderTexts.Start}" Width="60" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <CheckBox x:Name="StartConditionBox" DockPanel.Dock="Right" Content="{x:Static settings:ScopeFinderTexts.Condition}" VerticalAlignment="Center"
                                  Click="StartCondition_Click" ToolTip="{x:Static settings:ScopeFinderTexts.ConditionTip}" />
                        <TextBlock x:Name="StartText" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LinksList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Content="{x:Static settings:ScopeFinderTexts.RemoveFrom}" Tag="{Binding Index}" Padding="6,0"
                                                Click="RemoveFrom_Click" ToolTip="{x:Static settings:ScopeFinderTexts.RemoveFromTip}" />
                                        <CheckBox DockPanel.Dock="Right" Content="{x:Static settings:ScopeFinderTexts.Limit}" Tag="{Binding Index}" Margin="0,0,12,0"
                                                  VerticalAlignment="Center" IsChecked="{Binding Limit, Mode=OneWay}" Visibility="{Binding LimitVisibility}"
                                                  IsEnabled="{Binding LimitEnabled}" ToolTip="{Binding LimitTip}" ToolTipService.ShowOnDisabled="True"
                                                  Click="LinkLimit_Click" />
                                        <CheckBox DockPanel.Dock="Right" Content="{x:Static settings:ScopeFinderTexts.Condition}" Tag="{Binding Index}" Margin="0,0,12,0"
                                                  VerticalAlignment="Center" IsChecked="{Binding Condition, Mode=OneWay}"
                                                  ToolTip="{x:Static settings:ScopeFinderTexts.ConditionTip}" Click="LinkCondition_Click" />
                                        <TextBlock Text="{Binding Number}" Width="60" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextMuted}" />
                                        <TextBlock Text="{Binding Text}" FontFamily="Consolas" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Scope}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextMuted}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static settings:ScopeFinderTexts.Append}" VerticalAlignment="Center" Margin="0,0,8,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static settings:ScopeFinderTexts.Search}" VerticalAlignment="Center" Margin="0,0,6,4"
                                   Foreground="{DynamicResource Theme.TextMuted}" />
                        <TextBox x:Name="AppendSearchBox" Grid.Row="0" Grid.Column="2" Margin="0,0,8,4" TextChanged="AppendSearch_TextChanged"
                                 PreviewKeyDown="AppendSearch_PreviewKeyDown" ToolTip="{x:Static settings:ScopeFinderTexts.SearchAppendTip}" />
                        <ComboBox x:Name="AppendBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,4" DisplayMemberPath="Text" IsTextSearchEnabled="True"
                                  TextSearch.TextPath="Text" DropDownClosed="AppendBox_DropDownClosed" PreviewKeyDown="AppendBox_PreviewKeyDown" ToolTip="{x:Static settings:ScopeFinderTexts.AppendTip}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static settings:ScopeFinderTexts.Value}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static settings:ScopeFinderTexts.Search}" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource Theme.TextMuted}" />
                        <TextBox x:Name="ValueSearchBox" Grid.Row="1" Grid.Column="2" Margin="0,0,8,0" TextChanged="ValueSearch_TextChanged"
                                 PreviewKeyDown="ValueSearch_PreviewKeyDown" ToolTip="{x:Static settings:ScopeFinderTexts.SearchValueTip}" />
                        <ComboBox x:Name="ValueBox" Grid.Row="1" Grid.Column="3" IsEditable="True" IsTextSearchEnabled="True"
                                  ToolTipService.ShowOnDisabled="True" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="SearchTab" Header="{x:Static settings:ScopeFinderTexts.TabSearch}" ToolTip="{x:Static settings:ScopeFinderTexts.TabSearchTip}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static settings:ScopeFinderTexts.To}" VerticalAlignment="Center" Margin="0,0,8,6" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static settings:ScopeFinderTexts.Search}" VerticalAlignment="Center" Margin="0,0,6,6"
                               Foreground="{DynamicResource Theme.TextMuted}" />
                    <TextBox x:Name="GoalSearchBox" Grid.Row="0" Grid.Column="2" Margin="0,0,8,6" TextChanged="GoalSearch_TextChanged" PreviewKeyDown="ListSearch_PreviewKeyDown"
                             ToolTip="{x:Static settings:ScopeFinderTexts.SearchToTip}" />
                    <ComboBox x:Name="GoalBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,6" IsTextSearchEnabled="True"
                              SelectionChanged="StartOrGoal_Changed" ToolTip="{x:Static settings:ScopeFinderTexts.ToTip}" />

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{x:Static settings:ScopeFinderTexts.Steps}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="StepsBox" Width="60" SelectionChanged="Options_Changed" ToolTip="{x:Static settings:ScopeFinderTexts.StepsTip}">
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" IsSelected="True" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="4" />
                        </ComboBox>
                        <CheckBox x:Name="GlobalLinksBox" Margin="16,0,0,0" VerticalAlignment="Center"
                                  Content="{x:Static settings:ScopeFinderTexts.GlobalLinks}" Click="Options_Changed"
                                  ToolTip="{x:Static settings:ScopeFinderTexts.GlobalLinksTip}" />
                    </StackPanel>

                    <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,6">
                        <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Theme.TextMuted}" />
                        <TextBlock Text="{x:Static settings:ScopeFinderTexts.Filter}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="FilterBox" TextChanged="Filter_TextChanged" PreviewKeyDown="ListSearch_PreviewKeyDown"
                                 ToolTip="{x:Static settings:ScopeFinderTexts.FilterTip}" />
                    </DockPanel>

                    <ListBox x:Name="PathsList" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" HorizontalContentAlignment="Stretch"
                             SelectionChanged="PathsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="HintText" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.TextMuted}" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Die Vorschau gilt für beide Tabs: sie zeigt die aktuelle Kette, auch während man im Tab "Weg suchen" Wege anklickt. -->
        <TextBlock Grid.Row="2" Text="{x:Static settings:ScopeFinderTexts.Preview}" Margin="0,8,0,2" />
        <TextBox x:Name="PreviewBox" Grid.Row="3" Height="130" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" AcceptsReturn="True" />

        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="InsertButton" Content="{x:Static settings:ScopeFinderTexts.Insert}" MinWidth="90" Margin="0,0,6,0" IsEnabled="False"
                        Click="Insert_Click" IsDefault="True" ToolTip="{x:Static settings:ScopeFinderTexts.InsertTip}" />
                <Button x:Name="ChainButton" Content="{x:Static settings:ScopeFinderTexts.ChainOnly}" MinWidth="90" Margin="0,0,6,0" IsEnabled="False"
                        Click="Chain_Click" ToolTip="{x:Static settings:ScopeFinderTexts.ChainOnlyTip}" />
                <Button Content="{x:Static settings:ScopeFinderTexts.Close}" MinWidth="90" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
