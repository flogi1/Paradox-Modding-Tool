<Window x:Class="ParadoxModTool.App.ModsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ParadoxModTool.Localization;assembly=ParadoxModTool.Localization"
        xmlns:mods="clr-namespace:ParadoxModTool.Mods;assembly=ParadoxModTool.Mods"
        Title="Mods" Height="460" Width="780" MinHeight="320" MinWidth="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!--
        Mod-Verwaltung: links die Mods dieses Spiels, rechts die Ordner der gewählten Mod. Eine Mod hat eine feste ID; wird ein Ordner verschoben oder umbenannt,
        bleibt die Mod (und alles, was an ihr hängt) erhalten, wenn der Ordner hier neu verknüpft wird.
    -->
    <DockPanel Margin="12">
        <TextBlock x:Name="InfoText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap"
                   Text="{x:Static mods:ModsTexts.WindowInfo}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.6*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="{x:Static mods:ModsTexts.WindowModsHeader}" FontWeight="Bold" Margin="0,0,0,4" />
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button Content="{x:Static mods:ModsTexts.Add}" Padding="8,2" Margin="0,0,6,4" Click="AddMod_Click"
                            ToolTip="{x:Static mods:ModsTexts.AddTip}" />
                    <Button x:Name="RenameButton" Content="{x:Static mods:ModsTexts.Rename}" Padding="8,2" Margin="0,0,6,4" Click="Rename_Click" />
                    <Button x:Name="RemoveModButton" Content="{x:Static loc:CommonTexts.Remove}" Padding="8,2" Margin="0,0,6,4" Click="RemoveMod_Click"
                            ToolTip="{x:Static mods:ModsTexts.RemoveModTip}" />
                    <Button x:Name="ReleasesButton" Content="{x:Static mods:ModsTexts.Upload}" Padding="8,2" Margin="0,0,6,4" Click="Releases_Click"
                            ToolTip="{x:Static mods:ModsTexts.UploadTip}" />
                    <Button x:Name="AssignProjectButton" Content="{x:Static mods:ModsTexts.AssignProject}" Padding="8,2" Margin="0,0,6,4" Click="AssignProject_Click"
                            ToolTip="{x:Static mods:ModsTexts.AssignProjectTip}" />
                    <Button x:Name="LockButton" Content="{x:Static mods:ModsTexts.Lock}" Padding="8,2" Margin="0,0,6,4" Click="Lock_Click"
                            ToolTip="{x:Static mods:ModsTexts.LockTip}" />
                    <Button x:Name="SyncButton" Content="{x:Static mods:ModsTexts.Sync}" Padding="8,2" Margin="0,0,6,4" Click="Sync_Click"
                            ToolTip="{x:Static mods:ModsTexts.SyncTip}" />
                    <Button x:Name="CompatButton" Content="{x:Static mods:ModsTexts.Compat}" Padding="8,2" Margin="0,0,0,4" Click="Compat_Click"
                            ToolTip="{x:Static mods:ModsTexts.CompatTip}" />
                </WrapPanel>
                <ListBox x:Name="ModList" SelectionChanged="ModList_SelectionChanged">
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="ModContextMenu_Opened">
                            <MenuItem Header="{x:Static mods:ModsTexts.AddToCompatSet}" Click="Compat_Click" />
                            <Separator />
                            <MenuItem x:Name="SetCompatchMenuItem" Click="SetCompatch_Click" />
                            <MenuItem x:Name="ClearCompatchMenuItem" Click="ClearCompatch_Click" />
                            <MenuItem x:Name="OpenCompatchMenuItem" Click="OpenCompatch_Click" />
                            <Separator />
                            <MenuItem x:Name="QuickStartMenuItem" Click="QuickStart_Click" />
                            <MenuItem x:Name="QuickNewMenuItem" Click="QuickNew_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Margin="{Binding Indent}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="{x:Static mods:ModsTexts.FoldersHeader}" FontWeight="Bold" Margin="0,0,0,4" />
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button x:Name="AddPathButton" Content="{x:Static mods:ModsTexts.AddFolder}" Padding="8,2" Margin="0,0,6,4" Click="AddPath_Click"
                            ToolTip="{x:Static mods:ModsTexts.AddFolderTip}" />
                    <Button x:Name="RelinkButton" Content="{x:Static mods:ModsTexts.Relink}" Padding="8,2" Margin="0,0,6,4" Click="Relink_Click"
                            ToolTip="{x:Static mods:ModsTexts.RelinkTip}" />
                    <Button x:Name="RemovePathButton" Content="{x:Static mods:ModsTexts.RemoveFolder}" Padding="8,2" Margin="0,0,0,4" Click="RemovePath_Click" />
                </WrapPanel>
                <ListBox x:Name="PathList" DisplayMemberPath="Display" SelectionChanged="PathList_SelectionChanged" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
