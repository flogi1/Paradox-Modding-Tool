<Window x:Class="ParadoxModTool.App.GoToLineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ParadoxModTool.Localization;assembly=ParadoxModTool.Localization"
        xmlns:local="clr-namespace:ParadoxModTool.App"
        Title="{x:Static local:MiscWindowTexts.GoToLineTitle}"
        Height="140" Width="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <!--
        Minimaler Dialog für "Gehe zu Zeile" (Nutzer-Feedback; Strg+G wie in Notepad++). Bewusst
        OHNE eigenen KeyDown-Handler für Enter/Escape: Der "OK"-Button trägt IsDefault="True" und
        der "Abbrechen"-Button IsCancel="True" - WPF aktiviert diese beim Drücken von Enter bzw.
        Escape automatisch, auch während die TextBox fokussiert ist.
    -->
    <StackPanel Margin="12">
        <TextBlock Text="{x:Static local:MiscWindowTexts.GoToLineLineNumber}" Margin="0,0,0,4" />
        <TextBox x:Name="LineNumberBox" Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static loc:CommonTexts.Ok}" Width="70" Margin="0,0,6,0" Click="Ok_Click" IsDefault="True" />
            <Button Content="{x:Static loc:CommonTexts.Cancel}" Width="70" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
