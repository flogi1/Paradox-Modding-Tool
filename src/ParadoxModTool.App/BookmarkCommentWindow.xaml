<Window x:Class="ParadoxModTool.App.BookmarkCommentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lesezeichen" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <!--
        Kleiner Dialog für ein Lesezeichen mit Kommentar (Nutzer-Feedback: "Kommentarfeld, das an die
        markierte Codestelle gekoppelt ist"). Zeigt die betroffene Zeile bzw. den Zeilenbereich und
        eine Vorschau, dazu das Kommentarfeld. "Entfernen" erscheint nur bei einem bereits
        bestehenden Lesezeichen.
    -->
    <StackPanel Margin="12">
        <TextBlock x:Name="LineText" FontWeight="Bold" />
        <TextBlock x:Name="PreviewText" Foreground="{DynamicResource Theme.TextMuted}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,2,0,8" />
        <TextBlock Text="Kommentar:" Margin="0,0,0,2" />
        <TextBox x:Name="CommentTextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                 VerticalScrollBarVisibility="Auto" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="RemoveButton" Content="Entfernen" Width="80" Margin="0,0,6,0" Click="Remove_Click" />
            <Button Content="Speichern" Width="80" Margin="0,0,6,0" IsDefault="True" Click="Save_Click" />
            <Button Content="Abbrechen" Width="80" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
