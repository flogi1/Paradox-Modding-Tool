<Window x:Class="ParadoxModTool.App.ThemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ParadoxModTool.Localization;assembly=ParadoxModTool.Localization"
        xmlns:local="clr-namespace:ParadoxModTool.App"
        Title="{x:Static local:MiscWindowTexts.ThemeEditorTitle}" Width="820" Height="660" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <!-- Theme-Editor (Paket 12b): links die Themes (Hell/Dunkel eingebaut, eigene bearbeitbar), rechts alle Farb-Tokens nach
         Gruppen mit Farbwähler und Hex-Feld. Änderungen zeigen sich sofort in der ganzen Anwendung (Live-Vorschau);
         erst "OK" speichert und aktiviert das gewählte Theme, "Abbrechen" stellt den vorherigen Zustand wieder her. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Themes" FontWeight="SemiBold" Margin="0,0,0,4" />
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="{x:Static local:MiscWindowTexts.ThemeNewCopy}" Margin="0,0,4,4" Click="NewCopy_Click"
                        ToolTip="{x:Static local:MiscWindowTexts.ThemeNewCopyTip}" />
                <Button x:Name="DeleteButton" Content="{x:Static loc:CommonTexts.Delete}" Margin="0,0,4,4" Click="Delete_Click" ToolTip="{x:Static local:MiscWindowTexts.ThemeDeleteTip}" />
                <Button Content="{x:Static local:MiscWindowTexts.ThemeImport}" Margin="0,0,4,4" Click="Import_Click" ToolTip="{x:Static local:MiscWindowTexts.ThemeImportTip}" />
                <Button Content="{x:Static local:MiscWindowTexts.ThemeExport}" Margin="0,0,4,4" Click="Export_Click" ToolTip="{x:Static local:MiscWindowTexts.ThemeExportTip}" />
            </WrapPanel>
            <ListBox x:Name="ThemeList" DisplayMemberPath="Display" SelectionChanged="ThemeList_SelectionChanged" />
        </DockPanel>

        <DockPanel Grid.Row="0" Grid.Column="2">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="NameBox" Grid.Column="1" TextChanged="NameBox_TextChanged" />
                <CheckBox x:Name="DarkCheck" Grid.Column="2" Content="{x:Static local:MiscWindowTexts.ThemeDark}" Margin="12,0,0,0" VerticalAlignment="Center"
                          Click="DarkCheck_Click"
                          ToolTip="{x:Static local:MiscWindowTexts.ThemeDarkTip}" />
            </Grid>
            <TextBlock x:Name="InfoText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource Theme.TextMuted}"
                       Text="{x:Static local:MiscWindowTexts.ThemeBuiltInInfo}" />
            <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}"
                       Text="{x:Static local:MiscWindowTexts.ThemeColorsHint}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RowsPanel" Margin="0,0,8,0" />
            </ScrollViewer>
        </DockPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static loc:CommonTexts.Ok}" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="{x:Static loc:CommonTexts.Cancel}" Width="90" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
