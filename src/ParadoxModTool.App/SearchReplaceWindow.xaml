<Window x:Class="ParadoxModTool.App.SearchReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParadoxModTool.App"
        Width="640" Height="580" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- Der eigentliche Funktionskasten liegt in SearchReplacePanel (auch vom Reiter "Suche" im rechten Panel genutzt).
         Im Fenster bleiben nur der Tab-Moduswechsel, das Aktivieren und die Rückgabe des Fokus an den Besitzer. -->
    <local:SearchReplacePanel x:Name="Panel" Margin="10" />
</Window>
