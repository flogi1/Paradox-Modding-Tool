<Window x:Class="ParadoxModTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParadoxModTool.App"
        xmlns:editor="clr-namespace:ParadoxModTool.Editor;assembly=ParadoxModTool.Editor"
        xmlns:explorer="clr-namespace:ParadoxModTool.Explorer;assembly=ParadoxModTool.Explorer"
        xmlns:shell="clr-namespace:ParadoxModTool.Shell;assembly=ParadoxModTool.Shell"
        Title="Paradox Modding Tool" Height="720" Width="1080">
    <Window.Resources>
        <!-- Senkrechter Trennstrich zwischen den Grundpunkten der Menüleiste (nur neues Layout, siehe MainWindow.Layout.cs). -->
        <Style x:Key="MenuBarSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Width="1" Height="16" Margin="4,0" VerticalAlignment="Center" Fill="{DynamicResource Theme.Separator}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!--
        Werkzeugleiste gemäß Architektur-Spezifikation, Abschnitt 5 ("Undo für
        Programmaktionen ... laufen über denselben Undo-Stack") und dem ursprünglichen
        Konzept ("Werkzeugleiste ... Erstellen neuer Dokumente, Rückgängigmachen ...").
        "Neu"/"Öffnen…"/"Speichern" sitzen jetzt PRO Arbeitsbereich (siehe EditorPane.xaml),
        da die beiden Arbeitsbereiche im Split-View unabhängig voneinander Dateien öffnen
        können sollen ("zwei unabhängige Arbeitsbereiche", Abschnitt 5); "Rückgängig"/
        "Wiederholen" bleiben global, da beide Arbeitsbereiche denselben Undo-Stack teilen.
    -->
    <DockPanel>
        <!-- Menüleiste in der Reihenfolge der UI-Reorganisation (Spec "Menüleiste"). Alle Texte setzt MainWindow.Menu.cs aus MenuTexts;
             Einstellungen und GUI behalten ihre Texte aus SettingsTexts bzw. GuiTexts. -->
        <Menu DockPanel.Dock="Top">
            <!-- Übersicht über die Mods aller Spiele (MainWindow.MyMods.cs), ganz links. -->
            <MenuItem x:Name="MyModsMenuItem" Click="OpenMyMods_Click" />
            <Separator x:Name="MenuSeparator1" Style="{StaticResource MenuBarSeparator}" Visibility="Collapsed" />
            <!-- Weiteres Spiel in einem eigenen Fenster öffnen (siehe MainWindow.Games.cs); die Einträge entstehen beim Öffnen. -->
            <MenuItem x:Name="WindowMenuItem" SubmenuOpened="WindowMenuItem_SubmenuOpened">
                <MenuItem />
            </MenuItem>
            <!-- Playset-Verwaltung direkt hinter der Spielauswahl (nur im neuen Layout; im klassischen steht sie bei den Werkzeugen). -->
            <Separator x:Name="MenuSeparator1b" Style="{StaticResource MenuBarSeparator}" Visibility="Collapsed" />
            <MenuItem x:Name="PlaysetsBarMenuItem" Click="OpenPlaysets_Click" Visibility="Collapsed" />
            <Separator x:Name="MenuSeparator2" Style="{StaticResource MenuBarSeparator}" Visibility="Collapsed" />
            <!-- Mods: aktive Mod wählen (fest oder automatisch) und Mods verwalten; Einträge baut MainWindow.Mods.cs beim Aufklappen. -->
            <MenuItem x:Name="ModsMenuItem" SubmenuOpened="ModsMenu_SubmenuOpened">
                <Separator />
            </MenuItem>
            <Separator x:Name="MenuSeparator3" Style="{StaticResource MenuBarSeparator}" Visibility="Collapsed" />
            <MenuItem x:Name="ProjectMenuItem">
                <MenuItem x:Name="ProjectCopyMenuItem" />
                <MenuItem x:Name="ProjectMoveMenuItem" />
                <MenuItem x:Name="ProjectCompareMenuItem" />
                <Separator />
                <MenuItem x:Name="ProjectSyncMenuItem" Click="OpenBranchSync_Click" />
            </MenuItem>
            <!-- Einstellungen: ein Klick öffnet das Einstellungsfenster (MainWindow.SettingsHost.cs). -->
            <MenuItem x:Name="SettingsMenuItem" Click="OpenSettings_Click" />
            <Separator x:Name="MenuSeparator4" Style="{StaticResource MenuBarSeparator}" Visibility="Collapsed" />
            <MenuItem x:Name="CuToolMenuItem" Click="OpenVanillaDiffWindow_Click" />
            <MenuItem x:Name="PatchRecipesMenuItem" Click="OpenPatchRecipes_Click" />
            <MenuItem x:Name="GeneratorPackagesMenuItem" Click="OpenGeneratorPackages_Click" />
            <MenuItem x:Name="PackageEditorMenuItem" Click="OpenPackageEditor_Click" />
            <MenuItem x:Name="ModCompatMenuItem" Click="OpenModCompat_Click" />
            <MenuItem x:Name="PlaysetsMenuItem" Click="OpenPlaysets_Click" />
            <MenuItem x:Name="CompatchMenuItem" Click="OpenCompatch_Click" />
            <MenuItem x:Name="ErrorLogMenuItem" Click="OpenErrorLog_Click" />
            <MenuItem x:Name="DesyncMenuItem" Click="OpenDesync_Click" />
            <MenuItem x:Name="SaveExplorerMenuItem" Click="OpenSaveExplorer_Click" ToolTipService.ShowOnDisabled="True" />
            <MenuItem x:Name="ScriptDocsMenuItem" Click="OpenScriptDocsWindow_Click" />
            <!-- GUI: Texte aus GuiTexts (MainWindow.Gui.cs); "GUI-Inspektor" ist ausgeblendet, wenn die GUI-Werkzeuge aus sind. -->
            <MenuItem x:Name="GuiMenuItem">
                <MenuItem x:Name="GuiInspectMenuItem" Click="GuiInspectMenuItem_Click" />
                <MenuItem x:Name="GuiDataHelperMenuItem" Click="GuiDataHelper_Click" />
                <MenuItem x:Name="GuiBlocksMenuItem" Click="GuiBlocks_Click" />
                <MenuItem x:Name="GuiNewFileMenuItem" Click="NewGuiFile_Click" />
                <MenuItem x:Name="GuiModSettingsMenuItem" Click="GuiModSettings_Click" />
            </MenuItem>
            <MenuItem x:Name="TemplatesMenuItem" Click="OpenTemplateGenerator_Click" />
            <MenuItem x:Name="HelpMenuItem">
                <MenuItem x:Name="CheckUpdatesMenuItem" Click="CheckUpdatesMenuItem_Click" />
                <MenuItem x:Name="ReportBugMenuItem" Click="ReportBugMenuItem_Click" />
                <MenuItem x:Name="ChangelogMenuItem" Click="ChangelogMenuItem_Click" ToolTipService.ShowOnDisabled="True" />
                <Separator />
                <MenuItem x:Name="AboutMenuItem" Click="AboutMenuItem_Click" />
                <!-- Abschnitt "Unterstützen" (nur neues Layout; klassisch bleibt das eigene Menü unten). -->
                <Separator x:Name="HelpSupportSeparator" Visibility="Collapsed" />
                <MenuItem x:Name="HelpSupportHeader" IsEnabled="False" Visibility="Collapsed" />
                <MenuItem x:Name="HelpSponsorMenuItem" Click="SponsorMenuItem_Click" Visibility="Collapsed" />
                <MenuItem x:Name="HelpKofiMenuItem" Click="KofiMenuItem_Click" Visibility="Collapsed" />
            </MenuItem>
            <!-- Unterstützen: Spendenseiten (AppInfo.SponsorUrl, AppInfo.KofiUrl). -->
            <MenuItem x:Name="SupportMenuItem">
                <MenuItem x:Name="SponsorMenuItem" Click="SponsorMenuItem_Click" />
                <MenuItem x:Name="KofiMenuItem" Click="KofiMenuItem_Click" />
            </MenuItem>
        </Menu>
        <!-- Hinweisleiste "Neue Version verfügbar" (Nutzerwunsch: Update-Hinweis über GitHub Releases). -->
        <Border x:Name="UpdateBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource Theme.NoticeBackground}" BorderBrush="{DynamicResource Theme.NoticeBorder}"
                BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel LastChildFill="True">
                <Button x:Name="UpdateBarLaterButton" DockPanel.Dock="Right" Content="✕" Padding="6,0" Margin="6,0,0,0" Click="UpdateBarLater_Click" />
                <Button x:Name="UpdateBarSkipButton" DockPanel.Dock="Right" Padding="8,0" Margin="6,0,0,0" Click="UpdateBarSkip_Click" />
                <Button x:Name="UpdateBarReleaseButton" DockPanel.Dock="Right" Padding="8,0" Margin="6,0,0,0" Click="UpdateBarRelease_Click" />
                <Button x:Name="UpdateBarInstallButton" DockPanel.Dock="Right" Padding="8,0" Margin="6,0,0,0" FontWeight="SemiBold" Click="UpdateBarInstall_Click" />
                <TextBlock x:Name="UpdateBarText" VerticalAlignment="Center" Foreground="{DynamicResource Theme.NoticeText}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <!-- Kachelleiste (Interface-Rework 2): die großen Werkzeuge; Sichtbarkeit nach Layout und TileBarVisible (ApplyTileBar). -->
        <shell:TileBar x:Name="TileBarControl" DockPanel.Dock="Top" Visibility="Collapsed" />
        <!-- Pool der Elemente der kleinen Werkzeugleiste (Interface-Rework 2): sie bleiben hier mit ihren Namen, damit alle Partials sie
             kennen; ToolbarBuilder (MainWindow.Layout.cs, RebuildToolbar) hängt sie in der Reihenfolge von AppSettings.ToolbarOrder in den
             ToolbarHost unten um. Inhalt und Tooltips setzt ApplyToolbarContent. "Rückgängig"/"Wiederholen" gelten für Programmaktionen
             beider Arbeitsbereiche (ein Verlauf). -->
        <StackPanel x:Name="ToolbarElementPool" Visibility="Collapsed">
            <Button x:Name="ToolbarNewButton" Click="ToolbarNew_Click" Focusable="False" />
            <Button x:Name="ToolbarOpenButton" Click="ToolbarOpen_Click" Focusable="False" />
            <Button x:Name="ToolbarSaveButton" Click="ToolbarSave_Click" Focusable="False" />
            <Button x:Name="ToolbarSaveAllButton" Click="ToolbarSaveAll_Click" Focusable="False" />
            <Button x:Name="ToolbarCloseButton" Click="ToolbarClose_Click" Focusable="False" />
            <Button x:Name="ToolbarMoveButton" Click="ToolbarMove_Click" Focusable="False" />
            <Button x:Name="UndoButton" Click="Undo_Click" IsEnabled="False" Focusable="False" />
            <Button x:Name="RedoButton" Click="Redo_Click" IsEnabled="False" Focusable="False" />
            <Button x:Name="ToolbarSearchButton" Click="SearchReplace_Click" Focusable="False" />
            <Button x:Name="ToolbarGoToLineButton" Click="GoToLine_Click" Focusable="False" />
            <Button x:Name="ToolbarGoToBracketButton" Click="GoToMatchingBracket_Click" Focusable="False" />
            <Button x:Name="ToolbarScopeFinderButton" Click="ScopePaths_Click" Focusable="False" />
            <Button x:Name="ToolbarGuiDataHelperButton" Click="GuiDataHelper_Click" Focusable="False" />
            <Button x:Name="ToolbarTemplatesButton" Click="OpenTemplateGenerator_Click" Focusable="False" />
            <Button x:Name="ToolbarFormatButton" Click="FormatDocument_Click" Focusable="False" />
            <Button x:Name="ToolbarNotesButton" Click="FileNote_Click" Focusable="False" />
            <Button x:Name="ToolbarBookmarkButton" Click="BookmarkWithComment_Click" Focusable="False" />
            <Button x:Name="ToolbarBugButton" Click="NewBug_Click" Focusable="False" />
            <Button x:Name="ToolbarBugTrackerButton" Click="BugTracker_Click" Focusable="False" />
            <ToggleButton x:Name="SplitViewToggle" Click="SplitViewToggle_Click" Focusable="False" />
            <ToggleButton x:Name="ExplorerToggle" Click="ExplorerToggle_Click" IsChecked="True" Focusable="False" />
            <ToggleButton x:Name="NotesPanelToggle" Click="NotesPanelToggle_Click" IsChecked="True" Focusable="False" />
            <ToggleButton x:Name="ScriptAutoCompleteToggle" Click="ScriptAutoCompleteToggle_Click" IsChecked="True" Focusable="False" />
            <ToggleButton x:Name="ScriptHoverToggle" Click="ScriptHoverToggle_Click" IsChecked="True" Focusable="False" />
            <Button x:Name="ToolbarModifierReloadButton" Click="ModifierReload_Click" Focusable="False" />
            <!-- Startoptionen kommen aus dem aktiven Spielprofil (GameProfile.LaunchOptions), Playsets aus playsets.json (PlaysetStore).
                 Ohne Playsets bleibt die Combo leer und "Spiel starten" wechselt kein Playset. Senkrecht vertreten Menü-Knöpfe die Combos. -->
            <ComboBox x:Name="LaunchOptionsCombo" Width="260" DisplayMemberPath="Label" />
            <ComboBox x:Name="PlaysetsCombo" Width="220" DisplayMemberPath="DisplayText" />
            <Button x:Name="LaunchGameButton" Click="LaunchGame_Click" Focusable="False" />
        </StackPanel>
        <!-- Statusleiste: zeigt die erkannte Mod (siehe MainWindow.Mods.cs); ein Klick öffnet das Fenster "Mods…". -->
        <Border x:Name="ModStatusBar" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Theme.Separator}" BorderThickness="0,1,0,0" Padding="8,2">
            <TextBlock x:Name="ModStatusText" Text="Mod: —" Foreground="{DynamicResource Theme.TextMuted}" Cursor="Hand" TextTrimming="CharacterEllipsis"
                       MouseLeftButtonUp="ModStatus_Click"
                       ToolTip="{x:Static local:MainTexts.ModStatusTip}" />
        </Border>
        <!-- Ergebnisleiste für "Suchen & Ersetzen" (Abschnitt 5b, Nutzer-Feedback: "Suchergebnisse
             [...] in einem Fenster über meinem Arbeitsbereich anzeigen [...], wie bei Notepad").
             Bindet an dieselbe geteilte Trefferliste wie das modale Suchen-Fenster (siehe
             MainWindow.xaml.cs) und blendet sich automatisch ein, sobald ein neuer Treffer
             hinzukommt; Standardzustand ausgeblendet, solange noch nicht gesucht wurde.
             DockPanel.Dock="Bottom" ist der neue STANDARD (Nutzer-Feedback: "soll per Default am
             unteren Rand erscheinen") - über das "Einstellungen"-Menü lässt sich das zur Laufzeit
             auf "Top" umschalten (siehe MainWindow.xaml.cs, ApplyResultsPanelPosition). Randlinien
             oben UND unten, damit die Leiste optisch sauber abgegrenzt ist, unabhängig davon, ob
             sie gerade über oder unter dem Arbeitsbereich sitzt. -->
        <Border x:Name="ResultsPanel" DockPanel.Dock="Bottom" Visibility="Collapsed"
                BorderBrush="{DynamicResource Theme.Separator}" BorderThickness="0,1,0,1">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="4,4,4,2">
                    <Button DockPanel.Dock="Right" Content="✕" Click="CloseResultsPanel_Click"
                            Padding="6,0" ToolTip="{x:Static local:MainTexts.ResultsHideTip}" />
                    <CheckBox x:Name="ResultsPanelHideDescriptionCheckBox" DockPanel.Dock="Right"
                              Content="{x:Static local:MainTexts.ResultsCodeOnly}" Margin="0,0,12,0"
                              Click="ResultsPanelHideDescriptionCheckBox_Changed" />
                    <TextBlock Text="{x:Static local:MainTexts.ResultsTitle}" FontWeight="Bold" VerticalAlignment="Center" />
                </DockPanel>
                <!-- Code der markierten Treffer: hier lassen sich Teile eines Treffers markieren und kopieren. -->
                <TextBox x:Name="ResultsPanelDetail" DockPanel.Dock="Bottom" Margin="4,2,4,4" IsReadOnly="True" FontFamily="Consolas"
                         MinHeight="36" MaxHeight="90" AcceptsReturn="True" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" />
                <ListBox x:Name="ResultsPanelList" MaxHeight="180" FontFamily="Consolas"
                         MouseDoubleClick="ResultsPanelList_MouseDoubleClick"
                         ToolTip="{x:Static local:MainTexts.ResultsListTip}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,3">
                                <TextBlock Text="{Binding Description}" Visibility="{Binding DescriptionVisibility}"
                                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.TextMuted}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding MatchedText, Mode=OneWay}" FontFamily="Consolas" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <!-- Kleine Werkzeugleiste: Position oben, links, rechts oder unten (ApplyToolbarPosition). Steht nach Status- und Ergebnisleiste,
             damit sie links/rechts zwischen Kachelleiste und Statusleiste sitzt. -->
        <Border x:Name="ToolbarHost" DockPanel.Dock="Top" BorderBrush="{DynamicResource Theme.Separator}" BorderThickness="0,0,0,1" />
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Verzeichnis-Übersicht links, wie bei Notepad++ - zwei zusätzliche Spalten
                     VOR den bisherigen drei (Editor/Splitter/Editor), die restlichen
                     Grid.Column-Werte unten daher um 2 erhöht. -->
                <ColumnDefinition x:Name="ExplorerColumn" Width="260" />
                <ColumnDefinition x:Name="ExplorerSplitterColumn" Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="0" />
                <ColumnDefinition x:Name="RightPaneColumn" Width="0" />
                <ColumnDefinition x:Name="NotesSplitterColumn" Width="0" />
                <ColumnDefinition x:Name="NotesPanelColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <explorer:ExplorerPanel x:Name="ExplorerPanelControl" Grid.Column="0" />
            <GridSplitter x:Name="ExplorerSplitter"
                          Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource Theme.Separator}" />
            <editor:EditorPane x:Name="LeftEditor" Grid.Column="2" />
            <GridSplitter x:Name="Splitter"
                          Grid.Column="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource Theme.Separator}"
                          Visibility="Collapsed" />
            <editor:EditorPane x:Name="RightEditor" Grid.Column="4" Visibility="Collapsed" />
            <GridSplitter x:Name="NotesSplitter"
                          Grid.Column="5"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource Theme.Separator}"
                          Visibility="Collapsed" />
            <local:NotesSidePanel x:Name="NotesPanelControl" Grid.Column="6" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
