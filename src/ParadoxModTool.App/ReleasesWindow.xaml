<Window x:Class="ParadoxModTool.App.ReleasesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParadoxModTool.App"
        xmlns:loc="clr-namespace:ParadoxModTool.Localization;assembly=ParadoxModTool.Localization"
        Title="Releases" Height="600" Width="900" MinHeight="440" MinWidth="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!--
        Releases einer Mod: die erfassten Versionen (Nummer und Datum, gespeichert in den Programmdaten) und ihr Text aus dem Changelog im Mod-Ordner.
        Der Changelog ist die einzige Quelle für den Text; das Fenster darf ihn ändern (Sicherungskopie vorher) und neue Versions-Banner anlegen.
    -->
    <DockPanel Margin="12">
        <TextBlock x:Name="InfoText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap"
                   Text="{x:Static local:PublishTexts.ReleasesInfo}" />

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="15" />
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="{x:Static local:PublishTexts.PickChangelog}" Padding="8,2" Margin="8,0,0,0" Click="PickChangelog_Click"
                        ToolTip="{x:Static local:PublishTexts.PickChangelogTip}" />
                <TextBlock Text="{x:Static local:PublishTexts.ChangelogFileLabel}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="ChangelogPathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
            <ItemsControl x:Name="HintList" Margin="0,4,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource Theme.Danger}" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.6*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="{x:Static local:PublishTexts.RecordedReleases}" FontWeight="Bold" Margin="0,0,0,4" />
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button x:Name="PublishButton" Content="{x:Static local:PublishTexts.SteamTitle}" Padding="8,2" Margin="0,0,6,4" Click="Publish_Click"
                            ToolTip="{x:Static local:PublishTexts.SteamPublishTip}" />
                    <Button x:Name="GitHubPublishButton" Content="{x:Static local:PublishTexts.GitHubTitle}" Padding="8,2" Margin="0,0,6,4" Click="GitHubPublish_Click"
                            ToolTip="{x:Static local:PublishTexts.GitHubPublishTip}" />
                    <Button x:Name="RecordButton" Content="{x:Static local:PublishTexts.Record}" Padding="8,2" Margin="0,0,6,4" Click="Record_Click"
                            ToolTip="{x:Static local:PublishTexts.RecordTip}" />
                    <Button x:Name="ImportButton" Content="{x:Static local:PublishTexts.Import}" Padding="8,2" Margin="0,0,6,4" Click="Import_Click"
                            ToolTip="{x:Static local:PublishTexts.ImportTip}" />
                    <Button x:Name="NewVersionButton" Content="{x:Static local:PublishTexts.NewVersion}" Padding="8,2" Margin="0,0,6,4" Click="NewVersion_Click"
                            ToolTip="{x:Static local:PublishTexts.NewVersionTip}" />
                    <Button x:Name="DateButton" Content="{x:Static local:PublishTexts.ChangeDate}" Padding="8,2" Margin="0,0,6,4" Click="ChangeDate_Click" />
                    <Button x:Name="DeleteButton" Content="{x:Static loc:CommonTexts.Delete}" Padding="8,2" Margin="0,0,0,4" Click="Delete_Click"
                            ToolTip="{x:Static local:PublishTexts.DeleteTip}" />
                </WrapPanel>
                <ListBox x:Name="ReleaseList" DisplayMemberPath="Display" SelectionChanged="ReleaseList_SelectionChanged" />
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="{x:Static local:PublishTexts.ChangelogTextHeader}" FontWeight="Bold" Margin="0,0,0,4" />
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button x:Name="SaveTextButton" Content="{x:Static local:PublishTexts.SaveChange}" Padding="8,2" Margin="0,0,6,4" Click="SaveText_Click"
                            ToolTip="{x:Static local:PublishTexts.SaveTextTip}" />
                    <Button x:Name="RevertTextButton" Content="{x:Static local:PublishTexts.Revert}" Padding="8,2" Margin="0,0,0,4" Click="RevertText_Click"
                            ToolTip="{x:Static local:PublishTexts.RevertTextTip}" />
                </WrapPanel>
                <TextBox x:Name="PreviewBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="Consolas"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         TextChanged="PreviewBox_TextChanged" PreviewKeyDown="PreviewBox_PreviewKeyDown" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
