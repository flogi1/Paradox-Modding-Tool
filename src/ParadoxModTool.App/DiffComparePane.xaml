<UserControl x:Class="ParadoxModTool.App.DiffComparePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:local="clr-namespace:ParadoxModTool.App"
             xmlns:loc="clr-namespace:ParadoxModTool.Localization;assembly=ParadoxModTool.Localization">
    <!-- Ein Vergleich des Compare und Update Tools: Leiste über den Editoren, Pfade, Editorpaar mit Übersichtsleisten.
         Jeder Reiter des Fensters hat eine eigene Instanz. -->
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="{x:Static loc:CommonTexts.Save}" Margin="6,0,0,0" Padding="8,0" IsEnabled="False"
                    Click="SaveButton_Click" ToolTip="{x:Static local:MiscWindowTexts.DiffSaveTip}" />
            <TextBlock x:Name="DirtyIndicator" DockPanel.Dock="Right" Text="●" Foreground="{DynamicResource Theme.Warning}" FontSize="14"
                       VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed"
                       ToolTip="{x:Static local:MiscWindowTexts.DiffDirtyTip}" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PreviousDiffButton" Padding="8,0" Click="PreviousDiff_Click" ToolTip="{x:Static local:MiscWindowTexts.DiffPreviousTip}">
                    <TextBlock Text="{x:Static local:MiscWindowTexts.DiffPrevious}" />
                </Button>
                <Button x:Name="NextDiffButton" Margin="6,0,0,0" Padding="8,0" Click="NextDiff_Click" ToolTip="{x:Static local:MiscWindowTexts.DiffNextTip}">
                    <TextBlock Text="{x:Static local:MiscWindowTexts.DiffNext}" />
                </Button>
                <Button x:Name="SearchButton" Margin="12,0,0,0" Padding="8,0" Click="SearchButton_Click" ToolTip="{x:Static local:MiscWindowTexts.DiffSearchTip}">
                    <TextBlock Text="{x:Static local:MiscWindowTexts.DiffSearch}" />
                </Button>
                <CheckBox x:Name="FoldingCheckBox" Margin="12,0,0,0" VerticalAlignment="Center"
                          Checked="FoldingCheckBox_Changed" Unchecked="FoldingCheckBox_Changed"
                          ToolTip="{x:Static local:MiscWindowTexts.DiffFoldingTip}">
                    <TextBlock Text="{x:Static local:MiscWindowTexts.DiffFolding}" />
                </CheckBox>
                <TextBlock Text="{x:Static local:MiscWindowTexts.DiffFoldingNote}" Margin="6,0,0,0" FontSize="11"
                           Foreground="{DynamicResource Theme.TextMuted}" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Pfad der jeweils geöffneten Datei über den Editoren; Ordner öffnen und Pfad kopieren dahinter. -->
            <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,2">
                <Button DockPanel.Dock="Right" x:Name="CopyLeftPathButton" Content="📋" Padding="4,0" Margin="4,0,0,0" FontSize="11"
                        Click="CopyPath_Click" Tag="Left" ToolTip="{x:Static local:MiscWindowTexts.DiffCopyPathTip}" />
                <Button DockPanel.Dock="Right" x:Name="OpenLeftFolderButton" Content="📂" Padding="4,0" Margin="4,0,0,0" FontSize="11"
                        Click="OpenFolder_Click" Tag="Left" ToolTip="{x:Static local:MiscWindowTexts.DiffOpenFolderTip}" />
                <TextBlock x:Name="LeftPathText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <DockPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,2">
                <Button DockPanel.Dock="Right" x:Name="CopyRightPathButton" Content="📋" Padding="4,0" Margin="4,0,0,0" FontSize="11"
                        Click="CopyPath_Click" Tag="Right" ToolTip="{x:Static local:MiscWindowTexts.DiffCopyPathTip}" />
                <Button DockPanel.Dock="Right" x:Name="OpenRightFolderButton" Content="📂" Padding="4,0" Margin="4,0,0,0" FontSize="11"
                        Click="OpenFolder_Click" Tag="Right" ToolTip="{x:Static local:MiscWindowTexts.DiffOpenFolderTip}" />
                <TextBlock x:Name="RightPathText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <Border x:Name="LeftBorder" Grid.Row="1" Grid.Column="0" BorderThickness="2" BorderBrush="Transparent">
                <avalonEdit:TextEditor x:Name="LeftEditor" FontFamily="Consolas" FontSize="13"
                                        Background="{DynamicResource Theme.EditorBackground}"
                                        Foreground="{DynamicResource Theme.EditorForeground}"
                                        LineNumbersForeground="{DynamicResource Theme.LineNumbers}"
                                        IsReadOnly="True" ShowLineNumbers="True" WordWrap="False" />
            </Border>
            <local:DiffOverviewBar x:Name="LeftOverview" Grid.Row="1" Grid.Column="1" Margin="2,0" />
            <Border x:Name="RightBorder" Grid.Row="1" Grid.Column="2" BorderThickness="2" BorderBrush="Transparent">
                <avalonEdit:TextEditor x:Name="RightEditor" FontFamily="Consolas" FontSize="13"
                                        Background="{DynamicResource Theme.EditorBackground}"
                                        Foreground="{DynamicResource Theme.EditorForeground}"
                                        LineNumbersForeground="{DynamicResource Theme.LineNumbers}"
                                        ShowLineNumbers="True" WordWrap="False" />
            </Border>
            <local:DiffOverviewBar x:Name="RightOverview" Grid.Row="1" Grid.Column="3" Margin="2,0,0,0" />
        </Grid>
    </DockPanel>
</UserControl>
