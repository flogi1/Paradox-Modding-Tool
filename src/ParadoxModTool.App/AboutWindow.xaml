<Window x:Class="ParadoxModTool.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ParadoxModTool.Localization;assembly=ParadoxModTool.Localization"
        xmlns:local="clr-namespace:ParadoxModTool.App"
        Title="{x:Static local:MiscWindowTexts.AboutTitle}" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal">
            <Image Source="Assets/app-icon.png" Width="88" Height="88" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="16,6,0,0">
                <TextBlock Text="Paradox Modding Tool" FontSize="22" FontWeight="Bold" />
                <TextBlock x:Name="VersionText" FontSize="13" Margin="0,2,0,0" />
                <TextBlock x:Name="CreatorText" FontSize="13" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap"
                   Text="{x:Static local:MiscWindowTexts.AboutTagline}" />

        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
            <Run FontWeight="SemiBold" Text="{x:Static local:MiscWindowTexts.AboutAiLabel}" />
            <Run Text="{x:Static local:MiscWindowTexts.AboutAiText}" />
        </TextBlock>

        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
            <Run FontWeight="SemiBold" Text="{x:Static local:MiscWindowTexts.AboutLicenseLabel}" />
            <Run Text="{x:Static local:MiscWindowTexts.AboutLicenseText}" />
        </TextBlock>
        <Expander Header="{x:Static local:MiscWindowTexts.AboutLicenseFull}" Margin="0,4,0,0">
            <TextBox x:Name="LicenseBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Height="150" Margin="0,4,0,0" FontFamily="Consolas" FontSize="11" />
        </Expander>

        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
            <Run FontWeight="SemiBold" Text="{x:Static local:MiscWindowTexts.AboutComponentsLabel}" />
            <Run Text="{x:Static local:MiscWindowTexts.AboutComponentsText}" />
        </TextBlock>

        <TextBlock x:Name="RepositoryLine" Margin="0,12,0,0" Visibility="Collapsed">
            <Run FontWeight="SemiBold" Text="{x:Static local:MiscWindowTexts.AboutProjectPage}" />
            <Hyperlink x:Name="RepositoryLink" Click="RepositoryLink_Click"><Run x:Name="RepositoryLinkText" /></Hyperlink>
        </TextBlock>

        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
            <Run FontWeight="SemiBold" Text="{x:Static local:MiscWindowTexts.AboutSupport}" />
            <Hyperlink Click="SponsorLink_Click"><Run x:Name="SponsorLinkText" /></Hyperlink>
            <Run Text=" · " />
            <Hyperlink Click="KofiLink_Click"><Run x:Name="KofiLinkText" /></Hyperlink>
        </TextBlock>

        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}"
                   Text="{x:Static local:MiscWindowTexts.AboutNotAffiliated}" />

        <Button Content="{x:Static loc:CommonTexts.Close}" HorizontalAlignment="Right" Padding="18,4" Margin="0,18,0,0" IsDefault="True" IsCancel="True" />
    </StackPanel>
</Window>
