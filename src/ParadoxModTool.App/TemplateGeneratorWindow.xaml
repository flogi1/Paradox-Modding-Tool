<Window x:Class="ParadoxModTool.App.TemplateGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:ParadoxModTool.App"
        xmlns:loc="clr-namespace:ParadoxModTool.Localization;assembly=ParadoxModTool.Localization"
        xmlns:templates="clr-namespace:ParadoxModTool.Templates;assembly=ParadoxModTool.Templates"
        Title="{x:Static local:TemplateWindowTexts.Title}"
        Height="840" Width="1320" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <!--
        Template-Generator: Beispiel-Snippet einfügen, das Tool erkennt die Stellen, die hochgezählt werden (Zahlen in Bezeichnern und Texten, mehrfach eingefügte Beispiele,
        gleichförmige Unterblöcke), und erzeugt N Durchläufe. Der Prüfmodus zeigt die erkannten Zählpunkte samt Start und Schritt zum Bearbeiten. Optional entstehen passende
        Lokalisierungseinträge aus einer bearbeitbaren Tabelle. Ergebnisse lassen sich einfügen, in ein neues Dokument übernehmen, kopieren oder an eine Datei anhängen.
    -->
    <DockPanel Margin="10">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="{x:Static local:TemplateWindowTexts.TemplateLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="TemplateNameBox" Width="150" VerticalContentAlignment="Center" Margin="0,0,6,0"
                     ToolTip="{x:Static local:TemplateWindowTexts.TemplateNameTip}" />
            <ComboBox x:Name="TemplateBox" Width="150" Margin="0,0,6,0" SelectionChanged="TemplateBox_SelectionChanged"
                      ToolTip="{x:Static local:TemplateWindowTexts.TemplateListTip}" />
            <Button Content="{x:Static local:TemplateWindowTexts.Load}" Padding="8,0" Margin="0,0,6,0" Click="LoadTemplate_Click" ToolTip="{x:Static local:TemplateWindowTexts.LoadTip}" />
            <Button Content="{x:Static loc:CommonTexts.Save}" Padding="8,0" Margin="0,0,6,0" Click="SaveTemplate_Click" ToolTip="{x:Static local:TemplateWindowTexts.SaveTip}" />
            <Button Content="{x:Static loc:CommonTexts.Delete}" Padding="8,0" Margin="0,0,6,0" Click="DeleteTemplate_Click" ToolTip="{x:Static local:TemplateWindowTexts.DeleteTip}" />

            <TextBlock Text="Mod:" VerticalAlignment="Center" Margin="10,0,6,0" />
            <ComboBox x:Name="ModBox" Width="190" Margin="0,0,6,0" SelectionChanged="ModBox_SelectionChanged"
                      ToolTip="{x:Static local:TemplateWindowTexts.ModTip}" />
            <TextBlock Text="{x:Static local:TemplateWindowTexts.SaveIn}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="LayerBox" Width="80" SelectedIndex="0" IsEnabled="False" Margin="0,0,16,0"
                      ToolTip="{x:Static local:TemplateWindowTexts.SaveInTip}">
                <ComboBoxItem Content="{x:Static templates:TemplatesTexts.LayerGame}" />
                <ComboBoxItem Content="Mod" />
            </ComboBox>

            <TextBlock Text="{x:Static local:TemplateWindowTexts.Count}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="CountBox" Width="50" Text="3" Margin="0,0,16,0" VerticalContentAlignment="Center" TextChanged="CountBox_TextChanged"
                     ToolTip="{x:Static local:TemplateWindowTexts.CountTip}" />
            <CheckBox x:Name="CollapseBox" Content="{x:Static local:TemplateWindowTexts.Collapse}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" Click="Options_Click"
                      ToolTip="{x:Static local:TemplateWindowTexts.CollapseTip}" />
            <TextBlock Text="{x:Static local:TemplateWindowTexts.Multi}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="MultiBox" Width="110" SelectedIndex="0" Margin="0,0,16,0" SelectionChanged="MultiBox_SelectionChanged"
                      ToolTip="{x:Static local:TemplateWindowTexts.MultiTip}">
                <ComboBoxItem Content="{x:Static local:TemplateWindowTexts.MultiFirst}" />
                <ComboBoxItem Content="{x:Static local:TemplateWindowTexts.MultiLast}" />
                <ComboBoxItem Content="{x:Static local:TemplateWindowTexts.MultiAll}" />
            </ComboBox>
            <Button x:Name="RulesButton" Content="{x:Static local:TemplateWindowTexts.Rules}" Padding="8,0" Margin="0,0,16,0" Click="RulesButton_Click"
                    ToolTip="{x:Static local:TemplateWindowTexts.RulesTip}" />
            <CheckBox x:Name="ReviewBox" Content="{x:Static local:TemplateWindowTexts.Review}" VerticalAlignment="Center" Margin="0,0,16,0" Click="Options_Click"
                      ToolTip="{x:Static local:TemplateWindowTexts.ReviewTip}" />
            <CheckBox x:Name="LocBox" Content="{x:Static local:TemplateWindowTexts.GenerateLoc}" VerticalAlignment="Center" Margin="0,0,6,0" Click="Options_Click"
                      ToolTip="{x:Static local:TemplateWindowTexts.GenerateLocTip}" />
            <TextBlock Text="{x:Static local:TemplateWindowTexts.Language}" VerticalAlignment="Center" Margin="10,0,6,0" />
            <TextBox x:Name="LanguageBox" Width="90" Text="english" VerticalContentAlignment="Center" TextChanged="Language_TextChanged"
                     ToolTip="{x:Static local:TemplateWindowTexts.LanguageTip}" />
        </WrapPanel>

        <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6" BorderThickness="1" BorderBrush="{DynamicResource Theme.ControlBorder}">
            <WrapPanel>
                <TextBlock Text="{x:Static local:TemplateWindowTexts.FindIn}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="FindTargetBox" Width="100" SelectedIndex="0" Margin="0,0,10,0" SelectionChanged="FindTarget_SelectionChanged"
                          ToolTip="{x:Static local:TemplateWindowTexts.FindTargetTip}">
                    <ComboBoxItem Content="Snippet" />
                    <ComboBoxItem Content="{x:Static local:TemplateWindowTexts.CodePreview}" />
                </ComboBox>
                <TextBox x:Name="FindBox" Width="180" VerticalContentAlignment="Center" Margin="0,0,10,0" KeyDown="FindBox_KeyDown" TextChanged="FindBox_TextChanged"
                         ToolTip="{x:Static local:TemplateWindowTexts.FindTip}" />
                <TextBlock Text="{x:Static local:TemplateWindowTexts.ReplaceLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="ReplaceBox" Width="180" VerticalContentAlignment="Center" Margin="0,0,10,0" />
                <Button Content="{x:Static local:TemplateWindowTexts.FindNext}" Padding="8,0" Margin="0,0,6,0" Click="FindNext_Click" />
                <Button Content="{x:Static local:TemplateWindowTexts.Replace}" Padding="8,0" Margin="0,0,6,0" Click="Replace_Click" />
                <Button Content="{x:Static local:TemplateWindowTexts.ReplaceAll}" Padding="8,0" Margin="0,0,12,0" Click="ReplaceAll_Click" />
                <CheckBox x:Name="MatchCaseBox" Click="FindOptions_Click" Content="{x:Static local:TemplateWindowTexts.MatchCase}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox x:Name="WholeWordBox" Click="FindOptions_Click" Content="{x:Static local:TemplateWindowTexts.WholeWords}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox x:Name="IgnoreFormattingBox" Click="FindOptions_Click" Content="{x:Static local:TemplateWindowTexts.IgnoreFormatting}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"
                          ToolTip="{x:Static local:TemplateWindowTexts.IgnoreFormattingTip}" />
                <TextBlock x:Name="FindStatusText" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextMuted}" />
            </WrapPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" MinWidth="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightColumn" Width="1*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- Links: Snippet und Vorschau -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="140" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="{x:Static local:TemplateWindowTexts.TogglePoint}" Padding="8,0" Click="TogglePointAtCaret_Click"
                            ToolTip="{x:Static local:TemplateWindowTexts.TogglePointTip}" />
                    <TextBlock Text="{x:Static local:TemplateWindowTexts.SnippetHeading}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource Theme.ControlBorder}">
                    <avalonEdit:TextEditor x:Name="SnippetEditor" FontFamily="Consolas" FontSize="13"
                                            Background="{DynamicResource Theme.EditorBackground}"
                                            Foreground="{DynamicResource Theme.EditorForeground}"
                                            LineNumbersForeground="{DynamicResource Theme.LineNumbers}"
                                            ShowLineNumbers="True" WordWrap="False"
                                            HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <avalonEdit:TextEditor.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="Cut" />
                                <MenuItem Command="Copy" />
                                <MenuItem Command="Paste" />
                                <Separator />
                                <MenuItem Header="{x:Static local:TemplateWindowTexts.PointOnOff}" Click="TogglePointAtCaret_Click" />
                                <MenuItem Header="{x:Static local:TemplateWindowTexts.RuleFromNumber}" Click="CreateRuleFromNumber_Click"
                                          ToolTip="{x:Static local:TemplateWindowTexts.RuleFromNumberTip}" />
                            </ContextMenu>
                        </avalonEdit:TextEditor.ContextMenu>
                    </avalonEdit:TextEditor>
                </Border>

                <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" />

                <TabControl x:Name="PreviewTabs" Grid.Row="3" SelectionChanged="PreviewTabs_SelectionChanged">
                    <TabItem Header="Code">
                        <DockPanel Margin="0,6,0,0">
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <Button Content="{x:Static local:TemplateWindowTexts.InsertAtCaret}" Padding="8,0" Margin="0,0,6,0" Click="CodeInsert_Click"
                                        ToolTip="{x:Static local:TemplateWindowTexts.InsertAtCaretTip}" />
                                <Button Content="{x:Static local:TemplateWindowTexts.NewDocument}" Padding="8,0" Margin="0,0,6,0" Click="CodeNewDocument_Click" />
                                <Button Content="{x:Static local:TemplateWindowTexts.Copy}" Padding="8,0" Margin="0,0,6,0" Click="CodeCopy_Click" />
                                <Button Content="{x:Static local:TemplateWindowTexts.AppendToFile}" Padding="8,0" Click="CodeAppend_Click"
                                        ToolTip="{x:Static local:TemplateWindowTexts.CodeAppendTip}" />
                            </WrapPanel>
                            <Border BorderThickness="1" BorderBrush="{DynamicResource Theme.ControlBorder}">
                                <avalonEdit:TextEditor x:Name="CodePreview" FontFamily="Consolas" FontSize="13" IsReadOnly="True"
                                                        Background="{DynamicResource Theme.EditorBackground}"
                                                        Foreground="{DynamicResource Theme.EditorForeground}"
                                                        LineNumbersForeground="{DynamicResource Theme.LineNumbers}"
                                                        ShowLineNumbers="True" WordWrap="False"
                                                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                            </Border>
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="LocTab" Header="{x:Static local:TemplateWindowTexts.LocHeading}" Visibility="Collapsed">
                        <DockPanel Margin="0,6,0,0">
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <Button Content="{x:Static local:TemplateWindowTexts.InsertAtCaret}" Padding="8,0" Margin="0,0,6,0" Click="LocInsert_Click" />
                                <Button Content="{x:Static local:TemplateWindowTexts.NewDocument}" Padding="8,0" Margin="0,0,6,0" Click="LocNewDocument_Click" />
                                <Button Content="{x:Static local:TemplateWindowTexts.Copy}" Padding="8,0" Margin="0,0,6,0" Click="LocCopy_Click" />
                                <Button Content="{x:Static local:TemplateWindowTexts.AppendToFile}" Padding="8,0" Margin="0,0,12,0" Click="LocAppend_Click"
                                        ToolTip="{x:Static local:TemplateWindowTexts.LocAppendTip}" />
                                <Button Content="{x:Static local:TemplateWindowTexts.ResetOverrides}" Padding="8,0" Click="LocResetOverrides_Click"
                                        ToolTip="{x:Static local:TemplateWindowTexts.ResetOverridesTip}" />
                            </WrapPanel>
                            <ListBox x:Name="EntryList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Key}" FontFamily="Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}" />
                                            <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>

            <GridSplitter x:Name="ColumnSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Visibility="Collapsed" />

            <!-- Rechts: Prüfmodus und Lokalisierungstabelle -->
            <Grid x:Name="RightPanel" Grid.Column="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="PointsHeaderPanel" Grid.Row="0">
                    <TextBlock Text="{x:Static local:TemplateWindowTexts.PointsLegend}" FontSize="11"
                               Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <CheckBox x:Name="MarkBox" Content="{x:Static local:TemplateWindowTexts.MarkNumbers}" IsChecked="True" Margin="0,0,0,4" Click="MarkBox_Click"
                              ToolTip="{x:Static local:TemplateWindowTexts.MarkNumbersTip}" />
                    <WrapPanel Margin="0,0,0,4">
                        <TextBox x:Name="PointFilterBox" Width="120" VerticalContentAlignment="Center" Margin="0,0,6,0" TextChanged="PointFilter_Changed"
                                 ToolTip="{x:Static local:TemplateWindowTexts.PointFilterTip}" />
                        <ComboBox x:Name="PointShowBox" Width="140" SelectedIndex="0" Margin="0,0,6,0" SelectionChanged="PointShow_SelectionChanged"
                                  ToolTip="{x:Static local:TemplateWindowTexts.PointShowTip}">
                            <ComboBoxItem Content="{x:Static local:TemplateWindowTexts.ShowAll}" />
                            <ComboBoxItem Content="{x:Static local:TemplateWindowTexts.ShowActive}" />
                            <ComboBoxItem Content="{x:Static local:TemplateWindowTexts.ShowDisabled}" />
                            <ComboBoxItem Content="{x:Static local:TemplateWindowTexts.ShowChanged}" />
                        </ComboBox>
                        <Button x:Name="HideButton" Content="{x:Static local:TemplateWindowTexts.Hide}" Padding="8,0" Margin="0,0,8,0" Click="HideButton_Click"
                                ToolTip="{x:Static local:TemplateWindowTexts.HideTip}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="HideIgnoredItem" Header="{x:Static local:TemplateWindowTexts.HideIgnored}" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" Click="HideItem_Click" />
                                    <MenuItem x:Name="HideNumbersItem" Header="{x:Static local:TemplateWindowTexts.HideNumbers}" IsCheckable="True" StaysOpenOnClick="True" Click="HideItem_Click" />
                                    <MenuItem x:Name="HideTextsItem" Header="{x:Static local:TemplateWindowTexts.HideTexts}" IsCheckable="True" StaysOpenOnClick="True" Click="HideItem_Click" />
                                    <MenuItem x:Name="HideRuleItem" Header="{x:Static local:TemplateWindowTexts.HideRule}" IsCheckable="True" StaysOpenOnClick="True" Click="HideItem_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <TextBlock x:Name="PointCountText" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextMuted}" />
                    </WrapPanel>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="{x:Static local:TemplateWindowTexts.ResetPoints}" Padding="8,0" Click="ResetPoints_Click"
                                ToolTip="{x:Static local:TemplateWindowTexts.ResetPointsTip}" />
                        <Button DockPanel.Dock="Right" Content="{x:Static local:TemplateWindowTexts.CreateRule}" Padding="8,0" Margin="0,0,6,0" Click="CreateRuleFromSelected_Click"
                                ToolTip="{x:Static local:TemplateWindowTexts.CreateRuleTip}" />
                        <TextBlock Text="{x:Static local:TemplateWindowTexts.PointsHeading}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid Margin="4,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="84" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{x:Static local:TemplateWindowTexts.ColumnSpot}" Foreground="{DynamicResource Theme.TextMuted}" />
                        <TextBlock Grid.Column="2" Text="{x:Static local:TemplateWindowTexts.ColumnOccurrences}" Foreground="{DynamicResource Theme.TextMuted}" ToolTip="{x:Static local:TemplateWindowTexts.ColumnOccurrencesTip}" />
                        <TextBlock Grid.Column="3" Text="Start" Foreground="{DynamicResource Theme.TextMuted}" />
                        <TextBlock Grid.Column="4" Text="{x:Static local:TemplateWindowTexts.ColumnStep}" Foreground="{DynamicResource Theme.TextMuted}" ToolTip="{x:Static local:TemplateWindowTexts.ColumnStepTip}" />
                        <TextBlock Grid.Column="5" Text="{x:Static local:TemplateWindowTexts.ColumnInnerStep}" Foreground="{DynamicResource Theme.TextMuted}" ToolTip="{x:Static local:TemplateWindowTexts.ColumnInnerStepTip}" />
                    </Grid>
                </StackPanel>

                <ListBox x:Name="PointList" Grid.Row="1" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="PointList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="4,0,0,0" Margin="0,1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Background" Value="{Binding RowBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="BorderBrush" Value="#FFFF5722" />
                                            <Setter Property="Background" Value="#55FF5722" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="84" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="2,2,0,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="▶" FontWeight="Bold" Foreground="#FFFF5722" Margin="0,0,4,0" ToolTip="{x:Static local:TemplateWindowTexts.SelectedSpotTip}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock DockPanel.Dock="Left" Text="●" Foreground="{DynamicResource Theme.Warning}" Margin="0,0,4,0"
                                                   Visibility="{Binding ChangedVisibility}" ToolTip="{x:Static local:TemplateWindowTexts.ChangedTip}" />
                                        <TextBlock Text="{Binding Label}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Values}" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding ShapeVisibility}" ToolTip="{Binding ShapeToolTip}">
                                        <TextBlock Text="{x:Static local:TemplateWindowTexts.NumbersInName}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Theme.TextMuted}" />
                                        <ItemsControl ItemsSource="{Binding ShapeNumbers}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Digits}" IsChecked="{Binding IsCounted}" FontWeight="{Binding Weight}" FontSize="11"
                                                              Margin="0,0,10,0" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="↺" Padding="5,0" FontSize="11" Visibility="{Binding ResetVisibility}" Click="ResetShapeRule_Click"
                                                ToolTip="{x:Static local:TemplateWindowTexts.ResetShapeTip}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding OccurrenceText}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBox Grid.Column="3" Text="{Binding StartText, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" VerticalAlignment="Top" />
                                <TextBox Grid.Column="4" Text="{Binding StepText, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" VerticalAlignment="Top" />
                                <TextBox Grid.Column="5" Text="{Binding InnerStepText, UpdateSourceTrigger=LostFocus}" Visibility="{Binding InnerVisibility}" VerticalAlignment="Top" ToolTip="{x:Static local:TemplateWindowTexts.InnerStepTip}" />
                            </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="GroupsPanel" Grid.Row="2" Margin="0,6,0,0" Visibility="Collapsed">
                    <TextBlock Text="{x:Static local:TemplateWindowTexts.Groups}" FontWeight="SemiBold" Margin="0,0,0,4"
                               ToolTip="{x:Static local:TemplateWindowTexts.GroupsTip}" />
                    <ItemsControl x:Name="GroupList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Description}" FontFamily="Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="1" Text="{Binding CountText, UpdateSourceTrigger=LostFocus}" ToolTip="{x:Static local:TemplateWindowTexts.GroupCountTip}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Grid x:Name="LocPanel" Grid.Row="3" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{x:Static local:TemplateWindowTexts.LocHeading}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                        <TextBlock Text="{x:Static local:TemplateWindowTexts.FileType}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="ProfileBox" Width="250" Margin="0,0,6,0" SelectionChanged="ProfileBox_SelectionChanged"
                                  ToolTip="{x:Static local:TemplateWindowTexts.ProfileBoxTip}" />
                        <Button Content="{x:Static local:TemplateWindowTexts.Profile}" Padding="8,0" Margin="0,0,12,0" Click="ProfileButton_Click"
                                ToolTip="{x:Static local:TemplateWindowTexts.ProfileTip}" />
                        <TextBlock Text="{x:Static local:TemplateWindowTexts.DefaultText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="DefaultTextBox" Width="130" Text="TODO" VerticalContentAlignment="Center" TextChanged="LocOptions_TextChanged"
                                 ToolTip="{x:Static local:TemplateWindowTexts.DefaultTextTip}" />
                    </WrapPanel>
                    <TextBlock x:Name="ProfileStatusText" Grid.Row="2" Margin="0,0,0,4" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" />
                    <ListBox x:Name="LocRowList" Grid.Row="3" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Selected}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding KeyPattern}" FontFamily="Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding KeyPattern}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Origin}" Foreground="{DynamicResource Theme.TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Origin}" Margin="4,0" />
                                    <TextBox Grid.Column="3" Text="{Binding TextPattern, UpdateSourceTrigger=LostFocus}" ToolTip="{x:Static local:TemplateWindowTexts.TextPatternTip}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
