<Window x:Class="ParadoxModTool.App.FormatDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ParadoxModTool.Localization;assembly=ParadoxModTool.Localization"
        xmlns:local="clr-namespace:ParadoxModTool.App"
        Title="{x:Static local:MiscWindowTexts.FormatTitle}"
        Height="260" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <!--
        Dialog für das Formatierungs-Werkzeug (Konzept, Abschnitt 10: "Tool zum bereinigen
        überschüssiger Leerzeichen oder Tab Sprünge ... auch in der Lage, bereits existierenden
        Codes schöner darzustellen"). Beide Optionen sind unabhängig voneinander wählbar, siehe
        FormatDocumentWindow.xaml.cs und MainWindow.xaml.cs (FormatDocument_Click). Bewusst OHNE
        eigenen KeyDown-Handler - wie bei GoToLineWindow übernehmen IsDefault/IsCancel das.
    -->
    <StackPanel Margin="12">
        <TextBlock Text="{x:Static local:MiscWindowTexts.FormatIntro}"
                   TextWrapping="Wrap" Margin="0,0,0,12" />
        <CheckBox x:Name="CleanWhitespaceCheckBox" IsChecked="True" Margin="0,0,0,10"
                  Content="{x:Static local:MiscWindowTexts.FormatCleanWhitespace}"
                  ToolTip="{x:Static local:MiscWindowTexts.FormatCleanWhitespaceTip}" />
        <CheckBox x:Name="PrettyPrintCheckBox" Margin="0,0,0,4"
                  Content="{x:Static local:MiscWindowTexts.FormatPrettyPrint}" />
        <TextBlock x:Name="PrettyPrintHintText" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Theme.TextMuted}" Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static loc:CommonTexts.Ok}" Width="70" Margin="0,0,6,0" Click="Ok_Click" IsDefault="True" />
            <Button Content="{x:Static loc:CommonTexts.Cancel}" Width="70" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
