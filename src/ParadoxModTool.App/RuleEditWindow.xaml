<Window x:Class="ParadoxModTool.App.RuleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParadoxModTool.App"
        xmlns:loc="clr-namespace:ParadoxModTool.Localization;assembly=ParadoxModTool.Localization"
        Title="{x:Static local:TemplateWindowTexts.EditRuleTitle}" Width="780" Height="760" MinWidth="640" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!--
        Dialog für eine Zählregel: Name, Ebene, Wo, Muster, Aktion. Unten zeigt eine Live-Vorschau, welche Namen im aktuellen Snippet die Regel treffen und
        welche ihrer Zahlen zählen (grün) oder nicht zählen (rot, durchgestrichen). Die ausführliche Anleitung steht im Hilfefenster.
    -->
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{x:Static local:TemplateWindowTexts.Guide}" Padding="10,2" Margin="0,0,16,0" Click="Help_Click" ToolTip="{x:Static local:TemplateWindowTexts.GuideTip}" />
            <Button x:Name="SaveButton" Content="{x:Static loc:CommonTexts.Save}" Width="90" Margin="0,0,6,0" IsDefault="True" Click="Save_Click" />
            <Button Content="{x:Static loc:CommonTexts.Cancel}" Width="90" IsCancel="True" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#E53935" />

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Name:" Margin="0,0,0,2" />
            <TextBox x:Name="NameBox" MaxLength="120" TextChanged="Changed_TextChanged" />

            <StackPanel x:Name="LayerPanel" Margin="0,8,0,0">
                <TextBlock Text="{x:Static local:TemplateWindowTexts.LayerLabel}" Margin="0,0,0,2" />
                <ComboBox x:Name="LayerBox" SelectionChanged="LayerBox_SelectionChanged"
                          ToolTip="{x:Static local:TemplateWindowTexts.LayerTip}" />
            </StackPanel>

            <StackPanel x:Name="GamesHost" Margin="0,8,0,0">
                <TextBlock Text="{x:Static local:TemplateWindowTexts.AppliesToGames}" Margin="0,0,0,2" />
                <CheckBox x:Name="AllGamesCheck" Content="{x:Static local:TemplateWindowTexts.AllGamesCheck}" Click="AllGamesCheck_Click" />
                <WrapPanel x:Name="GamesPanel" Margin="16,4,0,0" />
            </StackPanel>

            <TextBlock Text="{x:Static local:TemplateWindowTexts.WhereLabel}" Margin="0,8,0,2" />
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="WhereBox" Width="200" SelectionChanged="Changed_SelectionChanged"
                          ToolTip="{x:Static local:TemplateWindowTexts.WhereTip}">
                    <ComboBoxItem Content="{x:Static local:TemplateWindowTexts.WhereAnywhere}" />
                    <ComboBoxItem Content="{x:Static local:TemplateWindowTexts.WhereInsideKey}" />
                </ComboBox>
                <TextBlock Text="{x:Static local:TemplateWindowTexts.KeyLabel}" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox x:Name="KeyBox" Width="220" TextChanged="Changed_TextChanged"
                         ToolTip="{x:Static local:TemplateWindowTexts.KeyTip}" />
            </StackPanel>

            <TextBlock Text="{x:Static local:TemplateWindowTexts.PatternsLabel}" Margin="0,8,0,2" />
            <TextBox x:Name="PatternsBox" AcceptsReturn="True" Height="84" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" TextChanged="Changed_TextChanged" />
            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}"
                       Text="{x:Static local:TemplateWindowTexts.PatternsHint}" />
            <CheckBox x:Name="CaseBox" Content="{x:Static local:TemplateWindowTexts.CaseSensitive}" Margin="0,6,0,0" Click="Changed_Click" />

            <TextBlock Text="{x:Static local:TemplateWindowTexts.ActionLabel}" Margin="0,8,0,2" />
            <ComboBox x:Name="ActionBox" SelectionChanged="ActionBox_SelectionChanged" />
            <TextBlock x:Name="ActionHelpText" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" />
        </StackPanel>

        <DockPanel Margin="0,10,0,0">
            <TextBlock x:Name="PreviewCount" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0" Foreground="{DynamicResource Theme.TextMuted}"
                       Text="{x:Static local:TemplateWindowTexts.PreviewLegend}" />
            <ListBox x:Name="PreviewList" FontFamily="Consolas" />
        </DockPanel>
    </DockPanel>
</Window>
