<Window x:Class="ParadoxModTool.App.PublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auf Steam veröffentlichen" Height="860" Width="820" MinHeight="600" MinWidth="700"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!--
        Ein Ablauf: metadata.json (Version) prüfen und speichern, Changenote aus dem Changelog kontrollieren, SteamCMD einrichten, hochladen.
        Der Upload läuft über SteamCMD ohne Fenster und ohne Eingabe; das Programm sieht nie ein Passwort. Hochgeladen wird eine Kopie des Mod-Ordners ohne Versionsäste,
        Snapshots, Versionsverwaltung und Archive.
    -->
    <DockPanel Margin="12">
        <TextBlock x:Name="ResultText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="15" />
                <TextBlock x:Name="AppIdText" Margin="0,2,0,0" Foreground="{DynamicResource Theme.TextMuted}" />
                <DockPanel Margin="0,8,0,0">
                    <Button x:Name="OpenPageButton" DockPanel.Dock="Right" Content="Workshop-Seite öffnen" Padding="8,2" Margin="8,0,0,0" Click="OpenPage_Click" />
                    <Button x:Name="FindIdButton" DockPanel.Dock="Right" Content="Workshop-ID suchen" Padding="8,2" Margin="8,0,0,0" Click="FindId_Click">
                        <Button.ToolTip>
                            <ToolTip MaxWidth="380">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Sucht die Workshop-ID dieser Mod. Zuerst lokal: Steam legt abonnierte Workshop-Mods im eigenen Ordner ab, der Ordnername ist die ID. Findet sich dort nichts, kann das Programm nach Rückfrage die öffentliche Workshop-Seite deines Steam-Profils abrufen und den Titel vergleichen. Es nutzt dafür weder deine Anmeldung noch Cookies." />
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <TextBlock Text="Workshop-ID:" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBox x:Name="WorkshopIdBox" Width="170" HorizontalAlignment="Left" TextChanged="WorkshopIdBox_TextChanged"
                             ToolTip="Leer oder 0: Es wird eine neue Workshop-Seite angelegt. Für eine schon vorhandene Seite: mit &quot;Workshop-ID suchen&quot; finden lassen, die ID oder die ganze Workshop-Adresse hier einfügen." />
                </DockPanel>

                <TextBlock Text="metadata.json" FontWeight="Bold" Margin="0,14,0,4" />
                <DockPanel>
                    <Button x:Name="NewBannerButton" DockPanel.Dock="Right" Content="Neue Version im Changelog anlegen" Padding="8,2" Margin="8,0,0,0" Visibility="Collapsed" Click="NewBanner_Click"
                            ToolTip="Legt oben im Changelog ein Banner für diese Version an" />
                    <TextBlock Text="Version:" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBox x:Name="VersionBox" Width="110" HorizontalAlignment="Left" LostFocus="VersionBox_Commit" KeyDown="VersionBox_KeyDown"
                             ToolTip="Ändert nur das Feld version der Datei (nicht das in relationships). Mit Enter übernehmen, danach speichern." />
                    <Button x:Name="NextVersionButton" Content="+1" Padding="8,2" Margin="6,0,0,0" HorizontalAlignment="Left" Click="NextVersion_Click"
                            ToolTip="Den letzten Teil der Version um eins erhöhen (2.0.5 wird 2.0.6)" />
                </DockPanel>
                <TextBox x:Name="MetaBox" Height="170" Margin="0,6,0,0" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="Consolas"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         TextChanged="MetaBox_TextChanged" PreviewKeyDown="MetaBox_PreviewKeyDown" />
                <WrapPanel Margin="0,6,0,0">
                    <Button x:Name="MetaSaveButton" Content="Änderung speichern" Padding="8,2" Margin="0,0,6,4" Click="MetaSave_Click"
                            ToolTip="Schreibt die Datei (Strg+S). Vorher wird eine Sicherung angelegt; ungültiges JSON wird nicht gespeichert." />
                    <Button x:Name="MetaRevertButton" Content="Verwerfen" Padding="8,2" Margin="0,0,0,4" Click="MetaRevert_Click" />
                </WrapPanel>
                <TextBlock x:Name="MetaErrorText" Foreground="{DynamicResource Theme.Danger}" TextWrapping="Wrap" />

                <TextBlock Text="Prüfungen" FontWeight="Bold" Margin="0,14,0,4" />
                <ItemsControl x:Name="HintList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Hochladen über" FontWeight="Bold" Margin="0,14,0,4" />
                <ComboBox x:Name="MethodBox" Width="260" HorizontalAlignment="Left" SelectionChanged="MethodBox_SelectionChanged">
                    <ComboBoxItem Content="Steam-Client (empfohlen)"
                                  ToolTip="Lädt über dein laufendes, angemeldetes Steam hoch. Es ist nichts einzurichten, keine Anmeldung, keine Konsole. Das Programm nutzt dafür die Steamworks-Bibliothek deines installierten Spiels; es sieht dein Passwort nie." />
                    <ComboBoxItem Content="SteamCMD"
                                  ToolTip="Valves Kommandozeilen-Werkzeug. Braucht einen Download und eine einmalige Anmeldung in einer Konsole." />
                </ComboBox>
                <TextBlock x:Name="ClientStatusText" TextWrapping="Wrap" Margin="0,6,0,0" />
                <StackPanel x:Name="SteamCmdPanel">
                <TextBlock Text="SteamCMD" FontWeight="Bold" Margin="0,10,0,4" />
                <TextBlock x:Name="SteamStatusText" TextWrapping="Wrap" />
                <WrapPanel Margin="0,6,0,0">
                    <Button x:Name="DownloadButton" Content="SteamCMD herunterladen" Padding="8,2" Margin="0,0,6,4" Click="Download_Click">
                        <Button.ToolTip>
                            <ToolTip MaxWidth="380">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Lädt SteamCMD (ca. 3 MB) direkt von Valve herunter und legt es in den Programmordner. SteamCMD ist Valves Kommandozeilen-Werkzeug zum Hochladen von Workshop-Inhalten. Das Programm braucht es nur zum Veröffentlichen und startet es sonst nie. Dein Passwort gibst du selbst in SteamCMDs eigenem Fenster ein, das Programm sieht es nicht." />
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="PickButton" Content="Vorhandene wählen" Padding="8,2" Margin="0,0,6,4" Click="Pick_Click"
                            ToolTip="Eine schon installierte steamcmd.exe verwenden" />
                </WrapPanel>
                <DockPanel Margin="0,4,0,0">
                    <Button x:Name="LoginButton" DockPanel.Dock="Right" Content="Steam-Anmeldung einrichten" Padding="8,2" Margin="8,0,0,0" Click="Login_Click"
                            ToolTip="Öffnet SteamCMD in einem eigenen Fenster. Dort gibst du Passwort und Steam-Guard-Code selbst ein; das Programm sieht sie nicht." />
                    <TextBlock Text="Steam-Benutzername:" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBox x:Name="UserBox" Width="200" HorizontalAlignment="Left" TextChanged="UserBox_TextChanged" LostFocus="UserBox_LostFocus"
                             ToolTip="Der Kontoname, mit dem du dich bei Steam anmeldest (nicht die E-Mail-Adresse). Ist das Feld leer, wird das zuletzt bei Steam angemeldete Konto vorgeschlagen." />
                </DockPanel>
                </StackPanel>

                <TextBlock Text="Changenote" FontWeight="Bold" Margin="0,14,0,4" />
                <CheckBox x:Name="BbCodeCheck" Content="In Steam-BBCode umwandeln" IsChecked="True" Checked="BbCodeCheck_Changed" Unchecked="BbCodeCheck_Changed"
                          ToolTip="Wandelt Aufzählungen (- Text) und Unterbanner in Steam-Formatierung um" />
                <TextBox x:Name="NoteBox" Height="130" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="NoteBox_TextChanged"
                         ToolTip="Vorbelegt aus dem Changelog. Änderungen hier gelten nur für diesen Upload und schreiben nicht in den Changelog." />
                <TextBlock x:Name="NoteCountText" Margin="0,2,0,0" Foreground="{DynamicResource Theme.TextMuted}" />

                <TextBlock Text="Upload" FontWeight="Bold" Margin="0,14,0,4" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Sichtbarkeit:" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <ComboBox x:Name="VisibilityBox" Width="140" SelectionChanged="VisibilityBox_SelectionChanged">
                        <ComboBoxItem Content="Unverändert" />
                        <ComboBoxItem Content="Öffentlich" />
                        <ComboBoxItem Content="Nur Freunde" />
                        <ComboBoxItem Content="Nur ich" />
                    </ComboBox>
                </StackPanel>
                <CheckBox x:Name="ListingCheck" Margin="0,6,0,0" Content="Titel, Beschreibung und Vorschaubild auch aktualisieren"
                          ToolTip="Überschreibt Titel (name), Beschreibung (short_description) und Vorschaubild (picture) der Workshop-Seite mit den Werten aus der metadata.json. Beim ersten Veröffentlichen immer an." />
                <DockPanel Margin="0,6,0,0">
                    <Button x:Name="ScopeListButton" DockPanel.Dock="Right" Content="Liste" Padding="8,2" Margin="8,0,0,0" Click="ScopeList_Click"
                            ToolTip="Zeigt, was aus dem Upload ausgeschlossen wird" />
                    <TextBlock x:Name="ScopeText" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" />
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="PublishButton" Content="Veröffentlichen" Padding="14,4" Click="Publish_Click" />
                    <Button x:Name="CancelButton" Content="Abbrechen" Padding="14,4" Margin="8,0,0,0" Visibility="Collapsed" Click="Cancel_Click" />
                    <ProgressBar x:Name="UploadProgress" Width="160" Height="14" Margin="12,0,0,0" IsIndeterminate="True" Visibility="Collapsed" />
                </StackPanel>

                <Expander x:Name="OutputExpander" Header="Ausgabe" Margin="0,10,0,0">
                    <TextBox x:Name="OutputBox" Height="200" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
