<Window x:Class="ParadoxModTool.App.PublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParadoxModTool.App"
        xmlns:loc="clr-namespace:ParadoxModTool.Localization;assembly=ParadoxModTool.Localization"
        Title="{x:Static local:PublishTexts.SteamTitle}" Height="860" Width="820" MinHeight="600" MinWidth="700"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!--
        Ein Ablauf: metadata.json (Version) prüfen und speichern, Changenote aus dem Changelog kontrollieren, SteamCMD einrichten, hochladen.
        Der Upload läuft über SteamCMD ohne Fenster und ohne Eingabe; das Programm sieht nie ein Passwort. Hochgeladen wird eine Kopie des Mod-Ordners ohne Versionsäste,
        Snapshots, Versionsverwaltung und Archive.
    -->
    <DockPanel Margin="12">
        <TextBlock x:Name="ResultText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="15" />
                <TextBlock x:Name="AppIdText" Margin="0,2,0,0" Foreground="{DynamicResource Theme.TextMuted}" />
                <DockPanel Margin="0,8,0,0">
                    <Button x:Name="OpenPageButton" DockPanel.Dock="Right" Content="{x:Static local:PublishTexts.OpenPage}" Padding="8,2" Margin="8,0,0,0" Click="OpenPage_Click" />
                    <Button x:Name="FindIdButton" DockPanel.Dock="Right" Content="{x:Static local:PublishTexts.FindId}" Padding="8,2" Margin="8,0,0,0" Click="FindId_Click">
                        <Button.ToolTip>
                            <ToolTip MaxWidth="380">
                                <TextBlock TextWrapping="Wrap"
                                           Text="{x:Static local:PublishTexts.FindIdTip}" />
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <TextBlock Text="{x:Static local:PublishTexts.WorkshopIdLabel}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBox x:Name="WorkshopIdBox" Width="170" HorizontalAlignment="Left" TextChanged="WorkshopIdBox_TextChanged"
                             ToolTip="{x:Static local:PublishTexts.WorkshopIdTip}" />
                </DockPanel>

                <TextBlock Text="metadata.json" FontWeight="Bold" Margin="0,14,0,4" />
                <DockPanel>
                    <Button x:Name="NewBannerButton" DockPanel.Dock="Right" Content="{x:Static local:PublishTexts.NewBanner}" Padding="8,2" Margin="8,0,0,0" Visibility="Collapsed" Click="NewBanner_Click"
                            ToolTip="{x:Static local:PublishTexts.NewBannerTip}" />
                    <TextBlock Text="Version:" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBox x:Name="VersionBox" Width="110" HorizontalAlignment="Left" LostFocus="VersionBox_Commit" KeyDown="VersionBox_KeyDown"
                             ToolTip="{x:Static local:PublishTexts.VersionTip}" />
                    <Button x:Name="NextVersionButton" Content="+1" Padding="8,2" Margin="6,0,0,0" HorizontalAlignment="Left" Click="NextVersion_Click"
                            ToolTip="{x:Static local:PublishTexts.NextVersionTip}" />
                </DockPanel>
                <TextBox x:Name="MetaBox" Height="170" Margin="0,6,0,0" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="Consolas"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         TextChanged="MetaBox_TextChanged" PreviewKeyDown="MetaBox_PreviewKeyDown" />
                <WrapPanel Margin="0,6,0,0">
                    <Button x:Name="MetaSaveButton" Content="{x:Static local:PublishTexts.SaveChange}" Padding="8,2" Margin="0,0,6,4" Click="MetaSave_Click"
                            ToolTip="{x:Static local:PublishTexts.MetaSaveTip}" />
                    <Button x:Name="MetaRevertButton" Content="{x:Static local:PublishTexts.Revert}" Padding="8,2" Margin="0,0,0,4" Click="MetaRevert_Click" />
                </WrapPanel>
                <TextBlock x:Name="MetaErrorText" Foreground="{DynamicResource Theme.Danger}" TextWrapping="Wrap" />

                <TextBlock Text="{x:Static local:PublishTexts.Checks}" FontWeight="Bold" Margin="0,14,0,4" />
                <ItemsControl x:Name="HintList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{x:Static local:PublishTexts.UploadVia}" FontWeight="Bold" Margin="0,14,0,4" />
                <ComboBox x:Name="MethodBox" Width="260" HorizontalAlignment="Left" SelectionChanged="MethodBox_SelectionChanged">
                    <ComboBoxItem Content="{x:Static local:PublishTexts.MethodClient}"
                                  ToolTip="{x:Static local:PublishTexts.MethodClientTip}" />
                    <ComboBoxItem Content="SteamCMD"
                                  ToolTip="{x:Static local:PublishTexts.MethodSteamCmdTip}" />
                </ComboBox>
                <TextBlock x:Name="ClientStatusText" TextWrapping="Wrap" Margin="0,6,0,0" />
                <StackPanel x:Name="SteamCmdPanel">
                <TextBlock Text="SteamCMD" FontWeight="Bold" Margin="0,10,0,4" />
                <TextBlock x:Name="SteamStatusText" TextWrapping="Wrap" />
                <WrapPanel Margin="0,6,0,0">
                    <Button x:Name="DownloadButton" Content="{x:Static local:PublishTexts.SteamCmdDownload}" Padding="8,2" Margin="0,0,6,4" Click="Download_Click">
                        <Button.ToolTip>
                            <ToolTip MaxWidth="380">
                                <TextBlock TextWrapping="Wrap"
                                           Text="{x:Static local:PublishTexts.SteamCmdDownloadTip}" />
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="PickButton" Content="{x:Static local:PublishTexts.PickExisting}" Padding="8,2" Margin="0,0,6,4" Click="Pick_Click"
                            ToolTip="{x:Static local:PublishTexts.PickExistingTip}" />
                </WrapPanel>
                <DockPanel Margin="0,4,0,0">
                    <Button x:Name="LoginButton" DockPanel.Dock="Right" Content="{x:Static local:PublishTexts.SteamLogin}" Padding="8,2" Margin="8,0,0,0" Click="Login_Click"
                            ToolTip="{x:Static local:PublishTexts.SteamLoginTip}" />
                    <TextBlock Text="{x:Static local:PublishTexts.UserLabel}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBox x:Name="UserBox" Width="200" HorizontalAlignment="Left" TextChanged="UserBox_TextChanged" LostFocus="UserBox_LostFocus"
                             ToolTip="{x:Static local:PublishTexts.UserTip}" />
                </DockPanel>
                </StackPanel>

                <TextBlock Text="{x:Static local:PublishTexts.ChangeNote}" FontWeight="Bold" Margin="0,14,0,4" />
                <CheckBox x:Name="BbCodeCheck" Content="{x:Static local:PublishTexts.BbCode}" IsChecked="True" Checked="BbCodeCheck_Changed" Unchecked="BbCodeCheck_Changed"
                          ToolTip="{x:Static local:PublishTexts.BbCodeTip}" />
                <TextBox x:Name="NoteBox" Height="130" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="NoteBox_TextChanged"
                         ToolTip="{x:Static local:PublishTexts.NoteTip}" />
                <TextBlock x:Name="NoteCountText" Margin="0,2,0,0" Foreground="{DynamicResource Theme.TextMuted}" />

                <TextBlock Text="Upload" FontWeight="Bold" Margin="0,14,0,4" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static local:PublishTexts.VisibilityLabel}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <ComboBox x:Name="VisibilityBox" Width="140" SelectionChanged="VisibilityBox_SelectionChanged">
                        <ComboBoxItem Content="{x:Static local:PublishTexts.VisibilityUnchanged}" />
                        <ComboBoxItem Content="{x:Static local:PublishTexts.VisibilityPublic}" />
                        <ComboBoxItem Content="{x:Static local:PublishTexts.VisibilityFriends}" />
                        <ComboBoxItem Content="{x:Static local:PublishTexts.VisibilityPrivate}" />
                    </ComboBox>
                </StackPanel>
                <CheckBox x:Name="ListingCheck" Margin="0,6,0,0" Content="{x:Static local:PublishTexts.Listing}"
                          ToolTip="{x:Static local:PublishTexts.ListingTip}" />
                <DockPanel Margin="0,6,0,0">
                    <Button x:Name="ScopeListButton" DockPanel.Dock="Right" Content="{x:Static local:PublishTexts.List}" Padding="8,2" Margin="8,0,0,0" Click="ScopeList_Click"
                            ToolTip="{x:Static local:PublishTexts.ScopeListTip}" />
                    <TextBlock x:Name="ScopeText" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" />
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="PublishButton" Content="{x:Static local:PublishTexts.Publish}" Padding="14,4" Click="Publish_Click" />
                    <Button x:Name="CancelButton" Content="{x:Static loc:CommonTexts.Cancel}" Padding="14,4" Margin="8,0,0,0" Visibility="Collapsed" Click="Cancel_Click" />
                    <ProgressBar x:Name="UploadProgress" Width="160" Height="14" Margin="12,0,0,0" IsIndeterminate="True" Visibility="Collapsed" />
                </StackPanel>

                <Expander x:Name="OutputExpander" Header="{x:Static local:PublishTexts.Output}" Margin="0,10,0,0">
                    <TextBox x:Name="OutputBox" Height="200" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
