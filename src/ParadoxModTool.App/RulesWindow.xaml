<Window x:Class="ParadoxModTool.App.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParadoxModTool.App"
        xmlns:loc="clr-namespace:ParadoxModTool.Localization;assembly=ParadoxModTool.Localization"
        Title="{x:Static local:TemplateWindowTexts.RulesTitle}" Height="580" Width="1140" MinHeight="400" MinWidth="900"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!--
        Alle Zählregeln in ihrer Rangfolge (die oberste Zeile gewinnt): Vorlage, Mod, Spiel, Alle Spiele, mitgeliefert. Der Haken schaltet eine Regel ein oder aus;
        bei Regeln einer weniger spezifischen Ebene wirkt er nur auf der oben gewählten Ebene. "Treffer im Snippet" zeigt, über wie viele Zahlen im aktuellen
        Snippet die Regel entscheidet.
    -->
    <DockPanel Margin="10">
        <TextBlock x:Name="InfoText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" />

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{x:Static local:TemplateWindowTexts.ChangesOnLayer}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="LayerBox" Width="220" Margin="0,0,16,0"
                      ToolTip="{x:Static local:TemplateWindowTexts.ChangesOnLayerTip}" />
            <Button Content="{x:Static local:TemplateWindowTexts.NewRuleButton}" Padding="10,2" Margin="0,0,6,4" Click="New_Click" ToolTip="{x:Static local:TemplateWindowTexts.NewRuleTip}" />
            <Button x:Name="EditButton" Content="{x:Static local:TemplateWindowTexts.EditRuleButton}" Padding="10,2" Margin="0,0,6,4" Click="Edit_Click" />
            <Button x:Name="CopyButton" Content="{x:Static local:TemplateWindowTexts.CopyRuleButton}" Padding="10,2" Margin="0,0,6,4" Click="Copy_Click"
                    ToolTip="{x:Static local:TemplateWindowTexts.CopyRuleTip}" />
            <Button x:Name="MoveButton" Content="{x:Static local:TemplateWindowTexts.MoveRuleButton}" Padding="10,2" Margin="0,0,6,4" Click="Move_Click" ToolTip="{x:Static local:TemplateWindowTexts.MoveRuleTip}" />
            <Button x:Name="DeleteButton" Content="{x:Static loc:CommonTexts.Delete}" Padding="10,2" Margin="0,0,6,4" Click="Delete_Click" />
            <Button x:Name="UpButton" Content="{x:Static local:TemplateWindowTexts.MoveUp}" Padding="10,2" Margin="0,0,6,4" Click="Up_Click" ToolTip="{x:Static local:TemplateWindowTexts.MoveUpTip}" />
            <Button x:Name="DownButton" Content="{x:Static local:TemplateWindowTexts.MoveDown}" Padding="10,2" Margin="0,0,16,4" Click="Down_Click" />
            <Button Content="{x:Static local:TemplateWindowTexts.Guide}" Padding="10,2" Margin="0,0,0,4" Click="Help_Click" ToolTip="{x:Static local:TemplateWindowTexts.GuideTip}" />
        </WrapPanel>

        <Grid DockPanel.Dock="Top" Margin="10,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="{x:Static local:TemplateWindowTexts.ColumnLayer}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="{x:Static local:TemplateWindowTexts.ColumnWhere}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Text="{x:Static local:TemplateWindowTexts.ColumnPatterns}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="5" Text="{x:Static local:TemplateWindowTexts.ColumnAction}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="6" Text="{x:Static local:TemplateWindowTexts.ColumnGames}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="7" Text="{x:Static local:TemplateWindowTexts.ColumnHits}" FontWeight="SemiBold" ToolTip="{x:Static local:TemplateWindowTexts.ColumnHitsTip}" />
        </Grid>

        <ListBox x:Name="RuleList" HorizontalContentAlignment="Stretch" SelectionChanged="RuleList_SelectionChanged" MouseDoubleClick="RuleList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Opacity="{Binding Opacity}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsActive, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="{x:Static local:TemplateWindowTexts.ToggleRuleTip}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontStyle="{Binding NameStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <TextBlock Grid.Column="2" Text="{Binding LayerText}" FontStyle="{Binding NameStyle}" />
                        <TextBlock Grid.Column="3" Text="{Binding WhereText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" Text="{Binding PatternsText}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTip="{Binding PatternsFull}" />
                        <TextBlock Grid.Column="5" Text="{Binding ActionText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="6" Text="{Binding GamesText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="7" Text="{Binding HitsText}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
