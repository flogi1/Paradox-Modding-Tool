<Window x:Class="ParadoxModTool.App.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zählregeln" Height="580" Width="1140" MinHeight="400" MinWidth="900"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!--
        Alle Zählregeln in ihrer Rangfolge (die oberste Zeile gewinnt): Vorlage, Mod, Spiel, Alle Spiele, mitgeliefert. Der Haken schaltet eine Regel ein oder aus;
        bei Regeln einer weniger spezifischen Ebene wirkt er nur auf der oben gewählten Ebene. "Treffer im Snippet" zeigt, über wie viele Zahlen im aktuellen
        Snippet die Regel entscheidet.
    -->
    <DockPanel Margin="10">
        <TextBlock x:Name="InfoText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" />

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Änderungen auf Ebene:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="LayerBox" Width="220" Margin="0,0,16,0"
                      ToolTip="Auf dieser Ebene entstehen neue Regeln, und hier wird eine geerbte Regel abgeschaltet: Vorlage (nur diese Vorlage), Mod (alle Vorlagen der Mod), Spiel, Alle Spiele." />
            <Button Content="Neu" Padding="10,2" Margin="0,0,6,4" Click="New_Click" ToolTip="Eine neue Regel anlegen" />
            <Button x:Name="EditButton" Content="Bearbeiten" Padding="10,2" Margin="0,0,6,4" Click="Edit_Click" />
            <Button x:Name="CopyButton" Content="Kopie erstellen ▾" Padding="10,2" Margin="0,0,6,4" Click="Copy_Click"
                    ToolTip="Legt eine Kopie der gewählten Regel auf einer Ebene deiner Wahl an. Bei einer mitgelieferten Regel wird das Original dort abgeschaltet." />
            <Button x:Name="MoveButton" Content="Verschieben ▾" Padding="10,2" Margin="0,0,6,4" Click="Move_Click" ToolTip="Verschiebt die gewählte Regel auf eine andere Ebene" />
            <Button x:Name="DeleteButton" Content="Löschen" Padding="10,2" Margin="0,0,6,4" Click="Delete_Click" />
            <Button x:Name="UpButton" Content="Nach oben" Padding="10,2" Margin="0,0,6,4" Click="Up_Click" ToolTip="Die Regel innerhalb ihrer Ebene früher prüfen" />
            <Button x:Name="DownButton" Content="Nach unten" Padding="10,2" Margin="0,0,16,4" Click="Down_Click" />
            <Button Content="Anleitung" Padding="10,2" Margin="0,0,0,4" Click="Help_Click" ToolTip="Öffnet die Anleitung mit Beispielen" />
        </WrapPanel>

        <Grid DockPanel.Dock="Top" Margin="10,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Ebene" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="Wo" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Text="Muster" FontWeight="SemiBold" />
            <TextBlock Grid.Column="5" Text="Aktion" FontWeight="SemiBold" />
            <TextBlock Grid.Column="6" Text="Spiele" FontWeight="SemiBold" />
            <TextBlock Grid.Column="7" Text="Treffer" FontWeight="SemiBold" ToolTip="Über wie viele Zahlen im aktuellen Snippet diese Regel entscheidet" />
        </Grid>

        <ListBox x:Name="RuleList" HorizontalContentAlignment="Stretch" SelectionChanged="RuleList_SelectionChanged" MouseDoubleClick="RuleList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Opacity="{Binding Opacity}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsActive, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Regel einschalten oder ausschalten" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontStyle="{Binding NameStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <TextBlock Grid.Column="2" Text="{Binding LayerText}" FontStyle="{Binding NameStyle}" />
                        <TextBlock Grid.Column="3" Text="{Binding WhereText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" Text="{Binding PatternsText}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTip="{Binding PatternsFull}" />
                        <TextBlock Grid.Column="5" Text="{Binding ActionText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="6" Text="{Binding GamesText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="7" Text="{Binding HitsText}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
