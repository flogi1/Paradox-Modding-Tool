<Window x:Class="ParadoxModTool.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paradox Modding Tool" Width="580" Height="230"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True" Background="#1B2542">
    <!-- Startbild (Nutzerwunsch "professioneller Look"): rahmenlos, dunkelblau/gold passend zum Programm-Icon. -->
    <Border BorderBrush="#DEB254" BorderThickness="2" Padding="22">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/app-icon.png" Width="112" Height="112" VerticalAlignment="Top" Margin="0,0,20,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Paradox Modding Tool" FontFamily="Georgia" FontSize="26" FontWeight="Bold" Foreground="#F2D58F" />
                <TextBlock x:Name="VersionText" FontSize="13" Foreground="#B8C2DC" Margin="0,2,0,22" />
                <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1" Foreground="#DEB254" Background="#2C3A63" BorderThickness="0" />
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="#B8C2DC" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
