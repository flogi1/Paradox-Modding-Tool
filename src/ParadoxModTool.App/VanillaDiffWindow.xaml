<Window x:Class="ParadoxModTool.App.VanillaDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParadoxModTool.App"
        Title="{x:Static local:MiscWindowTexts.DiffTitle}" Height="760" Width="1250"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <!-- Compare und Update Tool (Nutzerwunsch 2026-09-30): zwei Reiter mit je einem eigenen Vergleich (DiffComparePane). -->
    <TabControl x:Name="Tabs" Margin="6" SelectionChanged="Tabs_SelectionChanged">
        <TabItem x:Name="CompareTab" Header="{x:Static local:MiscWindowTexts.DiffTabCompare}">
            <DockPanel Margin="6">
                <!-- Dieselben Schnellzugriff-Knöpfe wie in "Suchen in Dateien": Klick öffnet die Dateiauswahl in diesem Ordner. -->
                <local:QuickPathBar x:Name="CompareQuickPaths" DockPanel.Dock="Top" Margin="0,0,0,6" />
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- A und B nehmen Dateien oder Ordner; zwei Ordner vergleicht "Vergleichen" wie WinMerge (Dateiliste links). -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static local:MiscWindowTexts.DiffFileA}" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <TextBox x:Name="FileABox" Grid.Row="0" Grid.Column="1" Margin="0,0,6,4" VerticalContentAlignment="Center" KeyDown="FileBox_KeyDown"
                             ToolTip="{x:Static local:MiscWindowTexts.DiffPathFieldTip}" />
                    <Button Grid.Row="0" Grid.Column="2" Margin="0,0,6,4" Padding="8,0" Tag="A" Click="BrowseFile_Click">
                        <TextBlock Text="{x:Static local:MiscWindowTexts.DiffCompareBrowse}" />
                    </Button>
                    <Button Grid.Row="0" Grid.Column="3" Margin="0,0,6,4" Padding="8,0" Tag="A" Click="BrowseFolder_Click">
                        <TextBlock Text="{x:Static local:MiscWindowTexts.DiffBrowseFolder}" />
                    </Button>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static local:MiscWindowTexts.DiffFileB}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="FileBBox" Grid.Row="1" Grid.Column="1" Margin="0,0,6,0" VerticalContentAlignment="Center" KeyDown="FileBox_KeyDown"
                             ToolTip="{x:Static local:MiscWindowTexts.DiffPathFieldTip}" />
                    <Button Grid.Row="1" Grid.Column="2" Margin="0,0,6,0" Padding="8,0" Tag="B" Click="BrowseFile_Click">
                        <TextBlock Text="{x:Static local:MiscWindowTexts.DiffCompareBrowse}" />
                    </Button>
                    <Button Grid.Row="1" Grid.Column="3" Margin="0,0,6,0" Padding="8,0" Tag="B" Click="BrowseFolder_Click">
                        <TextBlock Text="{x:Static local:MiscWindowTexts.DiffBrowseFolder}" />
                    </Button>
                    <Button x:Name="CompareButton" Grid.Row="1" Grid.Column="4" Padding="12,0" FontWeight="SemiBold" Click="CompareButton_Click">
                        <TextBlock Text="{x:Static local:MiscWindowTexts.DiffCompareButton}" />
                    </Button>
                </Grid>
                <TextBlock x:Name="CompareStatusText" DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="{DynamicResource Theme.TextMuted}" TextTrimming="CharacterEllipsis" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FolderListColumn" Width="0" />
                        <ColumnDefinition x:Name="FolderSplitterColumn" Width="0" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Ordnervergleich: alle Dateien beider Ordner mit Status; nur sichtbar, wenn zwei Ordner verglichen werden. -->
                    <DockPanel x:Name="FolderListPanel" Grid.Column="0" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="🔍" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="FolderFilterBox" VerticalContentAlignment="Center" TextChanged="FolderFilter_Changed"
                                     ToolTip="{x:Static local:MiscWindowTexts.DiffFilterTip}" />
                        </DockPanel>
                        <CheckBox x:Name="HideSameCheckBox" DockPanel.Dock="Top" Margin="0,0,0,4" IsChecked="True"
                                  Checked="FolderFilter_Changed" Unchecked="FolderFilter_Changed">
                            <TextBlock Text="{x:Static local:MiscWindowTexts.DiffHideSame}" />
                        </CheckBox>
                        <ContentControl x:Name="FolderKindsHost" DockPanel.Dock="Top" Margin="0,0,0,4" />
                        <TextBlock x:Name="FolderCountText" DockPanel.Dock="Top" Margin="0,0,0,4" FontSize="11" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                        <ListBox x:Name="FolderFilesList" SelectionChanged="FolderFilesList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding StatusText}">
                                        <TextBlock Text="{Binding Marker}" Foreground="{Binding MarkerBrush}" FontWeight="Bold" Width="16" />
                                        <TextBlock Text="{Binding Entry.RelativePath}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <GridSplitter x:Name="FolderSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                    <local:DiffComparePane x:Name="ComparePane" Grid.Column="2" />
                </Grid>

            </DockPanel>
        </TabItem>

        <TabItem x:Name="UpdateTab" Header="{x:Static local:MiscWindowTexts.DiffTabUpdate}">
            <DockPanel Margin="6">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button x:Name="MergeButton" DockPanel.Dock="Right" Padding="10,0" FontWeight="SemiBold" IsEnabled="False" Click="MergeButton_Click">
                        <TextBlock Text="{x:Static local:MiscWindowTexts.DiffMergeAfterUpdate}" />
                    </Button>
                    <Button x:Name="ReadVersionButton" DockPanel.Dock="Right" Padding="10,0" Margin="0,0,6,0" Click="ReadVersionButton_Click"
                            ToolTip="{x:Static local:VanillaUpdateTexts.ReadVersionTip}">
                        <TextBlock Text="{x:Static local:VanillaUpdateTexts.ReadVersionButton}" />
                    </Button>
                    <TextBox x:Name="ManualVersionTextBox" DockPanel.Dock="Right" Width="80" VerticalContentAlignment="Center"
                             ToolTip="{x:Static local:MiscWindowTexts.DiffVersionTip}"
                             LostFocus="ManualVersionTextBox_Commit" KeyDown="ManualVersionTextBox_KeyDown" />
                    <TextBlock DockPanel.Dock="Right" Text="{x:Static local:MiscWindowTexts.DiffGameVersionLabel}" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <TextBlock Text="{x:Static local:MiscWindowTexts.DiffModFolderLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button x:Name="ModRootButton" DockPanel.Dock="Right" Padding="8,0" Margin="6,0,0,0" Click="ModRootButton_Click"
                            ToolTip="{x:Static local:MiscWindowTexts.DiffChooseModFolderTip}">
                        <TextBlock Text="{x:Static local:MiscWindowTexts.DiffChooseModFolderShort}" />
                    </Button>
                    <TextBlock x:Name="ModRootStatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock x:Name="UpdateStatusText" DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="{DynamicResource Theme.TextMuted}" TextTrimming="CharacterEllipsis" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" MinWidth="140" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="🔍" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="FileFilterBox" VerticalContentAlignment="Center" TextChanged="FileFilterBox_TextChanged"
                                     ToolTip="{x:Static local:MiscWindowTexts.DiffFilterTip}" />
                        </DockPanel>
                        <ContentControl x:Name="UpdateKindsHost" DockPanel.Dock="Top" Margin="0,0,0,4" />
                        <TextBlock x:Name="FileCountText" DockPanel.Dock="Top" Margin="0,0,0,4" FontSize="11" Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap" />
                        <ListBox x:Name="OverriddenFilesList" DisplayMemberPath="RelativePath" SelectionChanged="OverriddenFilesList_SelectionChanged"
                                 ToolTip="{x:Static local:MiscWindowTexts.DiffPairsTip}" />
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />
                    <local:DiffComparePane x:Name="UpdatePane" Grid.Column="2" />
                </Grid>
            </DockPanel>
        </TabItem>

        <TabItem x:Name="ReplaceTab" Header="{x:Static local:ReplaceListTexts.TabHeader}">
            <local:ReplaceListTab x:Name="ReplaceListPane" />
        </TabItem>
    </TabControl>
</Window>
