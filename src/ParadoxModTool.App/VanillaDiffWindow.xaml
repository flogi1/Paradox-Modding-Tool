<Window x:Class="ParadoxModTool.App.VanillaDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:ParadoxModTool.App"
        Title="Vanilla-Diff &amp; Merge" Height="700" Width="1200"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="6,6,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="ModRootButton" Grid.Column="0" Content="Mod-Ordner wählen" Margin="0,0,6,0" Click="ModRootButton_Click"
                    ToolTip="Ordner EINER konkreten Mod wählen (der Ordner mit common/gui/... direkt drin) - der Sammelordner aus dem Spielprofil reicht nicht, da jede Mod normalerweise in einem eigenen Unterordner liegt." />
            <TextBlock x:Name="ModRootStatusText" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextMuted}" TextTrimming="CharacterEllipsis" />
            <Button x:Name="SearchButton" Grid.Column="2" Content="Suchen &amp; Ersetzen" Margin="6,0,0,0" Padding="8,0" Click="SearchButton_Click"
                    ToolTip="Suchen &amp; Ersetzen (Strg+F / Strg+H) - Suchen in beiden Seiten, Ersetzen nur rechts (Mod bzw. Datei B)" />
            <TextBlock x:Name="DirtyIndicator" Grid.Column="4" Text="●" Foreground="{DynamicResource Theme.Warning}" FontSize="14"
                       VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed"
                       ToolTip="Ungespeicherte Änderungen in der rechten Datei" />
            <Button x:Name="SaveButton" Grid.Column="3" Content="Speichern" Margin="6,0,0,0" Padding="8,0" IsEnabled="False" Click="SaveButton_Click"
                    ToolTip="Rechte Datei (Mod bzw. Datei B) speichern (Strg+S) - vor dem ersten Speichern pro Datei wird ein Snapshot des Mods angelegt" />
        </Grid>

        <Grid DockPanel.Dock="Top" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="OverriddenFilesCombo" Grid.Column="0" Margin="0,0,6,0"
                      DisplayMemberPath="RelativePath" SelectionChanged="OverriddenFilesCombo_SelectionChanged"
                      ToolTip="Automatisch erkannte Vanilla/Mod-Dateipaare des gewählten Mod-Ordners" />
            <Button x:Name="ManualLeftButton" Grid.Column="1" Content="Datei A wählen" Margin="0,0,6,0" Click="ManualLeftButton_Click" />
            <Button x:Name="ManualRightButton" Grid.Column="2" Content="Datei B wählen" Margin="0,0,6,0" Click="ManualRightButton_Click" />
            <Button x:Name="MergeButton" Grid.Column="3" Content="Merge nach Spiel-Update" IsEnabled="False" Click="MergeButton_Click" />
            <TextBox x:Name="ManualVersionTextBox" Grid.Column="4" Width="80" Margin="0,0,6,0" VerticalContentAlignment="Center"
                     ToolTip="Spielversion manuell eingeben, falls automatisch nicht erkennbar (launcher-settings.json nicht gefunden). Wird mit Enter oder beim Verlassen des Feldes übernommen."
                     LostFocus="ManualVersionTextBox_Commit" KeyDown="ManualVersionTextBox_KeyDown" />
            <CheckBox x:Name="PreferModFormattingCheckBox" Grid.Column="5" Content="Mod-Formatierung beibehalten"
                      VerticalAlignment="Center" Margin="6,0,0,0" Checked="PreferModFormattingCheckBox_Changed"
                      Unchecked="PreferModFormattingCheckBox_Changed" IsEnabled="False"
                      ToolTip="Standard: aus (Vanilla-Formatierung). Nur einschalten, wenn diese Mod-Datei bewusst stark von Vanilla abweicht." />
            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <CheckBox x:Name="FoldingCheckBox" Content="Blöcke einklappbar"
                          Checked="FoldingCheckBox_Changed" Unchecked="FoldingCheckBox_Changed"
                          ToolTip="Eingeklappte Blöcke verschieben die Ausrichtung der beiden Seiten. Für eine durchgehend ausgerichtete Ansicht das Einklappen ausschalten." />
                <TextBlock Text="Einklappen verschiebt die Ausrichtung" Margin="6,0,0,0" FontSize="11"
                           Foreground="{DynamicResource Theme.TextMuted}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Margin="6,0,6,6" Foreground="{DynamicResource Theme.TextMuted}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Pfad der jeweils geöffneten Datei über den Editoren (Nutzer-Feedback: deutlich machen, woher die
                 Dateien kommen). Bei Platzmangel wird der Pfad gekürzt (Tooltip zeigt ihn vollständig); dahinter
                 ein Button zum Öffnen des Ordners im Windows-Explorer (Datei markiert) und einer zum Kopieren.
                 Die Schriftfarbe entspricht dem Rahmen der jeweiligen Seite. -->
            <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,2">
                <Button DockPanel.Dock="Right" x:Name="CopyLeftPathButton" Content="📋" Padding="4,0" Margin="4,0,0,0" FontSize="11"
                        Click="CopyPath_Click" Tag="Left" ToolTip="Pfad kopieren" />
                <Button DockPanel.Dock="Right" x:Name="OpenLeftFolderButton" Content="📂" Padding="4,0" Margin="4,0,0,0" FontSize="11"
                        Click="OpenFolder_Click" Tag="Left" ToolTip="Ordner der Datei im Windows-Explorer öffnen" />
                <TextBlock x:Name="LeftPathText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <DockPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,2">
                <Button DockPanel.Dock="Right" x:Name="CopyRightPathButton" Content="📋" Padding="4,0" Margin="4,0,0,0" FontSize="11"
                        Click="CopyPath_Click" Tag="Right" ToolTip="Pfad kopieren" />
                <Button DockPanel.Dock="Right" x:Name="OpenRightFolderButton" Content="📂" Padding="4,0" Margin="4,0,0,0" FontSize="11"
                        Click="OpenFolder_Click" Tag="Right" ToolTip="Ordner der Datei im Windows-Explorer öffnen" />
                <TextBlock x:Name="RightPathText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <Border x:Name="LeftBorder" Grid.Row="1" Grid.Column="0" BorderThickness="2" BorderBrush="Transparent">
                <avalonEdit:TextEditor x:Name="LeftEditor" FontFamily="Consolas" FontSize="13"
                                        Background="{DynamicResource Theme.EditorBackground}"
                                        Foreground="{DynamicResource Theme.EditorForeground}"
                                        LineNumbersForeground="{DynamicResource Theme.LineNumbers}"
                                        IsReadOnly="True" ShowLineNumbers="True" WordWrap="False" />
            </Border>
            <local:DiffOverviewBar x:Name="LeftOverview" Grid.Row="1" Grid.Column="1" Margin="2,0" />
            <Border x:Name="RightBorder" Grid.Row="1" Grid.Column="2" BorderThickness="2" BorderBrush="Transparent">
                <avalonEdit:TextEditor x:Name="RightEditor" FontFamily="Consolas" FontSize="13"
                                        Background="{DynamicResource Theme.EditorBackground}"
                                        Foreground="{DynamicResource Theme.EditorForeground}"
                                        LineNumbersForeground="{DynamicResource Theme.LineNumbers}"
                                        ShowLineNumbers="True" WordWrap="False" />
            </Border>
            <local:DiffOverviewBar x:Name="RightOverview" Grid.Row="1" Grid.Column="3" Margin="2,0,0,0" />
        </Grid>
    </DockPanel>
</Window>
