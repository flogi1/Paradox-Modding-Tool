<Window x:Class="ParadoxModTool.App.GitHubPublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auf GitHub veröffentlichen" Height="880" Width="860" MinHeight="620" MinWidth="740"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!--
        Ein Ablauf für GitHub-Releases: Repositories wählen, Titel und Notes prüfen, ZIP-Varianten wählen, veröffentlichen. Zusätzlich die Reiter "Git" (committen, pushen) und
        "Aufräumen" (Releases, Tags, Branches löschen). Alles läuft über gh und git; das Programm sieht nie ein Token.
    -->
    <DockPanel Margin="12">
        <TextBlock x:Name="ResultText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" />

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="15" />
            <TextBlock x:Name="VersionText" Margin="0,2,0,0" Foreground="{DynamicResource Theme.TextMuted}" />
            <TextBlock x:Name="GhStatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
            <WrapPanel Margin="0,6,0,0">
                <Button x:Name="GhDownloadButton" Content="gh herunterladen" Padding="8,2" Margin="0,0,6,4" Click="GhDownload_Click">
                    <Button.ToolTip>
                        <ToolTip MaxWidth="380">
                            <TextBlock TextWrapping="Wrap"
                                       Text="gh ist das offizielle Kommandozeilen-Werkzeug von GitHub. Das Programm braucht es, um Releases anzulegen; es startet es nur dafür. Der Download kommt von github.com (ca. 15 MB), die Prüfsumme wird kontrolliert. Deine Anmeldung bei GitHub verwaltet gh selbst, das Programm sieht sie nie." />
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
                <Button x:Name="GhLoginButton" Content="Bei GitHub anmelden" Padding="8,2" Margin="0,0,6,4" Click="GhLogin_Click"
                        ToolTip="Öffnet gh in einem eigenen Fenster. Dort meldest du dich im Browser bei GitHub an; das Programm sieht nichts davon." />
                <Button x:Name="GhRefreshButton" Content="Status aktualisieren" Padding="8,2" Margin="0,0,6,4" Click="GhRefresh_Click"
                        ToolTip="Prüft erneut, ob gh vorhanden und angemeldet ist, und ob die Repositories erreichbar sind" />
            </WrapPanel>
        </StackPanel>

        <TabControl x:Name="Tabs" Margin="0,10,0,0">
            <TabItem Header="Veröffentlichen">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Repositories" FontWeight="Bold" />
                        <ListBox x:Name="RepoList" Height="92" Margin="0,4,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Content="{Binding Text}" Click="RepoCheck_Click" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Margin="0,4,0,0">
                            <Button x:Name="RepoAddButton" Content="Hinzufügen" Padding="8,2" Margin="0,0,6,4" Click="RepoAdd_Click" />
                            <Button x:Name="RepoEditButton" Content="Bearbeiten" Padding="8,2" Margin="0,0,6,4" Click="RepoEdit_Click" />
                            <Button x:Name="RepoRemoveButton" Content="Entfernen" Padding="8,2" Margin="0,0,6,4" Click="RepoRemove_Click" />
                            <Button x:Name="RepoOriginButton" Content="Repo aus origin übernehmen" Padding="8,2" Margin="0,0,6,4" Visibility="Collapsed" Click="RepoOrigin_Click"
                                    ToolTip="Der Mod-Ordner ist ein Git-Ordner mit einem GitHub-origin, der noch nicht in der Liste steht" />
                        </WrapPanel>

                        <TextBlock Text="Release" FontWeight="Bold" Margin="0,14,0,4" />
                        <DockPanel>
                            <TextBlock Text="Titel:" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBox x:Name="TitleBox" TextChanged="TitleBox_TextChanged" />
                        </DockPanel>
                        <TextBlock Text="Release-Notes (Markdown):" Margin="0,8,0,2" />
                        <TextBox x:Name="NotesBox" Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="NotesBox_TextChanged"
                                 ToolTip="Vorbelegt aus dem Changelog. Änderungen hier gelten nur für diesen Lauf und schreiben nicht in den Changelog." />
                        <TextBlock x:Name="NotesCountText" Margin="0,2,0,0" Foreground="{DynamicResource Theme.TextMuted}" />
                        <CheckBox x:Name="DraftCheck" Margin="0,8,0,0" Content="Als Entwurf anlegen" Click="ReleaseOption_Click"
                                  ToolTip="Ein Entwurf ist auf GitHub nur für Mitarbeiter mit Schreibrecht sichtbar, bis du ihn dort veröffentlichst" />
                        <CheckBox x:Name="PreReleaseCheck" Margin="0,4,0,0" Content="Als Vorabversion markieren" Click="ReleaseOption_Click" />
                        <CheckBox x:Name="UpdateCheck" Margin="0,4,0,0" Content="Vorhandenes Release aktualisieren, falls der Tag schon existiert" Click="ReleaseOption_Click"
                                  ToolTip="Ersetzt Titel, Notes und ZIP-Dateien eines schon vorhandenen Releases mit diesem Tag" />

                        <TextBlock Text="ZIP-Varianten" FontWeight="Bold" Margin="0,14,0,4" />
                        <ListBox x:Name="VariantList" Height="92" SelectionChanged="VariantList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Content="{Binding Text}" Click="VariantCheck_Click" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="VariantInfoText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" />
                        <WrapPanel Margin="0,4,0,0">
                            <Button x:Name="VariantAddButton" Content="Hinzufügen" Padding="8,2" Margin="0,0,6,4" Click="VariantAdd_Click" />
                            <Button x:Name="VariantEditButton" Content="Bearbeiten" Padding="8,2" Margin="0,0,6,4" Click="VariantEdit_Click" />
                            <Button x:Name="VariantRemoveButton" Content="Entfernen" Padding="8,2" Margin="0,0,6,4" Click="VariantRemove_Click" />
                            <Button x:Name="VariantListButton" Content="Liste" Padding="8,2" Margin="0,0,6,4" Click="VariantExcluded_Click"
                                    ToolTip="Zeigt, was bei der gewählten Variante ausgeschlossen wird" />
                            <Button x:Name="VariantBuildButton" Content="ZIP lokal erstellen" Padding="8,2" Margin="0,0,6,4" Click="VariantBuild_Click"
                                    ToolTip="Erstellt die angehakten ZIP-Dateien in einem Ordner deiner Wahl, ohne etwas zu veröffentlichen" />
                        </WrapPanel>
                        <!--ANCHOR:variants-->
                        <TextBlock Text="Prüfungen" FontWeight="Bold" Margin="0,14,0,4" />
                        <ItemsControl x:Name="HintList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="PublishButton" Content="Veröffentlichen" Padding="14,4" Click="Publish_Click" />
                            <Button x:Name="CancelButton" Content="Abbrechen" Padding="14,4" Margin="8,0,0,0" Visibility="Collapsed" Click="Cancel_Click" />
                            <ProgressBar x:Name="PublishProgress" Width="160" Height="14" Margin="12,0,0,0" IsIndeterminate="True" Visibility="Collapsed" />
                        </StackPanel>

                        <TextBlock Text="Ergebnis" FontWeight="Bold" Margin="0,12,0,4" />
                        <ListBox x:Name="ResultList" Height="72" DisplayMemberPath="Text" SelectionChanged="ResultList_SelectionChanged" MouseDoubleClick="ResultList_DoubleClick" />
                        <Button x:Name="OpenReleaseButton" Content="Release öffnen" HorizontalAlignment="Left" Padding="8,2" Margin="0,4,0,0" IsEnabled="False" Click="OpenRelease_Click" />
                        <Expander x:Name="OutputExpander" Header="Ausgabe" Margin="0,10,0,0">
                            <TextBox x:Name="OutputBox" Height="180" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Git" x:Name="GitTab">
                <DockPanel Margin="8">
                    <TextBlock x:Name="GitInfoText" DockPanel.Dock="Top" TextWrapping="Wrap" />
                    <Expander DockPanel.Dock="Bottom" Header="Ausgabe" Margin="0,6,0,0">
                        <TextBox x:Name="GitOutputBox" Height="110" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                    </Expander>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button x:Name="GitRefreshButton" Content="Aktualisieren" Padding="8,2" Margin="0,0,6,4" Click="GitRefresh_Click" />
                        <Button x:Name="GitCommitButton" Content="Alle Änderungen committen" Padding="8,2" Margin="0,0,6,4" Click="GitCommit_Click"
                                ToolTip="Führt git add -A und git commit aus. Vorher siehst du die Dateiliste und bestätigst." />
                        <Button x:Name="GitPushButton" Content="Pushen" Padding="8,2" Margin="0,0,6,4" Click="GitPush_Click"
                                ToolTip="Pusht den Branch (nie erzwungen). Ohne Upstream wird er mit -u origin angelegt." />
                    </WrapPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <TextBlock Text="Commit-Nachricht:" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBox x:Name="CommitMessageBox" />
                    </DockPanel>
                    <ListBox x:Name="GitChangeList" Margin="0,6,0,0" FontFamily="Consolas" />
                </DockPanel>
            </TabItem>
            <TabItem Header="Aufräumen" x:Name="CleanupTab">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top">
                        <Button x:Name="CleanupLoadButton" DockPanel.Dock="Right" Content="Laden" Padding="8,2" Margin="8,0,0,0" Click="CleanupLoad_Click"
                                ToolTip="Holt Releases, Tags und Branches des gewählten Repositories von GitHub" />
                        <TextBlock Text="Repository:" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="CleanupRepoBox" />
                    </DockPanel>
                    <TextBlock x:Name="CleanupText" DockPanel.Dock="Bottom" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="Releases" FontWeight="Bold" Margin="0,0,0,4" />
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <CheckBox x:Name="CleanupTagCheck" Content="Auch den Tag löschen" />
                                <Button x:Name="CleanupDeleteReleaseButton" Content="Löschen" Padding="8,2" Margin="0,4,0,0" HorizontalAlignment="Left" IsEnabled="False" Click="CleanupDeleteRelease_Click" />
                            </StackPanel>
                            <ListBox x:Name="CleanupReleaseList" DisplayMemberPath="Text" SelectionChanged="CleanupList_SelectionChanged" />
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="Tags" FontWeight="Bold" Margin="0,0,0,4" />
                            <Button x:Name="CleanupDeleteTagButton" DockPanel.Dock="Bottom" Content="Löschen" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Left" IsEnabled="False" Click="CleanupDeleteTag_Click" />
                            <ListBox x:Name="CleanupTagList" DisplayMemberPath="Text" SelectionChanged="CleanupList_SelectionChanged" />
                        </DockPanel>
                        <DockPanel Grid.Column="4">
                            <TextBlock DockPanel.Dock="Top" Text="Branches" FontWeight="Bold" Margin="0,0,0,4" />
                            <Button x:Name="CleanupDeleteBranchButton" DockPanel.Dock="Bottom" Content="Löschen" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Left" IsEnabled="False" Click="CleanupDeleteBranch_Click" />
                            <ListBox x:Name="CleanupBranchList" DisplayMemberPath="Text" SelectionChanged="CleanupList_SelectionChanged" />
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
