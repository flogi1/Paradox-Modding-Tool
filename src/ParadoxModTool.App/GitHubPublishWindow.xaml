<Window x:Class="ParadoxModTool.App.GitHubPublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParadoxModTool.App"
        xmlns:loc="clr-namespace:ParadoxModTool.Localization;assembly=ParadoxModTool.Localization"
        Title="{x:Static local:PublishTexts.GitHubTitle}" Height="880" Width="860" MinHeight="620" MinWidth="740"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!--
        Ein Ablauf für GitHub-Releases: Repositories wählen, Titel und Notes prüfen, ZIP-Varianten wählen, veröffentlichen. Zusätzlich die Reiter "Git" (committen, pushen) und
        "Aufräumen" (Releases, Tags, Branches löschen). Alles läuft über gh und git; das Programm sieht nie ein Token.
    -->
    <DockPanel Margin="12">
        <TextBlock x:Name="ResultText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" />

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="15" />
            <TextBlock x:Name="VersionText" Margin="0,2,0,0" Foreground="{DynamicResource Theme.TextMuted}" />
            <TextBlock x:Name="GhStatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
            <WrapPanel Margin="0,6,0,0">
                <Button x:Name="GhDownloadButton" Content="{x:Static local:PublishTexts.GhDownload}" Padding="8,2" Margin="0,0,6,4" Click="GhDownload_Click">
                    <Button.ToolTip>
                        <ToolTip MaxWidth="380">
                            <TextBlock TextWrapping="Wrap"
                                       Text="{x:Static local:PublishTexts.GhDownloadTip}" />
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
                <Button x:Name="GhLoginButton" Content="{x:Static local:PublishTexts.GhLogin}" Padding="8,2" Margin="0,0,6,4" Click="GhLogin_Click"
                        ToolTip="{x:Static local:PublishTexts.GhLoginTip}" />
                <Button x:Name="GhRefreshButton" Content="{x:Static local:PublishTexts.GhRefresh}" Padding="8,2" Margin="0,0,6,4" Click="GhRefresh_Click"
                        ToolTip="{x:Static local:PublishTexts.GhRefreshTip}" />
            </WrapPanel>
        </StackPanel>

        <TabControl x:Name="Tabs" Margin="0,10,0,0">
            <TabItem Header="{x:Static local:PublishTexts.Publish}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Repositories" FontWeight="Bold" />
                        <ListBox x:Name="RepoList" Height="92" Margin="0,4,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Content="{Binding Text}" Click="RepoCheck_Click" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Margin="0,4,0,0">
                            <Button x:Name="RepoAddButton" Content="{x:Static local:PublishTexts.Add}" Padding="8,2" Margin="0,0,6,4" Click="RepoAdd_Click" />
                            <Button x:Name="RepoEditButton" Content="{x:Static local:PublishTexts.Edit}" Padding="8,2" Margin="0,0,6,4" Click="RepoEdit_Click" />
                            <Button x:Name="RepoRemoveButton" Content="{x:Static loc:CommonTexts.Remove}" Padding="8,2" Margin="0,0,6,4" Click="RepoRemove_Click" />
                            <Button x:Name="RepoOriginButton" Content="{x:Static local:PublishTexts.RepoOrigin}" Padding="8,2" Margin="0,0,6,4" Visibility="Collapsed" Click="RepoOrigin_Click"
                                    ToolTip="{x:Static local:PublishTexts.RepoOriginTip}" />
                        </WrapPanel>

                        <TextBlock Text="Release" FontWeight="Bold" Margin="0,14,0,4" />
                        <DockPanel>
                            <TextBlock Text="{x:Static local:PublishTexts.ReleaseTitleLabel}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBox x:Name="TitleBox" TextChanged="TitleBox_TextChanged" />
                        </DockPanel>
                        <TextBlock Text="{x:Static local:PublishTexts.NotesLabel}" Margin="0,8,0,2" />
                        <TextBox x:Name="NotesBox" Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="NotesBox_TextChanged"
                                 ToolTip="{x:Static local:PublishTexts.NotesTip}" />
                        <TextBlock x:Name="NotesCountText" Margin="0,2,0,0" Foreground="{DynamicResource Theme.TextMuted}" />
                        <CheckBox x:Name="DraftCheck" Margin="0,8,0,0" Content="{x:Static local:PublishTexts.Draft}" Click="ReleaseOption_Click"
                                  ToolTip="{x:Static local:PublishTexts.DraftTip}" />
                        <CheckBox x:Name="PreReleaseCheck" Margin="0,4,0,0" Content="{x:Static local:PublishTexts.PreRelease}" Click="ReleaseOption_Click" />
                        <CheckBox x:Name="UpdateCheck" Margin="0,4,0,0" Content="{x:Static local:PublishTexts.UpdateExisting}" Click="ReleaseOption_Click"
                                  ToolTip="{x:Static local:PublishTexts.UpdateExistingTip}" />

                        <TextBlock Text="{x:Static local:PublishTexts.ZipVariants}" FontWeight="Bold" Margin="0,14,0,4" />
                        <ListBox x:Name="VariantList" Height="92" SelectionChanged="VariantList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Content="{Binding Text}" Click="VariantCheck_Click" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="VariantInfoText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" />
                        <WrapPanel Margin="0,4,0,0">
                            <Button x:Name="VariantAddButton" Content="{x:Static local:PublishTexts.Add}" Padding="8,2" Margin="0,0,6,4" Click="VariantAdd_Click" />
                            <Button x:Name="VariantEditButton" Content="{x:Static local:PublishTexts.Edit}" Padding="8,2" Margin="0,0,6,4" Click="VariantEdit_Click" />
                            <Button x:Name="VariantRemoveButton" Content="{x:Static loc:CommonTexts.Remove}" Padding="8,2" Margin="0,0,6,4" Click="VariantRemove_Click" />
                            <Button x:Name="VariantListButton" Content="{x:Static local:PublishTexts.List}" Padding="8,2" Margin="0,0,6,4" Click="VariantExcluded_Click"
                                    ToolTip="{x:Static local:PublishTexts.VariantListTip}" />
                            <Button x:Name="VariantBuildButton" Content="{x:Static local:PublishTexts.VariantBuild}" Padding="8,2" Margin="0,0,6,4" Click="VariantBuild_Click"
                                    ToolTip="{x:Static local:PublishTexts.VariantBuildTip}" />
                        </WrapPanel>
                        <!--ANCHOR:variants-->
                        <TextBlock Text="{x:Static local:PublishTexts.Checks}" FontWeight="Bold" Margin="0,14,0,4" />
                        <ItemsControl x:Name="HintList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="PublishButton" Content="{x:Static local:PublishTexts.Publish}" Padding="14,4" Click="Publish_Click" />
                            <Button x:Name="CancelButton" Content="{x:Static loc:CommonTexts.Cancel}" Padding="14,4" Margin="8,0,0,0" Visibility="Collapsed" Click="Cancel_Click" />
                            <ProgressBar x:Name="PublishProgress" Width="160" Height="14" Margin="12,0,0,0" IsIndeterminate="True" Visibility="Collapsed" />
                        </StackPanel>

                        <TextBlock Text="{x:Static local:PublishTexts.Result}" FontWeight="Bold" Margin="0,12,0,4" />
                        <ListBox x:Name="ResultList" Height="72" DisplayMemberPath="Text" SelectionChanged="ResultList_SelectionChanged" MouseDoubleClick="ResultList_DoubleClick" />
                        <Button x:Name="OpenReleaseButton" Content="{x:Static local:PublishTexts.OpenRelease}" HorizontalAlignment="Left" Padding="8,2" Margin="0,4,0,0" IsEnabled="False" Click="OpenRelease_Click" />
                        <Expander x:Name="OutputExpander" Header="{x:Static local:PublishTexts.Output}" Margin="0,10,0,0">
                            <TextBox x:Name="OutputBox" Height="180" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Git" x:Name="GitTab">
                <DockPanel Margin="8">
                    <TextBlock x:Name="GitInfoText" DockPanel.Dock="Top" TextWrapping="Wrap" />
                    <Expander DockPanel.Dock="Bottom" Header="{x:Static local:PublishTexts.Output}" Margin="0,6,0,0">
                        <TextBox x:Name="GitOutputBox" Height="110" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                    </Expander>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button x:Name="GitRefreshButton" Content="{x:Static local:PublishTexts.GitRefresh}" Padding="8,2" Margin="0,0,6,4" Click="GitRefresh_Click" />
                        <Button x:Name="GitCommitButton" Content="{x:Static local:PublishTexts.GitCommit}" Padding="8,2" Margin="0,0,6,4" Click="GitCommit_Click"
                                ToolTip="{x:Static local:PublishTexts.GitCommitTip}" />
                        <Button x:Name="GitPushButton" Content="{x:Static local:PublishTexts.GitPush}" Padding="8,2" Margin="0,0,6,4" Click="GitPush_Click"
                                ToolTip="{x:Static local:PublishTexts.GitPushTip}" />
                    </WrapPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <TextBlock Text="{x:Static local:PublishTexts.CommitMessageLabel}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBox x:Name="CommitMessageBox" />
                    </DockPanel>
                    <ListBox x:Name="GitChangeList" Margin="0,6,0,0" FontFamily="Consolas" />
                </DockPanel>
            </TabItem>
            <TabItem Header="{x:Static local:PublishTexts.CleanupTab}" x:Name="CleanupTab">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top">
                        <Button x:Name="CleanupLoadButton" DockPanel.Dock="Right" Content="{x:Static local:PublishTexts.CleanupLoad}" Padding="8,2" Margin="8,0,0,0" Click="CleanupLoad_Click"
                                ToolTip="{x:Static local:PublishTexts.CleanupLoadTip}" />
                        <TextBlock Text="Repository:" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="CleanupRepoBox" />
                    </DockPanel>
                    <TextBlock x:Name="CleanupText" DockPanel.Dock="Bottom" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="Releases" FontWeight="Bold" Margin="0,0,0,4" />
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <CheckBox x:Name="CleanupTagCheck" Content="{x:Static local:PublishTexts.CleanupWithTag}" />
                                <Button x:Name="CleanupDeleteReleaseButton" Content="{x:Static loc:CommonTexts.Delete}" Padding="8,2" Margin="0,4,0,0" HorizontalAlignment="Left" IsEnabled="False" Click="CleanupDeleteRelease_Click" />
                            </StackPanel>
                            <ListBox x:Name="CleanupReleaseList" DisplayMemberPath="Text" SelectionChanged="CleanupList_SelectionChanged" />
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="Tags" FontWeight="Bold" Margin="0,0,0,4" />
                            <Button x:Name="CleanupDeleteTagButton" DockPanel.Dock="Bottom" Content="{x:Static loc:CommonTexts.Delete}" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Left" IsEnabled="False" Click="CleanupDeleteTag_Click" />
                            <ListBox x:Name="CleanupTagList" DisplayMemberPath="Text" SelectionChanged="CleanupList_SelectionChanged" />
                        </DockPanel>
                        <DockPanel Grid.Column="4">
                            <TextBlock DockPanel.Dock="Top" Text="Branches" FontWeight="Bold" Margin="0,0,0,4" />
                            <Button x:Name="CleanupDeleteBranchButton" DockPanel.Dock="Bottom" Content="{x:Static loc:CommonTexts.Delete}" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Left" IsEnabled="False" Click="CleanupDeleteBranch_Click" />
                            <ListBox x:Name="CleanupBranchList" DisplayMemberPath="Text" SelectionChanged="CleanupList_SelectionChanged" />
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
