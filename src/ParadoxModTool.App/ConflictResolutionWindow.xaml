<Window x:Class="ParadoxModTool.App.ConflictResolutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge-Konflikte auflösen" Height="500" Width="700"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ConfirmButton" Content="Übernehmen und schreiben" Click="ConfirmButton_Click" Padding="10,4" Margin="0,0,8,0" />
            <Button Content="Abbrechen" IsCancel="True" Padding="10,4" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ConflictsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Theme.Separator}" BorderThickness="0,0,0,1" Padding="0,6,0,6" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="{Binding Path}" FontWeight="Bold" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,6" />
                                <RadioButton GroupName="{Binding GroupName}" Content="{Binding VanillaOptionLabel}"
                                             IsChecked="{Binding PreferVanilla}" />
                                <RadioButton GroupName="{Binding GroupName}" Content="{Binding ModOptionLabel}"
                                             IsChecked="{Binding PreferMod}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
