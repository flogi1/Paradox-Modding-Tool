<Window x:Class="ParadoxModTool.App.ScriptDocsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ParadoxModTool.Localization;assembly=ParadoxModTool.Localization"
        xmlns:local="clr-namespace:ParadoxModTool.App"
        Title="{x:Static local:MiscWindowTexts.ScriptDocsTitle}" Height="720" Width="1150" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
            <Button x:Name="FolderButton" DockPanel.Dock="Right" Content="{x:Static local:MiscWindowTexts.ScriptDocsChooseFolder}" Padding="8,2" Margin="6,0,0,0" Click="FolderButton_Click"
                    ToolTip="{x:Static local:MiscWindowTexts.ScriptDocsChooseFolderTip}" />
            <Button x:Name="ReloadButton" DockPanel.Dock="Right" Content="{x:Static local:MiscWindowTexts.ScriptDocsReload}" Padding="8,2" Margin="6,0,0,0" Click="ReloadButton_Click"
                    ToolTip="{x:Static local:MiscWindowTexts.ScriptDocsReloadTip}" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Theme.TextMuted}" />
        </DockPanel>

        <Border x:Name="HintBorder" DockPanel.Dock="Top" Margin="8,0,8,4" Padding="8,6" Visibility="Collapsed"
                Background="{DynamicResource Theme.NoticeBackground}" BorderBrush="{DynamicResource Theme.NoticeBorder}" BorderThickness="1">
            <TextBlock x:Name="HintText" TextWrapping="Wrap" Foreground="{DynamicResource Theme.NoticeText}" />
        </Border>

        <Grid Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" TextChanged="Filter_Changed"
                         ToolTip="{x:Static local:MiscWindowTexts.ScriptDocsSearchTip}" />
                <WrapPanel x:Name="KindPanel" DockPanel.Dock="Top" Margin="0,6,0,0" />
                <DockPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                    <CheckBox x:Name="HideOutdatedBox" DockPanel.Dock="Right" Content="{x:Static local:MiscWindowTexts.ScriptDocsHideOutdated}" IsChecked="True" VerticalAlignment="Center"
                              Margin="8,0,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"
                              ToolTip="{x:Static local:MiscWindowTexts.ScriptDocsHideOutdatedTip}" />
                    <ComboBox x:Name="ScopeCombo" SelectionChanged="Filter_Changed" ToolTip="{x:Static local:MiscWindowTexts.ScriptDocsScopeTip}" />
                </DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Margin="0,4,0,0" Foreground="{DynamicResource Theme.TextMuted}" />
                <ListBox x:Name="EntryList" Margin="0,6,0,0" SelectionChanged="EntryList_SelectionChanged" MouseDoubleClick="EntryList_MouseDoubleClick"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Opacity="{Binding Opacity}" ToolTip="{Binding Tooltip}">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Theme.TextMuted}" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Background="Transparent" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1.4*" MinHeight="80" />
                </Grid.RowDefinitions>

                <TextBox x:Name="NameBox" Grid.Row="0" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="MetaText" Grid.Row="1" TextWrapping="Wrap" Margin="0,2,0,6" Foreground="{DynamicResource Theme.TextMuted}" />
                <TextBox x:Name="DescriptionBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" AcceptsReturn="True" />

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,4">
                    <Button x:Name="InsertButton" Content="{x:Static local:MiscWindowTexts.ScriptDocsInsert}" Padding="10,3" IsEnabled="False" Click="InsertButton_Click"
                            ToolTip="{x:Static local:MiscWindowTexts.ScriptDocsInsertTip}" />
                    <Button x:Name="UsageButton" Content="{x:Static local:MiscWindowTexts.ScriptDocsFindExamples}" Padding="10,3" Margin="6,0,0,0" IsEnabled="False" Click="UsageButton_Click"
                            ToolTip="{x:Static local:MiscWindowTexts.ScriptDocsFindExamplesTip}" />
                    <Button x:Name="CancelUsageButton" Content="{x:Static loc:CommonTexts.Cancel}" Padding="10,3" Margin="6,0,0,0" Visibility="Collapsed" Click="CancelUsageButton_Click" />
                </StackPanel>

                <TextBlock x:Name="UsageHeader" Grid.Row="4" Margin="0,4,0,2" Foreground="{DynamicResource Theme.TextMuted}" TextTrimming="CharacterEllipsis" />
                <ListBox x:Name="HitsList" Grid.Row="5" MouseDoubleClick="HitsList_MouseDoubleClick"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel ToolTip="{Binding FullPath}">
                                <TextBlock Text="{Binding Location}" Foreground="{DynamicResource Theme.Accent}" FontSize="11" />
                                <TextBlock Text="{Binding Text}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
