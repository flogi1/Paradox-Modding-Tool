<Window x:Class="ParadoxModTool.App.ScriptDocsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Script-Datenbank" Height="720" Width="1150" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
            <Button x:Name="FolderButton" DockPanel.Dock="Right" Content="Ordner wählen" Padding="8,2" Margin="6,0,0,0" Click="FolderButton_Click"
                    ToolTip="Ordner mit den Doku-Logs des Spiels (docs) festlegen" />
            <Button x:Name="ReloadButton" DockPanel.Dock="Right" Content="Neu einlesen" Padding="8,2" Margin="6,0,0,0" Click="ReloadButton_Click"
                    ToolTip="Die Logs erneut lesen (sonst geschieht das automatisch beim Öffnen, wenn sie sich geändert haben)" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Theme.TextMuted}" />
        </DockPanel>

        <Border x:Name="HintBorder" DockPanel.Dock="Top" Margin="8,0,8,4" Padding="8,6" Visibility="Collapsed"
                Background="{DynamicResource Theme.NoticeBackground}" BorderBrush="{DynamicResource Theme.NoticeBorder}" BorderThickness="1">
            <TextBlock x:Name="HintText" TextWrapping="Wrap" Foreground="{DynamicResource Theme.NoticeText}" />
        </Border>

        <Grid Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" TextChanged="Filter_Changed"
                         ToolTip="Teil des Namens oder der Beschreibung; mit * und ? als Platzhalter wird der ganze Name verglichen (z. B. add_*_modifier)" />
                <WrapPanel x:Name="KindPanel" DockPanel.Dock="Top" Margin="0,6,0,0" />
                <DockPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                    <CheckBox x:Name="HideOutdatedBox" DockPanel.Dock="Right" Content="Veraltete ausblenden" IsChecked="True" VerticalAlignment="Center"
                              Margin="8,0,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"
                              ToolTip="Veraltet: der Eintrag stand im letzten Einlesen der Logs nicht mehr. Das kann auch am aktiven Playset liegen (Einträge deaktivierter Mods fehlen dann)." />
                    <ComboBox x:Name="ScopeCombo" SelectionChanged="Filter_Changed" ToolTip="Nur Einträge, die in diesem Scope benutzbar sind" />
                </DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Margin="0,4,0,0" Foreground="{DynamicResource Theme.TextMuted}" />
                <ListBox x:Name="EntryList" Margin="0,6,0,0" SelectionChanged="EntryList_SelectionChanged" MouseDoubleClick="EntryList_MouseDoubleClick"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Opacity="{Binding Opacity}" ToolTip="{Binding Tooltip}">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Theme.TextMuted}" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Background="Transparent" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1.4*" MinHeight="80" />
                </Grid.RowDefinitions>

                <TextBox x:Name="NameBox" Grid.Row="0" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="MetaText" Grid.Row="1" TextWrapping="Wrap" Margin="0,2,0,6" Foreground="{DynamicResource Theme.TextMuted}" />
                <TextBox x:Name="DescriptionBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" AcceptsReturn="True" />

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,4">
                    <Button x:Name="InsertButton" Content="In Editor einfügen" Padding="10,3" IsEnabled="False" Click="InsertButton_Click"
                            ToolTip="Fügt den Namen an der Cursorposition des aktiven Dokuments ein (auch Doppelklick auf den Eintrag)" />
                    <Button x:Name="UsageButton" Content="Beispiele suchen" Padding="10,3" Margin="6,0,0,0" IsEnabled="False" Click="UsageButton_Click"
                            ToolTip="Sucht den Namen in den Vanilla- und Mod-Dateien und merkt sich das Ergebnis" />
                    <Button x:Name="CancelUsageButton" Content="Abbrechen" Padding="10,3" Margin="6,0,0,0" Visibility="Collapsed" Click="CancelUsageButton_Click" />
                </StackPanel>

                <TextBlock x:Name="UsageHeader" Grid.Row="4" Margin="0,4,0,2" Foreground="{DynamicResource Theme.TextMuted}" TextTrimming="CharacterEllipsis" />
                <ListBox x:Name="HitsList" Grid.Row="5" MouseDoubleClick="HitsList_MouseDoubleClick"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel ToolTip="{Binding FullPath}">
                                <TextBlock Text="{Binding Location}" Foreground="{DynamicResource Theme.Accent}" FontSize="11" />
                                <TextBlock Text="{Binding Text}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
