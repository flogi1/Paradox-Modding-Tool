<Window x:Class="ParadoxModTool.App.BranchSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParadoxModTool.App"
        xmlns:loc="clr-namespace:ParadoxModTool.Localization;assembly=ParadoxModTool.Localization"
        Title="{x:Static local:MainTexts.SyncTitle}" Height="600" Width="980" MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!--
        Abgleich zweier Mods eines Projekts: Liste der Unterschiede (nur links, nur rechts, unterschiedlich, gleich) mit Übernehmen je Datei
        über BranchTransfer und Vergleich einer Datei im Vergleichsfenster.
    -->
    <DockPanel Margin="12">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" />
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="ToRightButton" Content="{x:Static local:MainTexts.SyncApply}" Padding="8,2" Margin="0,0,6,0" MaxWidth="320" Click="ToRight_Click" />
            <Button x:Name="ToLeftButton" Content="{x:Static local:MainTexts.SyncApply}" Padding="8,2" Margin="0,0,6,0" MaxWidth="320" Click="ToLeft_Click" />
            <Button x:Name="CompareFileButton" Content="{x:Static local:MainTexts.SyncCompareFile}" Padding="8,2" Click="CompareFile_Click"
                    ToolTip="{x:Static local:MainTexts.SyncCompareFileTip}" />
        </WrapPanel>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{x:Static local:MainTexts.SyncLeft}" FontWeight="Bold" Margin="0,0,0,2" />
                <ComboBox x:Name="LeftCombo" DisplayMemberPath="Name" SelectionChanged="Combo_SelectionChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{x:Static local:MainTexts.SyncRight}" FontWeight="Bold" Margin="0,0,0,2" />
                <ComboBox x:Name="RightCombo" DisplayMemberPath="Name" SelectionChanged="Combo_SelectionChanged" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                <Button x:Name="RunButton" Content="{x:Static local:MainTexts.SyncRun}" Padding="10,2" Margin="0,0,6,0" Click="Run_Click" />
                <Button x:Name="CancelButton" Content="{x:Static loc:CommonTexts.Cancel}" Padding="10,2" IsEnabled="False" Click="Cancel_Click" />
            </StackPanel>
        </Grid>
        <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,8">
            <CheckBox x:Name="OnlyLeftCheck" Content="{x:Static local:MainTexts.SyncOnlyLeft}" IsChecked="True" Margin="0,0,12,0" Click="Filter_Changed" />
            <CheckBox x:Name="OnlyRightCheck" Content="{x:Static local:MainTexts.SyncOnlyRight}" IsChecked="True" Margin="0,0,12,0" Click="Filter_Changed" />
            <CheckBox x:Name="DifferentCheck" Content="{x:Static local:MainTexts.SyncDifferent}" IsChecked="True" Margin="0,0,12,0" Click="Filter_Changed" />
            <CheckBox x:Name="SameCheck" Content="{x:Static local:MainTexts.SyncSame}" IsChecked="False" Margin="0,0,12,0" Click="Filter_Changed" />
            <TextBlock Text="{x:Static local:MainTexts.SyncPathFilter}" VerticalAlignment="Center" Margin="12,0,4,0" />
            <TextBox x:Name="PathFilterBox" Width="220" TextChanged="Filter_TextChanged" />
        </WrapPanel>
        <local:CategoryFilterBar x:Name="CategoryBar" DockPanel.Dock="Top" Margin="0,0,0,8" SelectionChanged="CategoryBar_Changed" />
        <ListView x:Name="ResultList" SelectionMode="Extended" SelectionChanged="ResultList_SelectionChanged" MouseDoubleClick="ResultList_DoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{x:Static local:MainTexts.SyncColumnPath}" DisplayMemberBinding="{Binding Path}" Width="380" />
                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding StatusText}" Width="110" />
                    <GridViewColumn Header="{x:Static local:MainTexts.SyncColumnLocked}" DisplayMemberBinding="{Binding LockText}" Width="70" />
                    <GridViewColumn Header="{x:Static local:MainTexts.SyncColumnLeftSize}" DisplayMemberBinding="{Binding LeftSize}" Width="90" />
                    <GridViewColumn Header="{x:Static local:MainTexts.SyncColumnLeftDate}" DisplayMemberBinding="{Binding LeftDate}" Width="130" />
                    <GridViewColumn Header="{x:Static local:MainTexts.SyncColumnRightSize}" DisplayMemberBinding="{Binding RightSize}" Width="90" />
                    <GridViewColumn Header="{x:Static local:MainTexts.SyncColumnRightDate}" DisplayMemberBinding="{Binding RightDate}" Width="130" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
