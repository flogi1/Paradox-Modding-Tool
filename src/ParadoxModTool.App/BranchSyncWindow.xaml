<Window x:Class="ParadoxModTool.App.BranchSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParadoxModTool.App"
        Title="Abgleich" Height="600" Width="980" MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!--
        Abgleich zweier Mods eines Projekts: Liste der Unterschiede (nur links, nur rechts, unterschiedlich, gleich) mit Übernehmen je Datei
        über BranchTransfer und Vergleich einer Datei im Vergleichsfenster.
    -->
    <DockPanel Margin="12">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Theme.TextMuted}" />
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="ToRightButton" Content="Übernehmen" Padding="8,2" Margin="0,0,6,0" MaxWidth="320" Click="ToRight_Click" />
            <Button x:Name="ToLeftButton" Content="Übernehmen" Padding="8,2" Margin="0,0,6,0" MaxWidth="320" Click="ToLeft_Click" />
            <Button x:Name="CompareFileButton" Content="Datei vergleichen" Padding="8,2" Click="CompareFile_Click"
                    ToolTip="Die gewählte Datei aus beiden Mods im Vergleichsfenster öffnen (auch per Doppelklick)" />
        </WrapPanel>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Links" FontWeight="Bold" Margin="0,0,0,2" />
                <ComboBox x:Name="LeftCombo" DisplayMemberPath="Name" SelectionChanged="Combo_SelectionChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Rechts" FontWeight="Bold" Margin="0,0,0,2" />
                <ComboBox x:Name="RightCombo" DisplayMemberPath="Name" SelectionChanged="Combo_SelectionChanged" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                <Button x:Name="RunButton" Content="Vergleichen" Padding="10,2" Margin="0,0,6,0" Click="Run_Click" />
                <Button x:Name="CancelButton" Content="Abbrechen" Padding="10,2" IsEnabled="False" Click="Cancel_Click" />
            </StackPanel>
        </Grid>
        <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,8">
            <CheckBox x:Name="OnlyLeftCheck" Content="Nur links" IsChecked="True" Margin="0,0,12,0" Click="Filter_Changed" />
            <CheckBox x:Name="OnlyRightCheck" Content="Nur rechts" IsChecked="True" Margin="0,0,12,0" Click="Filter_Changed" />
            <CheckBox x:Name="DifferentCheck" Content="Unterschiedlich" IsChecked="True" Margin="0,0,12,0" Click="Filter_Changed" />
            <CheckBox x:Name="SameCheck" Content="Gleich" IsChecked="False" Margin="0,0,12,0" Click="Filter_Changed" />
            <TextBlock Text="Pfad enthält:" VerticalAlignment="Center" Margin="12,0,4,0" />
            <TextBox x:Name="PathFilterBox" Width="220" TextChanged="Filter_TextChanged" />
        </WrapPanel>
        <local:CategoryFilterBar x:Name="CategoryBar" DockPanel.Dock="Top" Margin="0,0,0,8" SelectionChanged="CategoryBar_Changed" />
        <ListView x:Name="ResultList" SelectionMode="Extended" SelectionChanged="ResultList_SelectionChanged" MouseDoubleClick="ResultList_DoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Pfad" DisplayMemberBinding="{Binding Path}" Width="380" />
                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding StatusText}" Width="110" />
                    <GridViewColumn Header="Gesperrt" DisplayMemberBinding="{Binding LockText}" Width="70" />
                    <GridViewColumn Header="Größe links" DisplayMemberBinding="{Binding LeftSize}" Width="90" />
                    <GridViewColumn Header="Datum links" DisplayMemberBinding="{Binding LeftDate}" Width="130" />
                    <GridViewColumn Header="Größe rechts" DisplayMemberBinding="{Binding RightSize}" Width="90" />
                    <GridViewColumn Header="Datum rechts" DisplayMemberBinding="{Binding RightDate}" Width="130" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
