<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ParadoxModTool.LaunchControl</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- launcher-v2.sqlite (EU IV, CK3) nur lesen; winsqlite3 ist Teil von Windows, deshalb keine mitgelieferte native DLL. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ParadoxModTool.Localization\ParadoxModTool.Localization.csproj" />
  </ItemGroup>

</Project>
