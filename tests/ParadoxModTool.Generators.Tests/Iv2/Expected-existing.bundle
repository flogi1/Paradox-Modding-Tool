				49 = {  # TST_2
					trigger = {
		scope:actor = {
			hidden_trigger = {
				NOT = { has_country_modifier = national_idea_modifier_TST_2 }
				NOT = { has_country_modifier = national_idea_modifier_TST_2_1 }
			}
			custom_tooltip = {
			text = iv2_tt_no_points_for_nat_idea_adm
			var:iv2_var_progress_points_adm >= var:iv2_var_national_idea_cost_adm
			}
			custom_tooltip = {
			text = iv2_tt_not_reached_national_idea_limit
			var:iv2_var_current_national_idea_limit > var:iv2_var_national_idea_current
			}
			iv2_sct_nat_idea_TST_1 = yes
		}
	}

		scope:actor = {								
			hidden_effect = {
				add_country_modifier = { 
					modifier = national_idea_modifier_TST_2 
					years = -1 
				}
