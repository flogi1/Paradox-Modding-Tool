###############################################################
#### Deselect National Idea adm_1
###############################################################


iv2_ga_deselect_historic_TST_3 = {
	type = owncountry	

	ai_tick = never

	allow = {
		scope:actor = {
			OR = {
				has_country_modifier = national_idea_modifier_TST_3
				has_country_modifier = national_idea_modifier_TST_3_1
				has_country_modifier = national_idea_modifier_TST_3_2
				has_country_modifier = national_idea_modifier_TST_3_3
			}		
		}
	}
	
	effect = {
		scope:actor = {								
			custom_tooltip = {
				text = iv2_tt_give_up_nat_idea_adm
				
				if = {
					limit = {
						has_country_modifier = national_idea_modifier_TST_3
					}
					remove_country_modifier = national_idea_modifier_TST_3
					change_variable = {
						name = iv2_var_national_idea_cost_adm
						subtract = iv2_progress_cost_increase
					}
				}
				
				if = {
					limit = {
						has_country_modifier = national_idea_modifier_TST_3_1
					}
					remove_country_modifier = national_idea_modifier_TST_3_1
					change_variable = {
						name = iv2_var_national_idea_cost_adm
						subtract = iv2_progress_cost_increase
					}
					change_variable = {
						name = iv2_var_national_idea_innovation_cost_adm
						subtract = iv2_innovation_cost_increase
					}
				}
				
				if = {
					limit = {
						has_country_modifier = national_idea_modifier_TST_3_2
					}
					remove_country_modifier = national_idea_modifier_TST_3_2
					change_variable = {
						name = iv2_var_national_idea_cost_adm
						subtract = iv2_progress_cost_increase
					}
					change_variable = {
						name = iv2_var_national_idea_innovation_cost_adm
						subtract = iv2_innovation_cost_decrease_x2
					}
				}
				
				if = {
					limit = {
						has_country_modifier = national_idea_modifier_TST_3_3
					}
					remove_country_modifier = national_idea_modifier_TST_3_3
					change_variable = {
						name = iv2_var_national_idea_cost_adm
						subtract = iv2_progress_cost_increase
					}
					change_variable = {
						name = iv2_var_national_idea_innovation_cost_adm
						subtract = iv2_innovation_cost_decrease_x3
					}
				}			
			}
			hidden_effect = {
				remove_list_variable = {
					name = iv2_picked_national_ideas_list
					target = flag:iv2_picked_historic_idea_TST_3
				}
				change_variable = {
					name = iv2_var_national_idea_current
					subtract = 1
				}
			}
		}
	}
}

