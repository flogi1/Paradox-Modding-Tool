##FILE in_game/gui/Idea Variation 2 National Ideas/Historic National Ideas/TST/IV2_historic_see_TST.gui
##########################################################################################################################
##########################################################################################################################
####### TST National Ideas - See
##########################################################################################################################
##########################################################################################################################

types iv2_historic_idea_TST_see { 
	
	type iv2_historic_idea_see_TST_1 = widget { 	
		visible = "[EqualTo_string(Scope.GetFlagName, 'iv2_picked_historic_idea_TST_1')]"
		size = { 200 250 }
		position = { 0 0 }
		
		icon = {
			position = { 2 0 }
			size = { 200 200 }
			parentanchor = top|hcenter
			texture = "gfx/interface/iv2_national_idea_frame_2.dds"
