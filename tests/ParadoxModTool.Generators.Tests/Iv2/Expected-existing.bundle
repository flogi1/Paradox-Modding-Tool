##FILE in_game/common/generic_action_ai_lists/03_iv2_gal_nat_idea_TST.txt
###############################################################
#### Dynamic National Ideas GA List TST
###############################################################


iv2_ga_list_nat_ideas_progress_cost_TST = {
	potential = {
		NOT = { has_game_rule = iv2_rule_national_ideas_3 }
		has_or_had_tag = TST
		trigger_if = {
			limit = {
				has_variable = iv2_var_progress_points_adm
			}
			var:iv2_var_progress_points_adm >= var:iv2_var_national_idea_cost_adm
			
		}
	}
	actions = {
		iv2_ga_select_historic_TST_1
		iv2_ga_select_historic_TST_2
		iv2_ga_select_historic_TST_3
		iv2_ga_select_historic_TST_11
		iv2_ga_select_historic_TST_31
		iv2_ga_select_historic_TST_32
	}
}

iv2_ga_list_nat_ideas_innovation_cost_TST = {
	potential = {
		NOT = { has_game_rule = iv2_rule_national_ideas_3 }
		has_or_had_tag = TST
		trigger_if = {
			limit = {
				has_variable = iv2_var_innovation_points_adm
			}
			var:iv2_var_innovation_points_adm >= var:iv2_var_national_idea_innovation_cost_adm
		}
	}
	actions = {
		# All TST Level Selects
		iv2_ga_select_historic_TST_2_1
		iv2_ga_select_historic_TST_3_1	
		iv2_ga_select_historic_TST_3_2	
		iv2_ga_select_historic_TST_3_3
		iv2_ga_select_historic_TST_11_1	
		iv2_ga_select_historic_TST_11_2	
		iv2_ga_select_historic_TST_11_3
	}
}

# IV2 AI chooser: the AI picks historic ideas only through iv2_ga_ai_choose_historic_TST
iv2_ga_list_ai_choose_historic_TST = {
	potential = {
		is_ai = yes
		iv2_scripted_trigger_use_historic_ideas = yes
		has_or_had_tag = TST
	}
	actions = {
		iv2_ga_ai_choose_historic_TST
	}
}
##FILE in_game/common/generic_actions/iv2_GA_ideas_TST.txt
###################################################
###################################################
###### Idea Variation 2 GA Idea Groups Admin
###################################################
###################################################

###############################################################
#### Select National Idea TST_1
###############################################################

iv2_ga_select_historic_TST_1 = {
	type = owncountry	

	ai_tick = never
	#ai_tick_frequency = 36

	automation_tick = monthly
	automation_tick_frequency = 1
	player_automated_category = governmentreforms

	allow = {
		scope:actor = {
			hidden_trigger = {
				NOT = { has_country_modifier = national_idea_modifier_TST_1 }
			}
			custom_tooltip = {
			text = iv2_tt_no_points_for_nat_idea_adm
			var:iv2_var_progress_points_adm >= var:iv2_var_national_idea_cost_adm
			}
			custom_tooltip = {
			text = iv2_tt_not_reached_national_idea_limit
			var:iv2_var_current_national_idea_limit > var:iv2_var_national_idea_current
			}
			iv2_sct_nat_idea_TST_1 = yes
		}
	}

	ai_will_do = {
		add = {
			value = 1000
		}
	}
	
	effect = {
		scope:actor = {								
			hidden_effect = {
				add_country_modifier = { 
					modifier = national_idea_modifier_TST_1 
					years = -1 
				}
				set_variable = { 
					name = iv2_var_nat_adm_1
					value = flag:iv2_picked_historic_idea_TST_1
				}
				add_to_variable_list = {
						name = iv2_picked_national_ideas_list
						target = flag:iv2_picked_historic_idea_TST_1
				}
				change_variable = {
					name = iv2_var_national_idea_current
					add = 1
				}	
			}
			custom_tooltip = {
			text = iv2_tt_sub_points_adm
				change_variable = {
					name = iv2_var_progress_points_adm
					subtract = var:iv2_var_national_idea_cost_adm
				}
			}
			custom_tooltip = {
			text = iv2_tt_increase_points_adm
				change_variable = {
					name = iv2_var_national_idea_cost_adm
					add = iv2_progress_cost_increase
				}
				change_variable = {
					name = iv2_var_national_idea_cost_expensive_adm
					add = iv2_progress_cost_increase
				}
			}
		}
	}
}

###############################################################
#### Deselect National Idea adm_1
###############################################################


iv2_ga_deselect_historic_TST_1 = {
	type = owncountry	

	ai_tick = never

	allow = {
		scope:actor = {
			OR = {
				has_country_modifier = national_idea_modifier_TST_1
			}		
		}
	}
	
	effect = {
		scope:actor = {								
			custom_tooltip = {
				text = iv2_tt_give_up_nat_idea_adm
				
				if = {
					limit = {
						has_country_modifier = national_idea_modifier_TST_1
					}
					remove_country_modifier = national_idea_modifier_TST_1
					change_variable = {
						name = iv2_var_national_idea_cost_adm
						subtract = iv2_progress_cost_increase
					}
				}			
			}
			hidden_effect = {
				remove_list_variable = {
					name = iv2_picked_national_ideas_list
					target = flag:iv2_picked_historic_idea_TST_1
				}
				change_variable = {
					name = iv2_var_national_idea_current
					subtract = 1
				}
			}
		}
	}
}

