 iv2_hist_idea_flag_tt_desc_TST: "This is a Historic National Idea of $TST$."
 iv2_ga_ai_choose_historic_TST: "KI: historische Nationalidee wählen"
 iv2_ga_ai_choose_historic_TST_desc: "Nur für die KI: wählt eine historische Nationalidee von $TST$ per gewichtetem Zufall."
 
