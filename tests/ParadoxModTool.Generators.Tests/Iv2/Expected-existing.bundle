######################################################

iv2_historic_ideas_list_setup_effect = {
	if = {
		limit = { has_or_had_tag = TS }
		set_variable = {
			name = iv2_nat_TS_1
			value = flag:iv2_nat_TS_1
		}
		add_to_variable_list = {
				name = iv2_historic_ideas_list_adm
				target = flag:iv2_nat_TS_1
		}
	}

	# === IV2Generator:TST:START ===
	if = {
		limit = { has_or_had_tag = TST }
		set_variable = { 
			name = iv2_nat_TST_1
			value = flag:iv2_nat_TST_1
		}	
		add_to_variable_list = {
				name = iv2_historic_ideas_list_adm
				target = flag:iv2_nat_TST_1
		}
		set_variable = { 
			name = iv2_nat_TST_2
			value = flag:iv2_nat_TST_2
		}	
		add_to_variable_list = {
				name = iv2_historic_ideas_list_adm
				target = flag:iv2_nat_TST_2
		}
		set_variable = { 
			name = iv2_nat_TST_3
			value = flag:iv2_nat_TST_3
		}	
		add_to_variable_list = {
				name = iv2_historic_ideas_list_adm
				target = flag:iv2_nat_TST_3
		}
		
		set_variable = { 
			name = iv2_nat_TST_11
			value = flag:iv2_nat_TST_11
		}	
		add_to_variable_list = {
				name = iv2_historic_ideas_list_dip
				target = flag:iv2_nat_TST_11
		}
		
		set_variable = { 
			name = iv2_nat_TST_31
			value = flag:iv2_nat_TST_31
		}	
		add_to_variable_list = {
				name = iv2_historic_ideas_list_navy
				target = flag:iv2_nat_TST_31
		}
		set_variable = { 
			name = iv2_nat_TST_32
