# block: Dropdown
# group: Bedienelemente
# description: Auswahlliste; ohne datamodel erscheint sie nicht. Die Auswahl (onselectionchanged, selectedindex) steuern in Vanilla nur Funktionen des Spiels, nicht GetVariableSystem. Mit der Vorgabe listet sie den Hof des eigenen Charakters. Vorbild: gui/debug/window_component_library.gui, gui/shared/lists.gui
# param: name | Name | my_dropdown
# param: datamodel | Liste (datamodel) | GetPlayer.GetCourt
# param: item_text | Text je Eintrag | Character.GetNameNoTooltip
# requires: dropdown_menu_standard

dropdown_menu_standard = {
	blockoverride "dropdown_properties" {
		name = "$name$"
		datamodel = "[$datamodel$]"
		# onselectionchanged = "[...]"
		# selectedindex = "[...]"
	}

	blockoverride "dropdown_size" {
		size = { 300 32 }
	}

	blockoverride "dropdown_active_item_properties" {
		raw_text = "[$item_text$]"
	}

	blockoverride "dropdown_item_properties" {
		raw_text = "[$item_text$]"
	}
}
