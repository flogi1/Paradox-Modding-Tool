# block: Charakterporträt
# group: Anzeige
# description: Porträt (Kopf) mit Tooltip und Klick zum Charakter; mit der Vorgabe zeigt es den eigenen Charakter. Andere Größen: portrait_head_small, portrait_shoulders, portrait_torso, portrait_body. Porträts erscheinen nur im laufenden Spiel. Vorbild: gui/debug/window_component_library.gui, gui/shared/portraits.gui
# param: character | Charakter (Datenkontext) | GetPlayer
# requires: portrait_head

portrait_head = {
	datacontext = "[$character$]"
}
