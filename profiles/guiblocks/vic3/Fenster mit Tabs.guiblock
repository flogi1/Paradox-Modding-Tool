# block: Fenster mit Tabs
# group: Fenster
# description: Popup-Fenster (default_popup) mit Kopfzeile und Tab-Leiste, je Tab wahlweise eine Untertab-Leiste (Anzahl 1). Umschaltung über GetVariableSystem, eine Variable je Fenster und je Tab. Tabs wie in der Kartenmodus-Leiste (tab_button, gewählt selected_tabs); Victoria 3 kennt keine eigenen Untertabs, sie sind default_button mit down wie gewählte Listenknöpfe. Sichtbar, solange die Variable $name$ besteht: öffnen mit onclick = "[GetVariableSystem.Set( '$name$', 'yes' )]" an einem Knopf, der Schließen-Knopf löscht sie. Ein Fenster aus einer Mod-Datei entsteht nur, wenn es in gui/scripted_widgets/<datei>.txt als gui/<datei>.gui = $name$ eingetragen oder in ein Vanilla-Fenster eingebaut ist. Vorbild: gui/popups.gui, gui/lens_toolbar.gui, gui/window_component_library.gui
# param: name | Name des Fensters | my_window
# param: title | Titel (Lokalisierungsschlüssel) | MY_WINDOW_TITLE
# param: start_tab | Start-Tab (Kennung) | tab_1
# repeat: tabs | Tabs | 3
# param: tabs.id | Kennung | tab_$index$
# param: tabs.title | Titel (Lokalisierungsschlüssel) | TAB_$index$
# repeat: tabs.sub | Untertab-Leiste (0 = keine, 1 = mit Untertabs) | 0
# param: tabs.sub.start | Start-Untertab (Kennung) | $tabs.id$_sub_1
# repeat: tabs.sub.items | Untertabs | 3
# param: tabs.sub.items.id | Kennung | $tabs.id$_sub_$index$
# param: tabs.sub.items.title | Titel (Lokalisierungsschlüssel) | $tabs.title$_SUB_$index$
# requires: default_popup, tab_button, selected_tabs, tab_text_properties, default_button

default_popup = {
	name = "$name$"
	visible = "[GetVariableSystem.Exists( '$name$' )]"

	state = {
		name = _show
		on_start = "[GetVariableSystem.Set( '$name$_tab', '$start_tab$' )]"
		$repeat tabs$
		$repeat tabs.sub$
		on_start = "[GetVariableSystem.Set( '$name$_$tabs.id$', '$tabs.sub.start$' )]"
		$end tabs.sub$
		$end tabs$
	}

	blockoverride "window_header_name" {
		text = "$title$"
	}

	blockoverride "header_close_button_visibility" {
		visible = yes
	}

	blockoverride "header_close_button" {
		onclick = "[GetVariableSystem.Clear( '$name$' )]"
	}

	blockoverride "entire_scrollarea" {
		widget = {
			size = { 700 470 }

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				hbox = {
					layoutpolicy_horizontal = expanding

					$repeat tabs$
					tab_button = {
						layoutpolicy_horizontal = expanding
						size = { 0 44 }
						visible = "[Not( GetVariableSystem.HasValue( '$name$_tab', '$tabs.id$' ) )]"
						onclick = "[GetVariableSystem.Set( '$name$_tab', '$tabs.id$' )]"
						$repeat tabs.sub$
						onclick = "[GetVariableSystem.Set( '$name$_$tabs.id$', '$tabs.sub.start$' )]"
						$end tabs.sub$

						textbox = {
							text = "$tabs.title$"
							default_format = "#title"
							using = tab_text_properties
						}
					}

					icon = {
						layoutpolicy_horizontal = expanding
						size = { 0 44 }
						using = selected_tabs
						visible = "[GetVariableSystem.HasValue( '$name$_tab', '$tabs.id$' )]"

						textbox = {
							text = "$tabs.title$"
							default_format = "#variable"
							using = tab_text_properties
						}
					}

					$end tabs$
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					$repeat tabs$
					vbox = {
						visible = "[GetVariableSystem.HasValue( '$name$_tab', '$tabs.id$' )]"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = { 10 10 }

						$repeat tabs.sub$
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 5

							$repeat tabs.sub.items$
							button = {
								using = default_button
								layoutpolicy_horizontal = expanding
								size = { 0 35 }
								onclick = "[GetVariableSystem.Set( '$name$_$tabs.id$', '$tabs.sub.items.id$' )]"
								down = "[GetVariableSystem.HasValue( '$name$_$tabs.id$', '$tabs.sub.items.id$' )]"

								textbox = {
									text = "$tabs.sub.items.title$"
									parentanchor = center
									autoresize = yes
									align = nobaseline
									elide = right
								}
							}

							$end tabs.sub.items$
						}

						$repeat tabs.sub.items$
						vbox = {
							visible = "[GetVariableSystem.HasValue( '$name$_$tabs.id$', '$tabs.sub.items.id$' )]"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							# Inhalt von $tabs.sub.items.id$
						}

						$end tabs.sub.items$
						$end tabs.sub$
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							# Inhalt von $tabs.id$
						}
					}

					$end tabs$
				}
			}
		}
	}
}
