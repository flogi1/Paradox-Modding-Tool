# block: Knopf mit Icon
# group: Bedienelemente
# description: Aktionsknopf (default_button_action) mit Icon und Text mittig nebeneinander; die Aktion läuft über ein scripted_gui mit scope = country und dem eigenen Land als root, ist is_valid nicht erfüllt, wird der Knopf grau. Icons liegen in gfx/interface/icons; nur ein Icon ohne Text: button_icon_round_action mit blockoverride "icon". Vorbild: gui/invasion_panel.gui, gui/political_movement_panel.gui, gui/shared/buttons.gui
# param: name | Name | my_icon_button
# param: texture | Icon (Texturpfad) | gfx/interface/icons/generic_icons/green_checkmark.dds
# param: text | Text (Lokalisierungsschlüssel) | MY_ICON_BUTTON
# param: tooltip | Tooltip (Lokalisierungsschlüssel) | MY_ICON_BUTTON_TT
# param: scripted_gui | scripted_gui | my_scripted_gui
# requires: default_button_action

button = {
	name = "$name$"
	using = default_button_action
	size = { 260 40 }
	tooltip = "$tooltip$"
	onclick = "[GetScriptedGui('$scripted_gui$').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	enabled = "[GetScriptedGui('$scripted_gui$').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

	flowcontainer = {
		parentanchor = center
		spacing = 5

		icon = {
			parentanchor = vcenter
			size = { 25 25 }
			texture = "$texture$"
		}

		textbox = {
			parentanchor = vcenter
			maximumsize = { 200 35 }
			autoresize = yes
			fontsize_min = 12
			elide = right
			align = nobaseline
			text = "$text$"
		}
	}
}
