# block: Fenster
# group: Fenster
# description: Verschiebbares Fenster mit Hintergrund, Kopfzeile und Schließen-Knopf. Der Schließen-Knopf braucht noch eine Aktion aus Skript. Vorbild: in_game/gui/ui_library.gui, in_game/gui/ai_settings_menu.gui
# param: name | Name des Fensters | my_window
# param: title | Titel (Lokalisierungsschlüssel) | MY_WINDOW_TITLE
# requires: bg_window_default_alt, window_margin_alt, window_header_alt, ui_direction_button_holder_right, button_close_alt

window = {
	name = "$name$"
	parentanchor = center
	widgetanchor = center
	size = { 600 400 }
	movable = yes
	using = bg_window_default_alt

	vbox = {
		using = window_margin_alt

		window_header_alt = {
			blockoverride "header_text" {
				text = "$title$"
			}
		}

		widget = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
		}
	}

	widget = {
		parentanchor = right
		position = { -5 5 }
		size = { 40 40 }

		ui_direction_button_holder_right = {}

		button_close_alt = {
			# blockoverride "close_on_action" { on_action = "[...]" }
		}
	}
}
