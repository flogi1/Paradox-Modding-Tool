# block: Tab-Leiste
# group: Fenster
# description: Tab-Leiste mit Inhaltsbereich für ein vorhandenes Fenster; Umschaltung über GetVariableSystem, der Start-Tab wird beim Einblenden gesetzt. Vorbild: in_game/gui/ui_library.gui
# param: var | Variable für den aktiven Tab | my_tabs
# param: start_tab | Start-Tab (Kennung) | tab_1
# repeat: tabs | Tabs | 3
# param: tabs.id | Kennung | tab_$index$
# param: tabs.title | Titel (Lokalisierungsschlüssel) | TAB_$index$
# requires: layoutpolicy_expanding, header_main_tabs, button_main_tab_alt, bg_main_inner_alt, window_main_tabs_margin_alt

vbox = {
	using = layoutpolicy_expanding

	state = {
		name = _show
		on_start = "[GetVariableSystem.Set( '$var$', '$start_tab$' )]"
	}

	header_main_tabs = {
		blockoverride "content" {
			$repeat tabs$
			button_main_tab_alt = {
				using = layoutpolicy_expanding
				blockoverride "tab_text" {
					text = "$tabs.title$"
				}
				onclick = "[GetVariableSystem.Set( '$var$', '$tabs.id$' )]"
				down = "[GetVariableSystem.HasValue( '$var$', '$tabs.id$' )]"
			}

			$end tabs$
		}
	}

	vbox = {
		using = layoutpolicy_expanding
		using = bg_main_inner_alt

		$repeat tabs$
		vbox = {
			visible = "[GetVariableSystem.HasValue( '$var$', '$tabs.id$' )]"
			using = layoutpolicy_expanding
			using = window_main_tabs_margin_alt
			# Inhalt von $tabs.id$
		}

		$end tabs$
	}
}
