# block: Knopf mit Icon
# group: Bedienelemente
# description: Knopf mit Icon und Text; beide Blockoverrides brauchen visible = yes. Die Aktion läuft über ein scripted_gui mit dem eigenen Land als root. Vorbild: in_game/gui/ui_library.gui, in_game/gui/shared/buttons.gui
# param: name | Name | my_icon_button
# param: texture | Icon (Texturpfad) | gfx/interface/buttons/flats/advances.dds
# param: text | Text (Lokalisierungsschlüssel) | MY_ICON_BUTTON
# param: tooltip | Tooltip (Lokalisierungsschlüssel) | MY_ICON_BUTTON_TT
# param: scripted_gui | scripted_gui | my_scripted_gui
# requires: button_regular_icon

button_regular_icon = {
	name = "$name$"
	size = { 200 30 }
	tooltip = "$tooltip$"
	onclick = "[GetScriptedGui('$scripted_gui$').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

	blockoverride "button_icon" {
		visible = yes
		texture = "$texture$"
		size = { 20 20 }
	}

	blockoverride "button_text" {
		visible = yes
		text = "$text$"
	}
}
